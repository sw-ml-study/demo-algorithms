# Mini-app: index sequential dispatch times without producing a linear tree.
#
# Immutable AVL insertion caches heights and rebuilds/rotates the search path.
# An earlier dispatch snapshot remains available after later arrivals.
#
# data_structure: persistent AVL tree map
# algorithm: recursive insert with LL/RR/LR/RL rotations
# representation: nested immutable records with cached height
# dynamic_size: yes
# logical_complexity: search/insert O(log n), logical allocation O(log n)
# current_copy_complexity: nested record cloning may exceed rebuilt path
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: runtime structural sharing and tracing GC

def u:empty_avl() { "Create an empty avl value."; {empty: 1, height: 0} }
def u:higher(a, b) { "Return whether a, b satisfy higher."; if gt(a, b) { a } else { b } }
def u:make(key, value, left, right) { "Return the make result for the supplied key, value, left, right."; {empty: 0, key: key, value: value, left: left, right: right, height: 1 + u:higher(left.height, right.height)} }
def u:factor(tree) { "Return the factor result for the supplied tree."; if tree.empty { 0 } else { tree.left.height - tree.right.height } }
def u:rotate_right(top) { "Return the rotate right result for the supplied top."; pivot = top.left; moved = pivot.right; new_right = u:make(top.key, top.value, moved, top.right); u:make(pivot.key, pivot.value, pivot.left, new_right) }
def u:rotate_left(top) { "Return the rotate left result for the supplied top."; pivot = top.right; moved = pivot.left; new_left = u:make(top.key, top.value, top.left, moved); u:make(pivot.key, pivot.value, new_left, pivot.right) }
def u:rebalance(tree, inserted_key) { "Return the rebalance result for the supplied tree, inserted_key.";
  balance = u:factor(tree);
  if gt(balance, 1) { if lt(inserted_key, tree.left.key) { u:rotate_right(tree) } else { u:rotate_right(u:make(tree.key, tree.value, u:rotate_left(tree.left), tree.right)) } } else {
    if lt(balance, -1) { if gt(inserted_key, tree.right.key) { u:rotate_left(tree) } else { u:rotate_left(u:make(tree.key, tree.value, tree.left, u:rotate_right(tree.right))) } } else { tree }
  }
}
def u:insert(tree, key, value) { "Add the supplied item and return the updated structure."; if tree.empty { u:make(key, value, u:empty_avl(), u:empty_avl()) } else { if lt(key, tree.key) { u:rebalance(u:make(tree.key, tree.value, u:insert(tree.left, key, value), tree.right), key) } else { if gt(key, tree.key) { u:rebalance(u:make(tree.key, tree.value, tree.left, u:insert(tree.right, key, value)), key) } else { u:make(key, value, tree.left, tree.right) } } } }
def u:lookup(tree, key) { "Find the requested value or node in the supplied structure."; if tree.empty { err({kind: "missing", message: "dispatch is absent"}) } else { if lt(key, tree.key) { u:lookup(tree.left, key) } else { if gt(key, tree.key) { u:lookup(tree.right, key) } else { ok(tree.value) } } } }
def u:inorder(tree) { "Traverse the supplied structure in inorder order."; if tree.empty { fill([0], 0) } else { concat(u:inorder(tree.left), concat(tree.key, u:inorder(tree.right))) } }

empty = u:empty_avl();
early = u:insert(u:insert(u:insert(empty, 10, 100), 20, 0), 30, 300);
current = u:insert(u:insert(u:insert(early, 40, 400), 50, 500), 60, 600);
current = u:insert(current, 30, 333);
print("Problem: index sequential dispatch times without degrading into a linear search tree.");
print("Solution: persistent AVL rotations keep height bounded while earlier roots remain valid.");
{ordered_times: u:inorder(current), root: current.key, height: current.height, revised_dispatch_30: unwrap(u:lookup(current, 30)), stored_zero_dispatch_20: unwrap(u:lookup(current, 20)), retained_early_times: u:inorder(early), retained_early_value_30: unwrap(u:lookup(early, 30))}
