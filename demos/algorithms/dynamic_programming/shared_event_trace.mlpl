# Mini-app: find the longest ordered event trace shared by two system runs.
# data_structure: flat row-major dynamic-programming table
# algorithm: numeric-token longest common subsequence with reconstruction
# dynamic_size: table dimensions follow both input trace lengths
# logical_complexity: O(m*n) time and O(m*n) space
# current_copy_complexity: every immutable scatter copies the full table
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: modules, folds, and transient/COW matrix builders

def u:lcs_cell(first, second, cols, table, row, col) { "Compute one LCS table cell from its diagonal, upper, and left dependencies."; index = row * cols + col; if eq(take(first, 0, row - 1), take(second, 0, col - 1)) { scatter(table, index, take(table, 0, (row - 1) * cols + col - 1) + 1) } else { above = take(table, 0, (row - 1) * cols + col); left = take(table, 0, row * cols + col - 1); scatter(table, index, if gt(left, above) { left } else { above }) } }
def u:lcs_columns(first, second, cols, row, col, table) { "Fill the remaining columns of one LCS table row recursively."; if eq(col, cols) { table } else { u:lcs_columns(first, second, cols, row, col + 1, u:lcs_cell(first, second, cols, table, row, col)) } }
def u:lcs_rows(first, second, rows, cols, row, table) { "Fill the remaining LCS table rows recursively."; if eq(row, rows) { table } else { u:lcs_rows(first, second, rows, cols, row + 1, u:lcs_columns(first, second, cols, row, 1, table)) } }
def u:lcs_recover(first, second, table, cols, row, col, sequence) { "Reconstruct one deterministic LCS by walking backward through the table."; if eq(row, 0) + eq(col, 0) { sequence } else { if eq(take(first, 0, row - 1), take(second, 0, col - 1)) { u:lcs_recover(first, second, table, cols, row - 1, col - 1, concat(take(first, 0, row - 1), sequence)) } else { above = take(table, 0, (row - 1) * cols + col); left = take(table, 0, row * cols + col - 1); if gt(left, above) { u:lcs_recover(first, second, table, cols, row, col - 1, sequence) } else { u:lcs_recover(first, second, table, cols, row - 1, col, sequence) } } } }
def u:lcs(first, second) { "Build the LCS table and return its length, deterministic sequence, and dimensions."; rows = tally(first) + 1; cols = tally(second) + 1; table = u:lcs_rows(first, second, rows, cols, 1, fill([rows * cols], 0)); sequence = u:lcs_recover(first, second, table, cols, rows - 1, cols - 1, fill([0], 0)); {length: tally(sequence), sequence: sequence, rows: rows, cols: cols, table: table} }

baseline_events = [10, 20, 30, 40, 50, 60]; candidate_events = [5, 20, 30, 45, 50, 60, 70]; shared = u:lcs(baseline_events, candidate_events);
print("Problem: identify the longest ordered event trace preserved between two system runs.");
print("Solution: numeric-token LCS ignores inserted or replaced events while retaining shared order.");
{shared_event_count: shared.length, shared_events: shared.sequence, table_dimensions: [shared.rows, shared.cols], retained_baseline: baseline_events}
