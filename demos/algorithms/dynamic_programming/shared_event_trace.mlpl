# Mini-app: find the longest ordered event trace shared by two system runs.
# data_structure: flat row-major dynamic-programming table
# algorithm: numeric-token longest common subsequence with reconstruction
# dynamic_size: table dimensions follow both input trace lengths
# logical_complexity: O(m*n) time and O(m*n) space
# current_copy_complexity: every immutable scatter copies the full table
# recursion_depth: O(m*n) construction plus O(m+n) reconstruction
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: modules, folds, and transient/COW matrix builders

include "../../../src/algorithms/dynamic_programming/numeric_lcs.mlpl";

baseline_events = [10, 20, 30, 40, 50, 60];
candidate_events = [5, 20, 30, 45, 50, 60, 70];
shared = u:lcs(baseline_events, candidate_events);
print("Problem: identify the longest ordered event trace preserved between two system runs.");
print("Solution: numeric-token LCS ignores inserted or replaced events while retaining shared order.");
{shared_event_count: shared.length, shared_events: shared.sequence, table_dimensions: [shared.rows, shared.cols], retained_baseline: baseline_events}
