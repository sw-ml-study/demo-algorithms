# Mini-app: make an exact refund with the fewest coins.
# data_structure: immutable count and predecessor vectors
# algorithm: bottom-up unbounded coin-change dynamic programming
# dynamic_size: tables grow from amount zero through the target
# logical_complexity: O(target * denominations), O(target) space
# current_copy_complexity: immutable concat copies growing tables
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: modules, folds, and transient/COW table builders

def u:valid_coins(coins, i) { if eq(i, tally(coins)) { 1 } else { coin = take(coins, 0, i); gt(coin, 0) * eq(coin, floor(coin)) * u:valid_coins(coins, i + 1) } }
def u:best_coin(coins, amount, counts, i, best_count, best_coin) { if eq(i, tally(coins)) { {count: best_count, coin: best_coin} } else { coin = take(coins, 0, i); usable = lt(coin, amount) + eq(coin, amount); prior = if usable { take(counts, 0, amount - coin) } else { 1000000000 }; candidate = prior + 1; better = lt(candidate, best_count) + eq(candidate, best_count) * (eq(best_coin, -1) + lt(coin, best_coin)); if usable * lt(prior, 1000000000) * better { u:best_coin(coins, amount, counts, i + 1, candidate, coin) } else { u:best_coin(coins, amount, counts, i + 1, best_count, best_coin) } } }
def u:build_change(coins, target, amount, counts, choices) { if gt(amount, target) { {counts: counts, choices: choices} } else { best = u:best_coin(coins, amount, counts, 0, 1000000000, -1); u:build_change(coins, target, amount + 1, concat(counts, best.count), concat(choices, best.coin)) } }
def u:recover_change(choices, remaining, selected) { if eq(remaining, 0) { ok(selected) } else { coin = take(choices, 0, remaining); if eq(coin, -1) { err({kind: "impossible", message: "target cannot be made"}) } else { u:recover_change(choices, remaining - coin, concat(selected, coin)) } } }
def u:coin_change(coins, target) { if lt(target, 0) { err({kind: "target", message: "target must be a nonnegative integer"}) } else { if eq(target, floor(target)) { if u:valid_coins(coins, 0) { table = u:build_change(coins, target, 1, [0], [-1]); count = take(table.counts, 0, target); if eq(count, 1000000000) { ok({possible: 0, count: -1, coins: fill([0], 0)}) } else { picked = u:recover_change(table.choices, target, fill([0], 0))?; ok({possible: 1, count: count, coins: picked}) } } else { err({kind: "denomination", message: "denominations must be positive integers"}) } } else { err({kind: "target", message: "target must be a nonnegative integer"}) } } }

denominations = [1, 3, 4]; refund = 6; answer = unwrap(u:coin_change(denominations, refund));
print("Problem: issue an exact six-unit refund using the fewest available coins.");
print("Solution: unbounded coin-change DP beats the greedy 4+1+1 choice on this noncanonical system.");
{refund: refund, minimum_coin_count: answer.count, selected_coins: answer.coins, retained_denominations: denominations}
