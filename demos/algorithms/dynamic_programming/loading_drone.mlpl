# Mini-app: choose indivisible packages maximizing value within drone capacity.
# data_structure: rolling value row plus flat immutable decision matrix
# algorithm: bottom-up 0/1 knapsack dynamic programming with reconstruction
# dynamic_size: decision table grows by item and capacity
# logical_complexity: O(items * capacity) time and decision space
# current_copy_complexity: immutable concat repeatedly copies rows/table
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: modules, folds, and transient/COW table builders

def u:valid_weights(weights, i) { if eq(i, tally(weights)) { 1 } else { weight = take(weights, 0, i); gt(weight, 0) * eq(weight, floor(weight)) * u:valid_weights(weights, i + 1) } }
def u:build_row(weight, value, previous, capacity, current, row, choices) { if gt(current, capacity) { {row: row, choices: choices} } else { exclude = take(previous, 0, current); fits = lt(weight, current) + eq(weight, current); include = if fits { take(previous, 0, current - weight) + value } else { -1000000000 }; take_item = fits * gt(include, exclude); best = if take_item { include } else { exclude }; u:build_row(weight, value, previous, capacity, current + 1, concat(row, best), concat(choices, take_item)) } }
def u:build_items(weights, values, capacity, item, previous, decisions) { if eq(item, tally(weights)) { {values: previous, decisions: decisions} } else { next = u:build_row(take(weights, 0, item), take(values, 0, item), previous, capacity, 0, fill([0], 0), fill([0], 0)); u:build_items(weights, values, capacity, item + 1, next.row, concat(decisions, next.choices)) } }
def u:recover_items(weights, decisions, width, item, remaining, selected) { if eq(item, 0) { selected } else { chosen = take(decisions, 0, item * width + remaining); if chosen { u:recover_items(weights, decisions, width, item - 1, remaining - take(weights, 0, item - 1), concat(item - 1, selected)) } else { u:recover_items(weights, decisions, width, item - 1, remaining, selected) } } }
def u:knapsack(weights, values, capacity) { if lt(capacity, 0) { err({kind: "capacity", message: "capacity must be a nonnegative integer"}) } else { if eq(capacity, floor(capacity)) { if eq(tally(weights), tally(values)) { if u:valid_weights(weights, 0) { width = capacity + 1; built = u:build_items(weights, values, capacity, 0, fill([width], 0), fill([width], 0)); selected = u:recover_items(weights, built.decisions, width, tally(weights), capacity, fill([0], 0)); ok({value: take(built.values, 0, capacity), item_ids: selected}) } else { err({kind: "weight", message: "weights must be positive integers"}) } } else { err({kind: "shape", message: "weights and values differ"}) } } else { err({kind: "capacity", message: "capacity must be a nonnegative integer"}) } } }

package_weights = [2, 3, 4, 5]; package_values = [3, 4, 5, 8]; capacity = 7; load = unwrap(u:knapsack(package_weights, package_values, capacity));
print("Problem: maximize delivered package value without exceeding a seven-unit drone capacity.");
print("Solution: 0/1 knapsack DP selects each package at most once and reconstructs the optimal manifest.");
{capacity: capacity, selected_package_ids: load.item_ids, delivered_value: load.value, retained_weights: package_weights}
