# Mini-app: accept the maximum number of non-overlapping meeting requests.
# data_structure: parallel start, end, and numeric-ID vectors
# algorithm: earliest-finish interval scheduling after deterministic insertion sort
# dynamic_size: sorted and accepted interval vectors grow recursively
# logical_complexity: O(n^2) baseline sort plus O(n) greedy selection
# current_copy_complexity: immutable insertion and append copy growing vectors
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: modules, UDF comparators, O(n log n) sort, and COW builders

def u:id_seen(ids, limit, wanted, position) { "Return whether an interval ID already occurs before the supplied limit."; if eq(position, limit) { 0 } else { eq(take(ids, 0, position), wanted) + u:id_seen(ids, limit, wanted, position + 1) } }
def u:validate_intervals(starts, ends, ids, position) { "Validate interval ordering and unique IDs recursively."; if eq(position, tally(starts)) { ok(1) } else { if gt(take(starts, 0, position), take(ends, 0, position)) { err({kind: "interval", message: "start exceeds end"}) } else { if u:id_seen(ids, position, take(ids, 0, position), 0) { err({kind: "id", message: "interval IDs must be unique"}) } else { u:validate_intervals(starts, ends, ids, position + 1) } } } }
def u:interval_before(start, finish, id, other_start, other_finish, other_id) { "Order intervals by finish time, then start time, then numeric ID."; lt(finish, other_finish) + eq(finish, other_finish) * (lt(start, other_start) + eq(start, other_start) * lt(id, other_id)) }
def u:insertion_position(sorted, start, finish, id, position) { "Find the deterministic insertion position in an interval schedule."; if eq(position, tally(sorted.ids)) { position } else { if u:interval_before(start, finish, id, take(sorted.starts, 0, position), take(sorted.ends, 0, position), take(sorted.ids, 0, position)) { position } else { u:insertion_position(sorted, start, finish, id, position + 1) } } }
def u:insert_interval(sorted, start, finish, id) { "Insert one interval into finish-time order and return new parallel vectors."; position = u:insertion_position(sorted, start, finish, id, 0); indices = range(tally(sorted.ids)); before = lt(indices, position); after = gt(indices, position) + eq(indices, position); {starts: concat(concat(compress(before, sorted.starts), start), compress(after, sorted.starts)), ends: concat(concat(compress(before, sorted.ends), finish), compress(after, sorted.ends)), ids: concat(concat(compress(before, sorted.ids), id), compress(after, sorted.ids))} }
def u:sort_intervals(starts, ends, ids, position, sorted) { "Sort all remaining intervals recursively by deterministic earliest finish."; if eq(position, tally(ids)) { sorted } else { u:sort_intervals(starts, ends, ids, position + 1, u:insert_interval(sorted, take(starts, 0, position), take(ends, 0, position), take(ids, 0, position))) } }
def u:select_intervals(sorted, position, has_last, last_end, selected) { "Greedily accept each remaining interval compatible with the last selection."; if eq(position, tally(sorted.ids)) { selected } else { start = take(sorted.starts, 0, position); compatible = if has_last { gt(start, last_end) + eq(start, last_end) } else { 1 }; if compatible { u:select_intervals(sorted, position + 1, 1, take(sorted.ends, 0, position), {starts: concat(selected.starts, start), ends: concat(selected.ends, take(sorted.ends, 0, position)), ids: concat(selected.ids, take(sorted.ids, 0, position))}) } else { u:select_intervals(sorted, position + 1, has_last, last_end, selected) } } }
def u:schedule_intervals(starts, ends, ids) { "Validate, sort, and greedily select a maximum-cardinality interval schedule."; if eq(tally(starts), tally(ends)) * eq(tally(starts), tally(ids)) { u:validate_intervals(starts, ends, ids, 0)?; sorted = u:sort_intervals(starts, ends, ids, 0, {starts: fill([0], 0), ends: fill([0], 0), ids: fill([0], 0)}); ok(u:select_intervals(sorted, 0, 0, 0, {starts: fill([0], 0), ends: fill([0], 0), ids: fill([0], 0)})) } else { err({kind: "shape", message: "start, end, and ID vectors differ"}) } }

request_starts = [9, 0, 5, 3, 5, 8]; request_ends = [10, 6, 7, 4, 9, 11]; request_ids = [105, 101, 104, 102, 103, 106]; accepted = unwrap(u:schedule_intervals(request_starts, request_ends, request_ids));
print("Problem: accept the greatest number of meeting requests for one room without overlap.");
print("Solution: sort by earliest finish, then greedily accept half-open intervals whose starts touch or follow the prior end.");
{accepted_ids: accepted.ids, accepted_starts: accepted.starts, accepted_ends: accepted.ends, meeting_count: tally(accepted.ids), retained_requests: request_ids}
