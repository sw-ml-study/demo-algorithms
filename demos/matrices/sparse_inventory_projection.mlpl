# Mini-app: project sparse warehouse quantities into regional totals and transpose the view.
# data_structure: COO and compressed sparse row matrices
# algorithm: duplicate-summing COO-to-CSR, sparse matvec, and transpose
# representation: row pointers, sorted column indices, and nonzero values
# dynamic_size: yes
# logical_complexity: matvec O(rows + nonzeros); pedagogical conversion/transpose scan dense coordinate domains
# current_copy_complexity: recursive concat copies growing output arrays
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: transient builders and general sparse sort/group primitives
include "../../src/matrices/sparse_csr.mlpl";
coo = u:sp_coo(3, 4, [2, 0, 1, 0, 2, 0], [3, 1, 0, 1, 2, 2], [5, 4, -2, 3, 0, 6]);
csr = unwrap(u:sp_to_csr(coo)); totals = unwrap(u:sp_matvec(csr, [10, 20, 30, 40])); transposed = unwrap(u:sp_transpose(csr));
print("Problem: aggregate a sparse warehouse-by-product table and also expose its product-by-warehouse view.");
print("Solution: COO duplicates are summed and zeros elided before CSR matvec and transpose.");
{regional_totals: totals, csr_row_pointers: csr.row_pointers, csr_columns: csr.column_indices, csr_values: csr.values, transpose_shape: [transposed.rows, transposed.columns], input_entries_retained: tally(coo.values)}
