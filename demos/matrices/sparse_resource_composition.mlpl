# Mini-app: compose sparse site-to-resource and resource-to-cost transformations.
# data_structure: compressed sparse row matrices
# algorithm: sparse matrix addition and rectangular matrix multiplication
# representation: deterministic sorted columns with zero-elided values
# dynamic_size: yes
# logical_complexity: pedagogical product scans rows*columns*shared dimension
# current_copy_complexity: coordinate emission and CSR conversion copy growing arrays
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: sparse row accumulators, grouping, and transient builders
include "../../src/matrices/sparse_csr.mlpl";
sites = unwrap(u:sp_to_csr(u:sp_coo(2, 3, [0, 0, 1], [0, 2, 1], [2, 1, 3])));
costs = unwrap(u:sp_to_csr(u:sp_coo(3, 2, [0, 1, 2], [0, 1, 0], [10, 5, 4])));
composed = unwrap(u:sp_multiply(sites, costs));
print("Problem: compose sparse site-resource quantities with resource-cost transformations.");
print("Solution: dimension-checked CSR multiplication emits deterministic nonzero site-cost cells.");
{site_cost_row_pointers: composed.row_pointers, site_cost_columns: composed.column_indices, site_cost_values: composed.values, site_0_cost_0: u:sp_get(composed, 0, 0), site_1_cost_1: u:sp_get(composed, 1, 1), retained_site_nonzeros: tally(sites.values)}
