# Mini-app: maintain a collision-heavy registry of numeric sensor readings.
#
# Bucket heads and parallel node arrays form immutable singly linked chains.
# Removing a node rewires one handle; growth recursively reinserts live nodes
# into a larger bucket vector and drops unreachable storage.
#
# data_structure: separate-chaining hash map with indexed nodes
# algorithm: chain lookup, immutable link rewiring, load-driven rehash
# representation: bucket heads plus key/value/next/active node arrays, -1 null
# dynamic_size: yes
# logical_complexity: expected O(1) lookup/update; O(n) resize
# current_copy_complexity: append/scatter copy arrays; rehash copies repeatedly
# explicit_loops: 0
# target_loops: 0
# required_features: current

def u:new_map(capacity) { "Create an empty map value."; {heads: fill([capacity], 0 - 1), keys: fill([0], 0), values: fill([0], 0), next_handles: fill([0], 0), active: fill([0], 0), capacity: capacity, size: 0, nodes: 0} }
def u:norm(key) { "Return the norm result for the supplied key."; if lt(key, 0) { 0 - key * 2 - 1 } else { key * 2 } }
def u:rem(value, divisor) { "Return the rem result for the supplied value, divisor."; value - floor(value / divisor) * divisor }
def u:bucket(key, capacity) { "Return the bucket result for the supplied key, capacity."; u:rem(u:norm(key) * 37 + 17, capacity) }
def u:find_from(map, key, handle, steps) { "Find from in the supplied structure.";
  if eq(handle, -1) + eq(steps, map.nodes) { -1 } else {
    if eq(take(map.active, 0, handle), 1) * eq(take(map.keys, 0, handle), key) { handle } else { u:find_from(map, key, take(map.next_handles, 0, handle), steps + 1) }
  }
}
def u:find(map, key) { "Find the requested value or node in the supplied structure."; u:find_from(map, key, take(map.heads, 0, u:bucket(key, map.capacity)), 0) }
def u:raw_insert(map, key, value) { "Return the raw insert result for the supplied map, key, value.";
  bucket = u:bucket(key, map.capacity); node = map.nodes;
  {heads: scatter(map.heads, bucket, node), keys: concat(map.keys, key), values: concat(map.values, value), next_handles: concat(map.next_handles, take(map.heads, 0, bucket)), active: concat(map.active, 1), capacity: map.capacity, size: map.size + 1, nodes: node + 1}
}
def u:rehash(old_map, position, fresh_map) { "Return the rehash result for the supplied old_map, position, fresh_map.";
  if eq(position, old_map.nodes) { fresh_map } else {
    if eq(take(old_map.active, 0, position), 1) { u:rehash(old_map, position + 1, u:raw_insert(fresh_map, take(old_map.keys, 0, position), take(old_map.values, 0, position))) } else { u:rehash(old_map, position + 1, fresh_map) }
  }
}
def u:put(map, key, value) { "Add the supplied item and return the updated structure.";
  node = u:find(map, key);
  if gt(node, -1) { {heads: map.heads, keys: map.keys, values: scatter(map.values, node, value), next_handles: map.next_handles, active: map.active, capacity: map.capacity, size: map.size, nodes: map.nodes} } else {
    if gt(map.size + 1, map.capacity) { u:raw_insert(u:rehash(map, 0, u:new_map(map.capacity * 2 + 1)), key, value) } else { u:raw_insert(map, key, value) }
  }
}
def u:get(map, key) { "Find the requested value or node in the supplied structure."; node = u:find(map, key); if eq(node, -1) { err({kind: "missing", message: "sensor is absent"}) } else { ok(take(map.values, 0, node)) } }
def u:locate(map, key, handle, previous, steps) { "Find the requested value or node in the supplied structure.";
  if eq(handle, -1) + eq(steps, map.nodes) { {index: -1, previous: -1} } else {
    if eq(take(map.active, 0, handle), 1) * eq(take(map.keys, 0, handle), key) { {index: handle, previous: previous} } else { u:locate(map, key, take(map.next_handles, 0, handle), handle, steps + 1) }
  }
}
def u:remove(map, key) { "Remove the supplied item and return the updated structure.";
  bucket = u:bucket(key, map.capacity); place = u:locate(map, key, take(map.heads, 0, bucket), -1, 0);
  if eq(place.index, -1) { err({kind: "missing", message: "sensor is absent"}) } else {
    successor = take(map.next_handles, 0, place.index);
    new_heads = if eq(place.previous, -1) { scatter(map.heads, bucket, successor) } else { map.heads };
    new_next = if eq(place.previous, -1) { map.next_handles } else { scatter(map.next_handles, place.previous, successor) };
    ok({heads: new_heads, keys: map.keys, values: map.values, next_handles: new_next, active: scatter(map.active, place.index, 0), capacity: map.capacity, size: map.size - 1, nodes: map.nodes})
  }
}

morning = u:put(u:put(u:put(u:new_map(3), 0, 120), 3, 0), 6, 360);
without_three = unwrap(u:remove(morning, 3));
current = u:put(u:put(without_three, -3, 480), 9, 900);
print("Problem: retain colliding sensor readings while removing sensor 3 and growing the registry.");
print("Solution: indexed bucket chains isolate collisions; rehash preserves only live nodes.");
{capacity: current.capacity, sensor_0: unwrap(u:get(current, 0)), sensor_6: unwrap(u:get(current, 6)), sensor_negative_3: unwrap(u:get(current, -3)), sensor_9: unwrap(u:get(current, 9)), retained_sensor_3_zero: unwrap(u:get(morning, 3)), live_entries: current.size}
