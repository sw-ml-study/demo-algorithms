# Mini-app: grow a sparse meter map when occupancy would exceed 75%.
#
# Live entries are recursively reinserted into a table of size 2n+1. Rehashing
# preserves key/value behavior while discarding tombstones.
#
# data_structure: resizable open-address hash map with tombstones
# algorithm: load-threshold growth and recursive rehash
# dynamic_size: yes
# logical_complexity: expected amortized O(1), resize O(n)
# current_copy_complexity: immutable updates/rehash copy arrays repeatedly
# explicit_loops: 0
# target_loops: 0
# required_features: current

def u:new_map(c) { "Create an empty map value."; {states: fill([c], 0), keys: fill([c], 0), values: fill([c], 0), capacity: c, size: 0} }
def u:norm(k) { "Return the norm result for the supplied k."; if lt(k, 0) { 0 - k * 2 - 1 } else { k * 2 } }
def u:rem(v, d) { "Return the rem result for the supplied v, d."; v - floor(v / d) * d }
def u:bucket(k, c) { "Return the bucket result for the supplied k, c."; u:rem(u:norm(k) * 37 + 17, c) }
def u:find_insert(map, key, probe, first_deleted) { "Find insert in the supplied structure.";
  if eq(probe, map.capacity) { if gt(first_deleted, -1) { ok({index: first_deleted, found: 0}) } else { err({kind: "full", message: "table is full"}) } } else {
    index = u:rem(u:bucket(key, map.capacity) + probe, map.capacity); state = take(map.states, 0, index);
    if eq(state, 0) { if gt(first_deleted, -1) { ok({index: first_deleted, found: 0}) } else { ok({index: index, found: 0}) } } else {
      if eq(state, 1) * eq(take(map.keys, 0, index), key) { ok({index: index, found: 1}) } else {
        remembered = if eq(state, 2) * eq(first_deleted, -1) { index } else { first_deleted };
        u:find_insert(map, key, probe + 1, remembered)
      }
    }
  }
}
def u:raw_insert(map, key, value) { "Return the raw insert result for the supplied map, key, value.";
  slot = u:find_insert(map, key, 0, -1)?;
  ok({states: scatter(map.states, slot.index, 1), keys: scatter(map.keys, slot.index, key), values: scatter(map.values, slot.index, value), capacity: map.capacity, size: map.size + (1 - slot.found)})
}
def u:rehash(old, position, fresh) { "Return the rehash result for the supplied old, position, fresh.";
  if eq(position, old.capacity) {
    fresh
  } else {
    if eq(take(old.states, 0, position), 1) {
      u:rehash(old, position + 1, unwrap(u:raw_insert(fresh, take(old.keys, 0, position), take(old.values, 0, position))))
    } else {
      u:rehash(old, position + 1, fresh)
    }
  }
}
def u:put(table, key, value) { "Add the supplied item and return the updated structure.";
  existing = u:find_insert(table, key, 0, -1)?;
  if existing.found {
    ok({states: table.states, keys: table.keys, values: scatter(table.values, existing.index, value), capacity: table.capacity, size: table.size})
  } else {
    if gt((table.size + 1) * 4, table.capacity * 3) {
      u:raw_insert(u:rehash(table, 0, u:new_map(table.capacity * 2 + 1)), key, value)
    } else {
      u:raw_insert(table, key, value)
    }
  }
}
def u:find_key(map, key, probe) { "Find key in the supplied structure.";
  if eq(probe, map.capacity) { err({kind: "missing", message: "absent"}) } else {
    index = u:rem(u:bucket(key, map.capacity) + probe, map.capacity); state = take(map.states, 0, index);
    if eq(state, 0) { err({kind: "missing", message: "absent"}) } else { if eq(state, 1) * eq(take(map.keys, 0, index), key) { ok(index) } else { u:find_key(map, key, probe + 1) } }
  }
}
def u:get(map, key) { "Find the requested value or node in the supplied structure."; ok(take(map.values, 0, u:find_key(map, key, 0)?)) }
def u:remove(map, key) { "Remove the supplied item and return the updated structure."; index = u:find_key(map, key, 0)?; ok({states: scatter(map.states, index, 2), keys: map.keys, values: map.values, capacity: map.capacity, size: map.size - 1}) }

map1 = unwrap(u:put(u:new_map(5), 0, 100)); map2 = unwrap(u:put(map1, 5, 200)); map3 = unwrap(u:put(map2, 10, 0));
deleted = unwrap(u:remove(map3, 5)); restored = unwrap(u:put(deleted, 15, 400)); grown = unwrap(u:put(restored, 20, 500));
print("Problem: keep sparse meter readings available while the table grows and removes tombstones.");
print("Solution: crossing 75% occupancy rehashes live entries into a larger table.");
{old_capacity: restored.capacity, new_capacity: grown.capacity, meter_10_zero: unwrap(u:get(grown, 10)), meter_15: unwrap(u:get(grown, 15)), meter_20: unwrap(u:get(grown, 20)), old_snapshot_size: restored.size}
