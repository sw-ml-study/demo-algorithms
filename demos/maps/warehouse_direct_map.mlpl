# Mini-app: update and retrieve quantities for bounded warehouse bin IDs.
#
# Bin IDs are dense integers 0 through 9. Parallel present/value arrays make a
# direct-address map: lookup indexes the key directly and presence distinguishes
# an absent bin from a stored zero quantity.
#
# data_structure: bounded direct-address numeric map
# algorithm: insert/update, lookup, and remove by direct index
# dynamic_size: no (fixed 10-bin universe)
# logical_complexity: insert/update/lookup/remove O(1)
# current_copy_complexity: each scatter copies O(universe size) storage
# explicit_loops: 0
# target_loops: 0
# required_features: current
# tradeoff: fastest bounded lookup, but space is proportional to key universe

def u:new_map(capacity) { "Create an empty map value."; {values: fill([capacity], 0), present: fill([capacity], 0), capacity: capacity, size: 0} }
def u:valid_key(map, key) { "Check whether map, key satisfies the valid key invariant.";
  if eq(rank(key), 0) { if eq(key, floor(key)) { if lt(key, 0) { 0 } else { lt(key, map.capacity) } } else { 0 } } else { 0 }
}
def u:insert(map, key, value) { "Add the supplied item and return the updated structure.";
  if u:valid_key(map, key) {
    was_present = take(map.present, 0, key);
    ok({values: scatter(map.values, key, value), present: scatter(map.present, key, 1), capacity: map.capacity, size: map.size + (1 - was_present)})
  } else { err({kind: "key", message: "bin ID is outside the bounded universe"}) }
}
def u:lookup(map, key) { "Find the requested value or node in the supplied structure.";
  if u:valid_key(map, key) {
    if take(map.present, 0, key) { ok(take(map.values, 0, key)) } else { err({kind: "missing", message: "bin is absent"}) }
  } else { err({kind: "key", message: "bin ID is outside the bounded universe"}) }
}
def u:remove(map, key) { "Remove the supplied item and return the updated structure.";
  if u:valid_key(map, key) {
    if take(map.present, 0, key) {
      ok({values: scatter(map.values, key, 0), present: scatter(map.present, key, 0), capacity: map.capacity, size: map.size - 1})
    } else { err({kind: "missing", message: "bin is absent"}) }
  } else { err({kind: "key", message: "bin ID is outside the bounded universe"}) }
}

empty = u:new_map(10);
stock1 = unwrap(u:insert(empty, 2, 40));
stock2 = unwrap(u:insert(stock1, 7, 15));
restocked = unwrap(u:insert(stock2, 2, 55));
current = unwrap(u:remove(restocked, 7));

print("Problem: restock bin 2 and remove depleted bin 7 while retaining yesterday's snapshot.");
print("Solution: direct addressing performs bounded integer-key lookup without hashing.");
{bin_2_quantity: unwrap(u:lookup(current, 2)), bin_7_present: current.present, yesterday_bin_2_quantity: unwrap(u:lookup(stock2, 2)), entry_count: current.size}
