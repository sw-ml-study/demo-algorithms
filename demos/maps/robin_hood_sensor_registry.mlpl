# Mini-app: keep collision-heavy sensor registrations from accumulating one extreme probe distance.
# data_structure: fixed-capacity open-address map with state/key/value/distance vectors
# algorithm: Robin Hood insertion swaps with less-displaced residents; lookup stops early by distance
# dynamic_size: yes, within fixed capacity
# logical_complexity: expected O(1), worst-case O(capacity) insert/lookup
# current_copy_complexity: every immutable scatter copies an O(capacity) vector; swaps amplify this cost
# explicit_loops: 0
# target_loops: 0
# required_features: current numeric arrays, records, recursion, scatter, and Result values
# caveat: one fixture comparison illustrates displacement balancing, not universal speed superiority

include "../../src/maps/robin_hood_sensor_registry.mlpl";

sensor_ids = [0,1,2,3,4,7];
calibrations = [100,10,20,30,40,700];
registry = unwrap(u:rh_insert_many(7, sensor_ids, calibrations));
linear = u:linear_probe_profile(sensor_ids, 7);
robin_max = u:rh_max_distance_from(registry.distances, registry.states, 0, 0);
print("Problem: register colliding sensor IDs without leaving one sensor much farther from its home bucket than its neighbors.");
print("Solution: Robin Hood insertion swaps a more-displaced arrival with a less-displaced resident; distance metadata also permits early missing lookup.");
{slot_states: registry.states, slot_keys: registry.keys, slot_distances: registry.distances, robin_hood_max_distance: robin_max, same_fixture_linear_max_distance: linear.max_distance, sensor_7_calibration: unwrap(u:rh_lookup(registry, 7)), retained_sensor_ids: sensor_ids}
