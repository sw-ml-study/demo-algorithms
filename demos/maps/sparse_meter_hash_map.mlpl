# Mini-app: store readings for sparse numeric meter IDs.
#
# Meter IDs do not fit a small direct-address universe. A fixed-capacity hash
# map uses deterministic mixing plus recursive linear probing. IDs 0, 5, and 10
# intentionally collide in a five-slot table, demonstrating collision-chain
# lookup and duplicate-key update.
#
# data_structure: fixed-capacity open-address numeric hash map
# algorithm: deterministic hashing and recursive linear probing
# dynamic_size: yes (entries grow within fixed capacity)
# logical_complexity: expected O(1), worst-case O(capacity) lookup/insert
# current_copy_complexity: each pure scatter update copies O(capacity) arrays
# explicit_loops: 0
# target_loops: 0
# required_features: current
# next_features: tombstone deletion, load-factor resize, rehash

def u:new_map(capacity) { "Create an empty map value."; {states: fill([capacity], 0), keys: fill([capacity], 0), values: fill([capacity], 0), capacity: capacity, size: 0} }
def u:normalize(key) { "Return the normalize result for the supplied key."; if lt(key, 0) { 0 - key * 2 - 1 } else { key * 2 } }
def u:remainder(value, divisor) { "Return the remainder result for the supplied value, divisor."; value - floor(value / divisor) * divisor }
def u:bucket(key, capacity) { "Return the bucket result for the supplied key, capacity."; u:remainder(u:normalize(key) * 37 + 17, capacity) }
def u:valid_key(key) { "Check whether key satisfies the valid key invariant.";
  if eq(rank(key), 0) { if eq(key, floor(key)) { lt(abs(key), 1000001) } else { 0 } } else { 0 }
}
def u:find_slot(map, key, probe) { "Find slot in the supplied structure.";
  if eq(probe, map.capacity) { err({kind: "full", message: "hash table has no available slot"}) } else {
    index = u:remainder(u:bucket(key, map.capacity) + probe, map.capacity);
    if eq(take(map.states, 0, index), 0) { ok({index: index, found: 0, probes: probe + 1}) } else {
      if eq(take(map.keys, 0, index), key) { ok({index: index, found: 1, probes: probe + 1}) } else {
        u:find_slot(map, key, probe + 1)
      }
    }
  }
}
def u:insert(map, key, value) { "Add the supplied item and return the updated structure.";
  if u:valid_key(key) {
    slot = u:find_slot(map, key, 0)?;
    ok({states: scatter(map.states, slot.index, 1), keys: scatter(map.keys, slot.index, key), values: scatter(map.values, slot.index, value), capacity: map.capacity, size: map.size + (1 - slot.found)})
  } else { err({kind: "key", message: "key must be a bounded integer"}) }
}
def u:lookup_probe(map, key, probe) { "Find probe in the supplied structure.";
  if eq(probe, map.capacity) { err({kind: "missing", message: "meter ID is absent"}) } else {
    index = u:remainder(u:bucket(key, map.capacity) + probe, map.capacity);
    if eq(take(map.states, 0, index), 0) { err({kind: "missing", message: "meter ID is absent"}) } else {
      if eq(take(map.keys, 0, index), key) { ok({value: take(map.values, 0, index), index: index, probes: probe + 1}) } else {
        u:lookup_probe(map, key, probe + 1)
      }
    }
  }
}
def u:lookup(map, key) { "Find the requested value or node in the supplied structure.";
  if u:valid_key(key) { u:lookup_probe(map, key, 0) } else { err({kind: "key", message: "key must be a bounded integer"}) }
}

empty = u:new_map(5);
one = unwrap(u:insert(empty, 0, 120));
two = unwrap(u:insert(one, 5, 240));
three = unwrap(u:insert(two, 10, 360));
updated = unwrap(u:insert(three, 5, 255));
reading = unwrap(u:lookup(updated, 10));

print("Problem: store sparse meter readings whose IDs collide in a five-slot table.");
print("Solution: deterministic hashing plus linear probing retains every colliding key.");
{meter_10_reading: reading.value, meter_10_probes: reading.probes, updated_meter_5: unwrap(u:lookup(updated, 5)).value, occupied_keys: updated.keys, retained_old_meter_5: unwrap(u:lookup(three, 5)).value}
