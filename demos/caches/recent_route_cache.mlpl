# Mini-app: retain only the three most recently used numeric route results.
#
# A recursive numeric-key lookup delegates recency ordering to an index-backed
# doubly linked list. Cache hits move a node to the front; insertion at capacity
# retires the tail and appends a new immutable-arena node.
#
# data_structure: bounded numeric LRU cache
# algorithm: lookup, detach, attach-front, promote, least-recent eviction
# representation: parallel key/value/prev/next/active arrays, -1 null handles
# dynamic_size: yes, bounded live set with append-only version-local arena
# logical_complexity: O(n) current lookup, O(1) known-handle recency rewiring
# current_copy_complexity: immutable scatter/concat copies parallel arrays
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: imported hash lookup, lexical locals, persistent vectors

def u:new_cache(capacity) { {keys: fill([0], 0), values: fill([0], 0), previous: fill([0], 0), next_handles: fill([0], 0), active: fill([0], 0), head: -1, tail: -1, size: 0, nodes: 0, capacity: capacity} }
def u:find_from(cache, key, position) { if eq(position, cache.nodes) { -1 } else { if eq(take(cache.active, 0, position), 1) * eq(take(cache.keys, 0, position), key) { position } else { u:find_from(cache, key, position + 1) } } }
def u:find(cache, key) { u:find_from(cache, key, 0) }
def u:detach(cache, node) {
  before = take(cache.previous, 0, node); after = take(cache.next_handles, 0, node);
  new_previous = if eq(after, -1) { cache.previous } else { scatter(cache.previous, after, before) };
  new_next = if eq(before, -1) { cache.next_handles } else { scatter(cache.next_handles, before, after) };
  new_head = if eq(cache.head, node) { after } else { cache.head };
  new_tail = if eq(cache.tail, node) { before } else { cache.tail };
  {keys: cache.keys, values: cache.values, previous: scatter(new_previous, node, -1), next_handles: scatter(new_next, node, -1), active: cache.active, head: new_head, tail: new_tail, size: cache.size, nodes: cache.nodes, capacity: cache.capacity}
}
def u:attach_front(cache, node) {
  linked_previous = if eq(cache.head, -1) { cache.previous } else { scatter(cache.previous, cache.head, node) };
  {keys: cache.keys, values: cache.values, previous: scatter(linked_previous, node, -1), next_handles: scatter(cache.next_handles, node, cache.head), active: cache.active, head: node, tail: if eq(cache.tail, -1) { node } else { cache.tail }, size: cache.size, nodes: cache.nodes, capacity: cache.capacity}
}
def u:promote(cache, node) { if eq(cache.head, node) { cache } else { u:attach_front(u:detach(cache, node), node) } }
def u:retire_tail(cache) {
  victim = cache.tail; detached_cache = u:detach(cache, victim);
  {keys: detached_cache.keys, values: detached_cache.values, previous: detached_cache.previous, next_handles: detached_cache.next_handles, active: scatter(detached_cache.active, victim, 0), head: detached_cache.head, tail: detached_cache.tail, size: cache.size - 1, nodes: cache.nodes, capacity: cache.capacity}
}
def u:append_front(cache, key, value) {
  node = cache.nodes;
  extended = {keys: concat(cache.keys, key), values: concat(cache.values, value), previous: concat(cache.previous, -1), next_handles: concat(cache.next_handles, -1), active: concat(cache.active, 1), head: cache.head, tail: cache.tail, size: cache.size + 1, nodes: node + 1, capacity: cache.capacity};
  u:attach_front(extended, node)
}
def u:put(cache, key, value) {
  node = u:find(cache, key);
  if gt(node, -1) { u:promote({keys: cache.keys, values: scatter(cache.values, node, value), previous: cache.previous, next_handles: cache.next_handles, active: cache.active, head: cache.head, tail: cache.tail, size: cache.size, nodes: cache.nodes, capacity: cache.capacity}, node) } else {
    base_cache = if eq(cache.size, cache.capacity) { u:retire_tail(cache) } else { cache };
    u:append_front(base_cache, key, value)
  }
}
def u:access(cache, key) { node = u:find(cache, key); if eq(node, -1) { err({kind: "missing", message: "route is not cached"}) } else { ok({cache: u:promote(cache, node), value: take(cache.values, 0, node)}) } }
def u:keys_from(cache, handle, remaining) { if eq(handle, -1) + eq(remaining, 0) { fill([0], 0) } else { concat(take(cache.keys, 0, handle), u:keys_from(cache, take(cache.next_handles, 0, handle), remaining - 1)) } }
def u:recent_keys(cache) { u:keys_from(cache, cache.head, cache.size) }

morning = u:put(u:put(u:put(u:new_cache(3), -2, 20), 5, 0), 9, 90);
hit = unwrap(u:access(morning, -2));
with_new_route = u:put(hit.cache, 12, 120);
current = u:put(with_new_route, 9, 99);
print("Problem: retain only three recently used route results while preserving numeric route IDs.");
print("Solution: lookup delegates recency changes to an immutable indexed doubly linked list.");
{most_recent_first: u:recent_keys(current), route_9_value: unwrap(u:access(current, 9)).value, evicted_route_5: is_err(u:access(current, 5)), retained_morning_route_5_zero: unwrap(u:access(morning, 5)).value, arena_nodes: current.nodes, live_entries: current.size}
