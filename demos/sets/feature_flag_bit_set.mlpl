# Mini-app: track enabled numeric feature flags in a bounded deployment.
#
# Flag IDs are integers from 0 through 15. A bit-set-style mask provides
# constant-time membership and pure enable/disable updates without storing
# duplicate IDs.
#
# data_structure: bounded numeric bit set
# algorithm: membership, set, and clear by direct mask index
# dynamic_size: no (fixed 16-flag universe)
# logical_complexity: membership/set/clear O(1)
# current_copy_complexity: scatter copies O(universe size) mask storage
# explicit_loops: 0
# target_loops: 0
# required_features: current
# tradeoff: excellent for small dense bounded keys; space grows with universe

def u:new_flags(capacity) { {bits: fill([capacity], 0), capacity: capacity} }
def u:valid_key(flags, key) {
  if eq(rank(key), 0) {
    if eq(key, floor(key)) {
      if lt(key, 0) { 0 } else { lt(key, flags.capacity) }
    } else { 0 }
  } else { 0 }
}
def u:enable(flags, key) {
  if u:valid_key(flags, key) { ok({bits: scatter(flags.bits, key, 1), capacity: flags.capacity}) } else {
    err({kind: "key", message: "flag ID is outside the bounded universe"})
  }
}
def u:disable(flags, key) {
  if u:valid_key(flags, key) { ok({bits: scatter(flags.bits, key, 0), capacity: flags.capacity}) } else {
    err({kind: "key", message: "flag ID is outside the bounded universe"})
  }
}
def u:enabled(flags, key) {
  if u:valid_key(flags, key) { ok(take(flags.bits, 0, key)) } else {
    err({kind: "key", message: "flag ID is outside the bounded universe"})
  }
}

baseline = u:new_flags(16);
rollout1 = unwrap(u:enable(baseline, 3));
rollout2 = unwrap(u:enable(rollout1, 9));
current = unwrap(u:disable(rollout2, 3));

print("Problem: enable flag 9 and retire flag 3 while retaining the earlier rollout.");
print("Solution: direct mask updates provide bounded numeric set membership.");
{flag_3_now: unwrap(u:enabled(current, 3)), flag_9_now: unwrap(u:enabled(current, 9)), prior_rollout_flag_3: unwrap(u:enabled(rollout2, 3)), current_mask: current.bits}
