# Mini-app: order batch durations for shortest-job-first reporting.
#
# Heap sort delegates ordering to the same dense min-heap mechanism used by
# the priority queue: recursively insert every duration, then repeatedly remove
# the minimum into the result vector.
#
# data_structure: numeric vector and dense binary min-heap
# algorithm: heap sort via heap insert/remove-min
# dynamic_size: yes
# logical_complexity: O(n log n) time, O(n) result storage
# current_copy_complexity: immutable scatter/concat/compress can add O(n^2) copying
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: import shared heap module; builder/transient heap storage

include "../../src/sorts/heap_sort.mlpl";

batch_durations = [42, 15, 27, 8, 27, 33];
ordered_durations = u:heap_sort(batch_durations);
print("Problem: report batch durations from shortest to longest.");
print("Unordered durations in minutes:");
print(batch_durations);
print("Solution: heap sort delegates ordering to repeated min-heap operations.");
{original_durations: batch_durations, shortest_first: ordered_durations}
