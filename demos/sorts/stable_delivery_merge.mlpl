# Mini-app: order deliveries by ETA without reordering equal arrivals.
#
# Delivery IDs are paired with numeric ETA minutes. Stable merge sort divides
# the parallel vectors, recursively sorts each half, and chooses the left item
# first when ETA values tie, preserving dispatch order.
#
# data_structure: parallel numeric vectors
# algorithm: stable recursive merge sort
# dynamic_size: yes
# logical_complexity: O(n log n) comparisons, O(log n) divide depth
# current_copy_complexity: immutable masks/concat may copy beyond O(n log n)
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: slices/views and builder/transient merge storage

include "../../src/sorts/merge_sort.mlpl";

arrivals = {keys: [35, 12, 20, 12, 50, 20], ids: [701, 702, 703, 704, 705, 706]};
ordered = u:merge_sort(arrivals);

print("Problem: order deliveries by ETA while retaining dispatch order for equal ETAs.");
print("Arrival delivery IDs and ETA minutes:");
print({delivery_ids: arrivals.ids, eta_minutes: arrivals.keys});
print("Solution: stable merge sort chooses the left item first on ties.");
{ordered_delivery_ids: ordered.ids, ordered_eta_minutes: ordered.keys}
