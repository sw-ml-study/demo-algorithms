# Mini-app: When did a community campaign reach its fundraising goal?
#
# Donations arrive one day at a time, so a growable vector preserves their
# order while allowing the history to expand. A prefix-sum algorithm converts
# daily donations into cumulative totals. Filtering the day indices by totals
# at or above the goal reveals the first day the campaign succeeded.
#
# data_structure: growable numeric vector
# algorithm: prefix sum plus first matching index
# dynamic_size: yes
# logical_complexity: O(n)
# current_copy_complexity: each append copies O(n) storage
# explicit_loops: 0
# target_loops: 0
# required_features: current

def u:new_vector() { "Create an empty vector value.";
  {data: fill([0], 0), size: 0}
}

def u:append(vector, value) { "Add the supplied item and return the updated structure.";
  {data: concat(vector.data, value), size: vector.size + 1}
}

def u:first_goal_day(vector, goal) { "Return the first goal day result for the supplied vector, goal.";
  totals = running_sum(vector.data);
  reached = gt(totals, goal) + eq(totals, goal);
  matching_days = compress(reached, range(vector.size));
  if eq(tally(matching_days), 0) {
    err({kind: "goal-not-reached", message: "the campaign has not reached its goal"})
  } else {
    index = take(matching_days, 0, 0);
    ok({
      day: index + 1,
      goal: goal,
      cumulative_amount: take(totals, 0, index),
      daily_donations: vector.data,
      cumulative_totals: totals
    })
  }
}

donations = u:new_vector();
donations = u:append(donations, 120);
donations = u:append(donations, 75);
donations = u:append(donations, 210);
donations = u:append(donations, 95);
donations = u:append(donations, 160);

print("Problem: find the first day cumulative donations reach the 500 goal.");
print("Daily donations:");
print(donations.data);
print("Solution:");
unwrap(u:first_goal_day(donations, 500))
