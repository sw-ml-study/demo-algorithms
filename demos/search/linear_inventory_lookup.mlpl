# Mini-app: find a requested part in an unsorted shelf scan.
#
# Shelf order is physical, not sorted, so linear search is the correct general
# lookup. The algorithm checks each position from the front and returns the
# first matching index.
#
# data_structure: numeric vector
# algorithm: recursive linear search
# dynamic_size: no
# logical_complexity: O(n) time, O(n) recursion depth, O(1) logical state
# current_copy_complexity: no collection update
# explicit_loops: 0
# target_loops: 0
# required_features: current

include "../../src/search/linear_search.mlpl";

shelf_part_ids = [42, 17, 73, 17, 91];
requested_part = 73;
position = unwrap(u:linear_search(shelf_part_ids, requested_part, 0));

print("Problem: locate part 73 in an unsorted physical shelf scan.");
print("Shelf part IDs:");
print(shelf_part_ids);
print("Solution: linear search returns the first matching zero-based shelf position.");
{requested_part: requested_part, shelf_position: position}
