# Mini-app: determine whether a sorted appointment time is reserved.
#
# Appointment slots are sorted numeric minute offsets. Binary search discards
# half of the remaining interval after each comparison.
#
# data_structure: sorted numeric vector
# algorithm: recursive binary search
# dynamic_size: no
# logical_complexity: O(log n) time and recursion depth
# current_copy_complexity: no collection update
# explicit_loops: 0
# target_loops: 0
# required_features: current

include "../../src/search/binary_search.mlpl";

reserved_minutes = [540, 585, 630, 720, 810, 900];
requested_minute = 720;
position = unwrap(u:binary_search(reserved_minutes, requested_minute, 0, tally(reserved_minutes) - 1));

print("Problem: determine whether minute 720 is already reserved in a sorted schedule.");
print("Reserved minute offsets:");
print(reserved_minutes);
print("Solution: binary search finds the reservation while inspecting logarithmically many positions.");
{requested_minute: requested_minute, reserved: 1, schedule_position: position}
