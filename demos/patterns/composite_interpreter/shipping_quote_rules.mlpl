# Mini-app: compose and interpret a reusable numeric shipping quote rule.
# pattern: closed functional Composite and Interpreter
# data_structure: immutable nested numeric-tag expression tree
# algorithm: recursive part-whole traversal and closed arithmetic interpretation
# representation: literal leaves and binary operator composites tagged 0 through 4
# dynamic_size: yes
# logical_complexity: O(nodes) evaluation and traversal
# current_copy_complexity: nested records may copy reused subtrees; physical sharing is not observable
# recursion_depth: O(tree height)
# explicit_loops: 0
# target_loops: 0
# required_features: current closed schema and dispatch
# future_improvement: tagged variants, pattern matching, UDF algebras/folds, modules, and structural sharing

include "../../../src/trees/shipping_cost_expression.mlpl";

distance_charge = u:operation(3, u:literal(18), u:literal(4));
base_quote = u:operation(1, u:literal(25), distance_charge);
discounted_quote = u:operation(2, base_quote, u:literal(15));
print("Problem: build a shipping quote from reusable rule parts and evaluate the final pricing expression.");
print("Solution: Composite supplies literal/operation part-whole structure; the closed Interpreter assigns arithmetic meaning to numeric tags.");
{node_count: u:count_nodes(discounted_quote), prefix_rule: u:prefix_tokens(discounted_quote), quote: unwrap(u:evaluate(discounted_quote)), retained_distance_charge: unwrap(u:evaluate(distance_charge))}
