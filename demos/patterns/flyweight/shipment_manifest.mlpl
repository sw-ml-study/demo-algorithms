# Mini-app: price shipment workload using shared package-type attributes.
# pattern: functional Flyweight
# data_structure: one intrinsic numeric type table plus lightweight type-ID and quantity vectors
# algorithm: recursively resolve repeated IDs with per-order extrinsic quantities
# representation: type attributes stored once; order rows carry only numeric ID and quantity
# dynamic_size: yes
# logical_complexity: O(orders) time and output space
# current_copy_complexity: immutable concat copies growing result vectors; intrinsic table is passed unchanged
# recursion_depth: O(orders)
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: integer IDs, UDF folds, builders, modules, and observable sharing diagnostics

include "../../../src/patterns/flyweight/shipment_type_table.mlpl";

types = unwrap(u:new_shipment_type_table([2,5,12], [1,3,8]));
order_type_ids = [0,2,0,1,2,0]; order_quantities = [4,1,3,2,2,5];
manifest = unwrap(u:resolve_shipments(types, order_type_ids, order_quantities));
print("Problem: calculate many shipment rows without copying package weight and handling attributes into every order.");
print("Solution: orders carry lightweight numeric type IDs and quantities; one shared intrinsic table supplies type attributes.");
{order_count: tally(order_type_ids), type_count: types.type_count, type_ids: order_type_ids, shipment_weights: manifest.weights, total_weight: manifest.total_weight, total_handling: manifest.total_handling}
