# Mini-app: derive an event transit service from a reusable weekday prototype.
# pattern: functional Prototype
# data_structure: immutable weighted edge-list graph values
# algorithm: clone-by-value followed by explicit payload and edge transformations
# representation: parallel graph vectors retained in each observable version
# dynamic_size: yes
# logical_complexity: O(E) route lookup plus O(V) payload update
# current_copy_complexity: scatter/concat copy affected vectors; physical sharing is not observable or claimed
# recursion_depth: O(E) duplicate-route search
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: record update/spread, structural-sharing evidence, modules, and lenses

include "../../../src/patterns/prototype/transit_service_prototype.mlpl";

empty = u:new_graph(4, [10,20,30,40]); p1 = unwrap(u:add_edge(empty, 0, 1, 8)); weekday = unwrap(u:add_edge(p1, 1, 2, 6));
event_service = unwrap(u:derive_transit_prototype(weekday, 2, 300, 2, 3, 4));
print("Problem: create a special-event transit service without rebuilding or changing the weekday service template.");
print("Solution: Prototype is ordinary immutable value derivation: apply explicit changes and retain the original graph version.");
{weekday_edges: weekday.edges, weekday_stop_2_demand: take(weekday.payloads, 0, 2), event_edges: event_service.edges, event_stop_2_demand: take(event_service.payloads, 0, 2), event_destinations: event_service.targets}
