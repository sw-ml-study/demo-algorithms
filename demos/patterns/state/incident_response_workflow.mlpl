# Mini-app: advance an incident through acknowledge, resolve, and reopen states.
# pattern: closed functional State
# data_structure: immutable numeric state record and effect-description vectors
# algorithm: closed state/event transition dispatch with effects interpreted at the boundary
# representation: status tags 0 reported, 1 acknowledged, 2 resolved; events 1 acknowledge, 2 resolve, 3 reopen
# dynamic_size: effect vectors are returned per transition
# logical_complexity: O(1) transition and O(effects) boundary interpretation
# current_copy_complexity: small records/vectors are reconstructed per transition
# recursion_depth: constant
# explicit_loops: 0
# target_loops: 0
# required_features: current closed numeric dispatch
# future_improvement: first-class transition functions/tables, variants, folds, modules, and record update

include "../../../src/patterns/state/incident_workflow.mlpl";

reported = u:new_incident(); acknowledged = unwrap(u:transition_incident(reported, 1, 42)); resolved = unwrap(u:transition_incident(acknowledged.state, 2, 42)); reopened = unwrap(u:transition_incident(resolved.state, 3, 77));
delivery = u:interpret_incident_effects(reopened.effects);
print("Problem: evolve an incident predictably while keeping notifications and audit writes outside pure transition logic.");
print("Solution: closed State dispatch returns a new immutable state plus effects-as-data for separate boundary interpretation.");
{reported_status: reported.status, resolved_status: resolved.state.status, current_status: reopened.state.status, current_owner: reopened.state.owner, revision: reopened.state.revision, notifications_to_deliver: delivery.notification_count, audit_entries: delivery.audit_count}
