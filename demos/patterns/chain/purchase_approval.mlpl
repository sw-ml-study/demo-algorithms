# Mini-app: route purchases to the first approval handler whose limit accepts them.
# pattern: constrained functional Chain of Responsibility
# data_structure: nested immutable callable handler/environment records
# algorithm: handler-local accept-or-delegate with first-acceptance short circuit
# representation: each handler owns its decision and callable successor; no central opcode routing
# dynamic_size: no; fixed three-node chain
# logical_complexity: O(handlers visited)
# current_copy_complexity: trace vectors grow while delegated results return
# recursion_depth: O(handlers visited) through callable delegation
# explicit_loops: 0
# target_loops: 0
# required_features: named UDF references, nested records, uniform call, available now
# future_improvement: dynamic callable/general-value collections and short-circuit UDF fold

include "../../../src/patterns/chain/purchase_approval_chain.mlpl";

terminal = {fn: :u:unhandled_purchase_handler, environment: {handler_id: 99}};
manager = {fn: :u:manager_purchase_handler, environment: {handler_id: 20, limit: 1000, next: terminal}};
chain = {fn: :u:team_purchase_handler, environment: {handler_id: 10, limit: 100, next: manager}};
small = {request_id: 501, amount: 80};
medium = {request_id: 502, amount: 450};
small_result = unwrap(u:request_purchase_approval(chain, small));
medium_result = unwrap(u:request_purchase_approval(chain, medium));
print("Problem: purchase requests must stop at the first independently responsible approver.");
print("Solution: each callable handler accepts or delegates to its nested successor; no central router selects behavior.");
{small_handler: small_result.handler_id,
 small_trace: small_result.trace,
 medium_handler: medium_result.handler_id,
 medium_trace: medium_result.trace,
 medium_effects: medium_result.effects,
 retained_small_amount: small.amount,
 retained_medium_amount: medium.amount}
