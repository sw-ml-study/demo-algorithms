# Mini-app: assemble a validated replicated-storage plan in explicit stages.
# pattern: constrained functional Builder
# data_structure: immutable staged configuration records
# algorithm: pure with-capacity, with-replicas, with-backup transformations then build
# representation: flags record required stages; every transformation returns a new version
# dynamic_size: no
# logical_complexity: O(1) per stage
# current_copy_complexity: full small record rebuilt at each stage
# recursion_depth: constant
# explicit_loops: 0
# target_loops: 0
# required_features: immutable records and Result propagation, available now
# future_improvement: record update/spread, pipes, lenses, modules, and partial binding

include "../../../src/patterns/builder/storage_plan_builder.mlpl";

empty = u:new_storage_plan_builder(901);
sized = unwrap(u:with_storage_capacity(empty, 80));
replicated = unwrap(u:with_storage_replicas(sized, 3));
protected = unwrap(u:with_storage_backup(replicated, 1));
plan = unwrap(u:build_storage_plan(protected));
print("Problem: assemble a storage plan through validated optional and required stages while retaining earlier drafts.");
print("Solution: a functional Builder is a pipeline of pure transformations ending in a separate validated build step.");
{plan_id: plan.plan_id,
 capacity: plan.capacity,
 replicas: plan.replicas,
 backup: plan.backup,
 reserved_capacity: plan.reserved_capacity,
 empty_revision: empty.revision,
 sized_revision: sized.revision,
 final_revision: plan.builder_revision,
 retained_empty_capacity: empty.capacity}
