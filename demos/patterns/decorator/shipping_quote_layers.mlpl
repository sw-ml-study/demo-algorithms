# Mini-app: add surcharge and insurance behavior around a shipping quote.
# pattern: functional Decorator
# data_structure: nested immutable service/environment records with UDF references
# algorithm: recursive delegation followed by additive accounting
# representation: every layer implements the same request/environment quote protocol
# dynamic_size: accounting effect vector grows with decorator depth
# logical_complexity: O(layers)
# current_copy_complexity: growing accounting vectors and nested environments
# recursion_depth: O(layers) through delegated calls
# explicit_loops: 0
# target_loops: 0
# required_features: named UDF references, nested records, uniform call, available now
# future_improvement: closures/partial binding, composition, modules, and record update

include "../../../src/patterns/decorator_proxy/service_wrappers.mlpl";

base = {fn: :u:base_shipping_quote, environment: {rate: 4}};
surcharged = {fn: :u:surcharge_quote, environment: {inner: base, surcharge: 7}};
insured = {fn: :u:insurance_quote, environment: {inner: surcharged, per_unit: 2}};
request = {units: 5};
plain = unwrap(u:run_quote(base, request));
layered = unwrap(u:run_quote(insured, request));
print("Problem: add surcharge and insurance accounting without editing the base shipping quote.");
print("Solution: each Decorator delegates through the same protocol, then adds one immutable layer.");
{plain_amount: plain.amount,
 decorated_amount: layered.amount,
 decorator_layers: layered.layers,
 accounting_effects: layered.accounting,
 retained_units: request.units}
