# Mini-app: provision analytics sites from coherent product families.
# pattern: functional Abstract Factory
# data_structure: fixed record of related constructor UDF references
# algorithm: invoke both family constructors then validate product compatibility
# representation: two fixed factory records each create a worker and storage product
# dynamic_size: no
# logical_complexity: O(1)
# current_copy_complexity: constant-size factory and product records
# recursion_depth: constant
# explicit_loops: 0
# target_loops: 0
# required_features: first-class UDF references in records and uniform call, available in current binary
# future_improvement: dynamic general-value registries and modules for extensible family discovery and privacy

include "../../../src/patterns/factory/fulfillment_factories.mlpl";

capacity = 8;
families = {
  local: {create_worker: :u:create_local_worker, create_store: :u:create_local_store},
  remote: {create_worker: :u:create_remote_worker, create_store: :u:create_remote_store}
};
local = unwrap(u:provision_analytics_site(capacity, families.local));
remote = unwrap(u:provision_analytics_site(capacity, families.remote));
print("Problem: provision compatible worker and storage products for local and remote analytics sites.");
print("Solution: each fixed Abstract Factory record supplies a coherent family to one unchanged client.");

{requested_capacity: capacity,
 local_family: local.family,
 local_worker: local.worker.worker_kind,
 local_store: local.store.store_kind,
 local_total_capacity: local.total_capacity,
 remote_family: remote.family,
 remote_worker: remote.worker.worker_kind,
 remote_store: remote.store.store_kind,
 remote_total_capacity: remote.total_capacity}
