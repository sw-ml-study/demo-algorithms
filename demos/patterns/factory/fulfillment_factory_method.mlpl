# Mini-app: prepare one order through interchangeable fulfillment constructors.
# pattern: functional Factory Method
# data_structure: immutable order record plus injected constructor UDF reference
# algorithm: construct then summarize through one unchanged client workflow
# representation: named UDF reference supplies creation behavior; product is an immutable record
# dynamic_size: no
# logical_complexity: O(1)
# current_copy_complexity: constant-size records
# recursion_depth: constant
# explicit_loops: 0
# target_loops: 0
# required_features: first-class UDF references and uniform call, available in current binary
# future_improvement: modules for constructor exports and composition for richer workflows

include "../../../src/patterns/factory/fulfillment_factories.mlpl";

order_id = 7001;
units = 6;
economy = unwrap(u:prepare_fulfillment(order_id, units, :u:create_economy_order));
expedited = unwrap(u:prepare_fulfillment(order_id, units, :u:create_expedited_order));
print("Problem: prepare the same order under economy and expedited fulfillment without changing the workflow.");
print("Solution: Factory Method injects either constructor into one pure preparation function.");

{order_id: order_id,
 units: units,
 economy_class: economy.order.service_class,
 economy_fee: economy.total_fee,
 economy_ready_day: economy.ready_day,
 expedited_class: expedited.order.service_class,
 expedited_fee: expedited.total_fee,
 expedited_ready_day: expedited.ready_day}
