# Mini-app: execute deposit and withdrawal requests as immutable Commands.
# pattern: functional Command
# data_structure: fixed executable command records plus immutable account state/effects
# algorithm: uniform invocation of captured numeric argument/environment
# representation: each command carries execute UDF, argument record, and environment record
# dynamic_size: effect vectors are returned per invocation
# logical_complexity: O(1) per command
# current_copy_complexity: constant-size state/effect records
# recursion_depth: constant
# explicit_loops: 0
# target_loops: 0
# required_features: named UDF references in fixed records and uniform call, available now
# future_improvement: heterogeneous command collections, modules, variants, closures, and record update

include "../../../src/patterns/command_visitor/functional_operations.mlpl";

initial = {balance: 100, revision: 0};
deposit = {execute: :u:deposit_funds, argument: {amount: 35}, environment: {account_id: 700, minimum_balance: 0}};
withdraw = {execute: :u:withdraw_funds, argument: {amount: 20}, environment: {account_id: 700, minimum_balance: 10}};
after_deposit = unwrap(u:invoke_command(deposit, initial));
after_withdraw = unwrap(u:invoke_command(withdraw, after_deposit.state));
print("Problem: queue-ready account requests must carry behavior and data without mutating prior account versions.");
print("Solution: each Command stores an executable UDF, argument, and environment; invocation returns state and effects.");
{initial_balance: initial.balance,
 deposited_balance: after_deposit.state.balance,
 final_balance: after_withdraw.state.balance,
 final_revision: after_withdraw.state.revision,
 deposit_effect: after_deposit.effects,
 withdraw_effect: after_withdraw.effects}
