# Mini-app: notify inventory and audit subscribers about one sale event.
# pattern: constrained functional Observer
# data_structure: fixed callable subscriber record plus independent immutable states/effects
# algorithm: invoke each subscriber and combine returned effect descriptions
# representation: two named subscriber fields; not a dynamic subscription collection
# dynamic_size: effect vectors grow with fixed notifications
# logical_complexity: O(subscribers), fixed at two
# current_copy_complexity: small state records/effect vectors rebuilt
# recursion_depth: constant
# explicit_loops: 0
# target_loops: 0
# required_features: named UDF references, fixed records, uniform call, available now
# future_improvement: dynamic callable collections, UDF fold, modules, general subscriber values

include "../../../src/patterns/observer_mediator/fixed_coordination.mlpl";

observers = {inventory: {fn: :u:inventory_subscriber, environment: {subscriber_id: 11}}, audit: {fn: :u:audit_subscriber, environment: {subscriber_id: 22}}};
states = {inventory: {available: 20, notifications: 0}, audit: {last_event: 0, notifications: 0}};
event = {event_id: 501, units: 3};
notified = unwrap(u:notify_fixed_observers(observers, event, states));
print("Problem: inventory and audit views must react independently to the same sale without hidden mutation.");
print("Solution: fixed Observer fields receive the event and return their own new states and effects as data.");
{remaining_inventory: notified.states.inventory.available,
 inventory_notifications: notified.states.inventory.notifications,
 audit_last_event: notified.states.audit.last_event,
 audit_notifications: notified.states.audit.notifications,
 effects: notified.effects,
 retained_available: states.inventory.available}
