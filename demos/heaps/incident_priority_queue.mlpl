# Mini-app: dispatch incident-response jobs by lowest numeric urgency value.
#
# Incidents arrive out of priority order. A priority queue delegates storage to
# an immutable dense binary min-heap, whose recursive sift-up and sift-down
# keep the most urgent incident at index zero.
#
# data_structure: dense binary min-heap and priority queue
# algorithm: recursive sift-up, sift-down, insert, and remove-min
# dynamic_size: yes
# logical_complexity: enqueue/dequeue O(log n), peek O(1)
# current_copy_complexity: each immutable scatter/concat/compress may copy O(n)
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: persistent vector or scoped builder/transient storage

def u:empty_heap() { "Create an empty heap value."; {priorities: fill([0], 0), job_ids: fill([0], 0), size: 0} }
def u:swap_values(values, left, right) { "Return the swap values result for the supplied values, left, right.";
  left_value = take(values, 0, left);
  right_value = take(values, 0, right);
  scatter(scatter(values, left, right_value), right, left_value)
}
def u:swap_nodes(heap, left, right) { "Return the swap nodes result for the supplied heap, left, right.";
  {priorities: u:swap_values(heap.priorities, left, right), job_ids: u:swap_values(heap.job_ids, left, right), size: heap.size}
}
def u:sift_up(heap, index) { "Return the sift up result for the supplied heap, index.";
  if eq(index, 0) { heap } else {
    parent = floor((index - 1) / 2);
    if lt(take(heap.priorities, 0, index), take(heap.priorities, 0, parent)) {
      u:sift_up(u:swap_nodes(heap, index, parent), parent)
    } else { heap }
  }
}
def u:sift_down(heap, index) { "Return the sift down result for the supplied heap, index.";
  left = index * 2 + 1;
  if gt(left, heap.size - 1) { heap } else {
    right = left + 1;
    child = if lt(right, heap.size) {
      if lt(take(heap.priorities, 0, right), take(heap.priorities, 0, left)) { right } else { left }
    } else { left };
    if lt(take(heap.priorities, 0, child), take(heap.priorities, 0, index)) {
      u:sift_down(u:swap_nodes(heap, index, child), child)
    } else { heap }
  }
}
def u:heap_insert(heap, priority, job_id) { "Return the heap insert result for the supplied heap, priority, job_id.";
  grown = {priorities: concat(heap.priorities, priority), job_ids: concat(heap.job_ids, job_id), size: heap.size + 1};
  u:sift_up(grown, heap.size)
}
def u:remove_min(heap) { "Remove the next item and return the resulting structure.";
  if eq(heap.size, 0) { err({kind: "empty", message: "priority queue is empty"}) } else {
    priority = take(heap.priorities, 0, 0);
    job_id = take(heap.job_ids, 0, 0);
    if eq(heap.size, 1) { ok({priority: priority, job_id: job_id, heap: u:empty_heap()}) } else {
      last = heap.size - 1;
      moved_priorities = scatter(heap.priorities, 0, take(heap.priorities, 0, last));
      moved_ids = scatter(heap.job_ids, 0, take(heap.job_ids, 0, last));
      keep = lt(range(heap.size), last);
      smaller = {priorities: compress(keep, moved_priorities), job_ids: compress(keep, moved_ids), size: last};
      ok({priority: priority, job_id: job_id, heap: u:sift_down(smaller, 0)})
    }
  }
}

queue0 = u:empty_heap();
queue1 = u:heap_insert(queue0, 5, 801);
queue2 = u:heap_insert(queue1, 1, 802);
queue3 = u:heap_insert(queue2, 3, 803);
queue4 = u:heap_insert(queue3, 2, 804);
first = unwrap(u:remove_min(queue4));
second = unwrap(u:remove_min(first.heap));
third = unwrap(u:remove_min(second.heap));

print("Problem: dispatch incidents by urgency even though they arrive out of priority order.");
print("Arrival job IDs with priorities 5, 1, 3, 2:");
print([801, 802, 803, 804]);
print("Solution: the delegated min-heap returns the three most urgent jobs first.");
{dispatched_job_ids: [first.job_id, second.job_id, third.job_id], dispatched_priorities: [first.priority, second.priority, third.priority], still_waiting: third.heap.job_ids}
