# Mini-app: insert an urgent stop into a delivery route.
#
# Route 101 -> 202 -> 303 is already scheduled when urgent stop 250 must be
# inserted after stop 202. An index-backed singly linked list fits because the
# logical order changes by appending one node and rewiring one next handle; the
# existing physical node values do not shift.
#
# data_structure: index-backed singly linked list
# algorithm: find target, insert-after, traverse
# representation: parallel values/next arrays, head index, -1 null handle
# dynamic_size: yes
# logical_complexity: find O(n), insert after known node O(1), traversal O(n)
# current_copy_complexity: array append/scatter copy O(n) storage
# explicit_loops: 3
# target_loops: 0 with UDF-capable find/fold/unfold
# required_features: current

def u:valid(list) { "Check whether list satisfies the valid invariant.";
  shape_ok = eq(rank(list.values), 1) * eq(rank(list.next), 1);
  size_ok = eq(list.size, tally(list.values)) * eq(list.size, tally(list.next));
  if shape_ok * size_ok {
    current = list.head;
    count = 0;
    ok_flag = 1;
    while lt(count, list.size) {
      if eq(current, 0 - 1) { ok_flag = 0; break } else {
        if lt(current, 0) { ok_flag = 0; break } else {
          if gt(current, list.size - 1) { ok_flag = 0; break } else {
            current = take(list.next, 0, current);
            count = count + 1
          }
        }
      }
    };
    ok_flag * eq(current, 0 - 1) * eq(count, list.size)
  } else { 0 }
}

def u:find_node(list, stop_id) { "Find node in the supplied structure.";
  current = list.head;
  steps = 0;
  found = 0 - 1;
  while lt(steps, list.size) {
    if eq(take(list.values, 0, current), stop_id) {
      found = current;
      break
    } else {
      current = take(list.next, 0, current);
      steps = steps + 1
    }
  };
  found
}

def u:insert_after(list, stop_id, urgent_id) { "Add the supplied item and return the updated structure.";
  if u:valid(list) {
    target = u:find_node(list, stop_id);
    if eq(target, 0 - 1) {
      err({kind: "missing-stop", message: "target stop is not in the route"})
    } else {
      new_index = list.size;
      successor = take(list.next, 0, target);
      next_with_node = concat(list.next, successor);
      rewired = scatter(next_with_node, target, new_index);
      ok({
        values: concat(list.values, urgent_id),
        next: rewired,
        head: list.head,
        size: list.size + 1
      })
    }
  } else {
    err({kind: "representation", message: "delivery route is invalid"})
  }
}

def u:traverse(list) { "Traverse the supplied structure in traverse order.";
  if u:valid(list) {
    route_values = fill([0], 0);
    current = list.head;
    steps = 0;
    while lt(steps, list.size) {
      route_values = concat(route_values, take(list.values, 0, current));
      current = take(list.next, 0, current);
      steps = steps + 1
    };
    ok(route_values)
  } else {
    err({kind: "representation", message: "cannot traverse invalid route"})
  }
}

delivery_list = {values: [101, 202, 303], next: [1, 2, 0 - 1], head: 0, size: 3};

print("Problem: insert urgent stop 250 after stop 202 in route 101 -> 202 -> 303.");
print("Physical node values before insertion:");
print(delivery_list.values);

updated = unwrap(u:insert_after(delivery_list, 202, 250));
logical_route = unwrap(u:traverse(updated));

print("Solution: only one next handle is rewired; existing values do not shift.");
{
  logical_route: logical_route,
  physical_values: updated.values,
  next_handles: updated.next,
  inserted_node_index: updated.size - 1
}
