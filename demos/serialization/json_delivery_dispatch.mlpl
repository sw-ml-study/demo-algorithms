# Mini-app: configure a capacity-limited delivery dispatch from a JSON file.
# data_structure: typed record and numeric vector decoded from JSON
# algorithm: parse, validate, prefix-sum, capacity filter, and summarize
# representation: JSON object -> MLPL record with scalar fields and a numeric vector
# dynamic_size: yes
# logical_complexity: O(n)
# current_copy_complexity: JSON decode and immutable vector filtering allocate values
# explicit_loops: 0
# target_loops: 0
# required_features: parse_json, sandboxed read_text, records, Results, running_sum, and compress
# future_improvement: add deterministic encode_json for a durable round trip and path-aware schema errors

include "../../src/serialization/json_dispatch_config.mlpl";

config_text = read_text("data/serialization/delivery_dispatch.json")?;
plan = u:dispatch_plan_from_json(config_text)?;
print("Problem: dispatch policy is supplied as an external JSON file, and the truck must preserve reserve capacity.");
print("Solution: sandboxed text I/O and typed JSON decoding feed a prefix-capacity planner without explicit loops.");
plan
