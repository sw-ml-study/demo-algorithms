# Mini-app: compare an exact delivery tour with a fast nearest-neighbor tour.
# data_structure: flat numeric distance matrix, visited vector, and growing route
# algorithm: factorial exact backtracking, Held-Karp DP, nearest neighbor, and 2-opt
# representation: fixed start/end city; negative off-diagonal distance means disconnected
# dynamic_size: yes
# logical_complexity: factorial O((V-1)!*V), Held-Karp O(V^2*2^V), heuristics O(V^2) per pass
# current_copy_complexity: immutable visited, route, and O(V*2^V) DP tables copy during updates
# recursion_depth: O(V) plus candidate recursion
# explicit_loops: 0
# target_loops: 0
# required_features: current recursion, scatter, and concat
# future_improvement: permutation/unfold combinator, pruning policy UDF, and scoped transient buffers

include "../../src/graphs/traveling_salesman.mlpl";

distances = [0,18,6,10,6, 18,0,12,24,20, 6,12,0,14,10, 10,24,14,0,4, 6,20,10,4,0];
exact = unwrap(u:tsp_exact(distances, 5, 0));
held_karp = unwrap(u:tsp_held_karp(distances, 5, 0));
nearest = unwrap(u:tsp_nearest(distances, 5, 0));
improved = unwrap(u:tsp_two_opt(distances, 5, nearest.tour));
print("Problem: visit every delivery city once and return to depot 0 with minimum travel cost.");
print("Solution: factorial search and Held-Karp DP prove the optimum; nearest neighbor plus 2-opt provide fast comparisons.");
{exact_tour: exact.tour, exact_cost: exact.cost, held_karp_tour: held_karp.tour, held_karp_cost: held_karp.cost, held_karp_states: held_karp.states, nearest_tour: nearest.tour, nearest_cost: nearest.cost, two_opt_tour: improved.tour, two_opt_cost: improved.cost, two_opt_improvements: improved.improvements, heuristic_gap: nearest.cost - exact.cost, retained_distances: distances}
