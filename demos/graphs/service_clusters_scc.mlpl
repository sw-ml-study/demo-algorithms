# Mini-app: group mutually reachable services into recovery clusters.
# data_structure: directed adjacency matrices and component-label vector
# algorithm: recursive Kosaraju finish order, transpose, component assignment
# representation: numeric node IDs; flat presence matrices
# dynamic_size: yes
# logical_complexity: O(V^2) with dense neighbor scans
# current_copy_complexity: immutable visited/order/label updates copy arrays
# explicit_loops: 0
# target_loops: 0
# required_features: current
# cycle_policy: numeric-ID cycles are valid application-owned graph data

def u:graph(vertices, sources, targets) { {vertices: vertices, sources: sources, targets: targets, edges: tally(sources)} }
def u:matrix_add(graph, position, present, reversed_flag) { if eq(position, graph.edges) { {vertices: graph.vertices, present: present} } else { source = if reversed_flag { take(graph.targets, 0, position) } else { take(graph.sources, 0, position) }; target = if reversed_flag { take(graph.sources, 0, position) } else { take(graph.targets, 0, position) }; u:matrix_add(graph, position + 1, scatter(present, source * graph.vertices + target, 1), reversed_flag) } }
def u:matrix(graph, reversed_flag) { u:matrix_add(graph, 0, fill([graph.vertices * graph.vertices], 0), reversed_flag) }
def u:neighbors(matrix, source) { positions = range(matrix.vertices * matrix.vertices); row = compress(eq(floor(positions / matrix.vertices), source), matrix.present); compress(row, range(matrix.vertices)) }
def u:finish_neighbors(matrix, nodes, position, traversal) { if eq(position, tally(nodes)) { traversal } else { next_state = u:finish_node(matrix, take(nodes, 0, position), traversal); u:finish_neighbors(matrix, nodes, position + 1, next_state) } }
def u:finish_node(matrix, node, traversal) { if eq(take(traversal.visited, 0, node), 1) { traversal } else { entered = {visited: scatter(traversal.visited, node, 1), order: traversal.order}; explored = u:finish_neighbors(matrix, u:neighbors(matrix, node), 0, entered); {visited: explored.visited, order: concat(explored.order, node)} } }
def u:finish_scan(matrix, node, traversal) { if eq(node, matrix.vertices) { traversal } else { u:finish_scan(matrix, node + 1, u:finish_node(matrix, node, traversal)) } }
def u:reverse_from(values, position) { if lt(position, 0) { fill([0], 0) } else { concat(take(values, 0, position), u:reverse_from(values, position - 1)) } }
def u:assign_neighbors(matrix, nodes, position, component, labels) { if eq(position, tally(nodes)) { labels } else { next_labels = u:assign_node(matrix, take(nodes, 0, position), component, labels); u:assign_neighbors(matrix, nodes, position + 1, component, next_labels) } }
def u:assign_node(matrix, node, component, labels) { if gt(take(labels, 0, node), -1) { labels } else { marked = scatter(labels, node, component); u:assign_neighbors(matrix, u:neighbors(matrix, node), 0, component, marked) } }
def u:assign_order(matrix, order, position, component, labels) { if eq(position, tally(order)) { {labels: labels, components: component} } else { node = take(order, 0, position); if gt(take(labels, 0, node), -1) { u:assign_order(matrix, order, position + 1, component, labels) } else { u:assign_order(matrix, order, position + 1, component + 1, u:assign_node(matrix, node, component, labels)) } } }
def u:scc(graph) { forward = u:matrix(graph, 0); finished = u:finish_scan(forward, 0, {visited: fill([graph.vertices], 0), order: fill([0], 0)}); order = u:reverse_from(finished.order, tally(finished.order) - 1); u:assign_order(u:matrix(graph, 1), order, 0, 0, fill([graph.vertices], -1)) }

services = u:graph(7, [0, 1, 2, 2, 3, 4, 4], [1, 2, 0, 3, 4, 3, 5]); clusters = u:scc(services);
print("Problem: group mutually reachable services for coordinated recovery while leaving one-way and isolated services separate.");
print("Solution: Kosaraju finish order plus transpose traversal assigns deterministic recovery-cluster IDs.");
{component_labels: clusters.labels, component_count: clusters.components, cycle_cluster_0_1_2: take(clusters.labels, 0, 0), cycle_cluster_3_4: take(clusters.labels, 0, 3), isolated_service_6_cluster: take(clusters.labels, 0, 6)}
