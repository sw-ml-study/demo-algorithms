# Mini-app: find minimum-hop evacuation reachability in a cyclic directed network.
# data_structure: adjacency matrix plus pure queue state
# algorithm: breadth-first search with parents and hop levels
# representation: flat presence matrix, numeric node IDs, visited mask
# dynamic_size: yes
# logical_complexity: O(V^2) with dense neighbor scans
# current_copy_complexity: immutable queue concat and mask scatter copy arrays
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: import shared graph/queue modules and use CSR

def u:graph(vertices, sources, targets) { {vertices: vertices, sources: sources, targets: targets, edges: tally(sources)} }
def u:matrix_add(graph, position, present) { if eq(position, graph.edges) { {vertices: graph.vertices, present: present} } else { u:matrix_add(graph, position + 1, scatter(present, take(graph.sources, 0, position) * graph.vertices + take(graph.targets, 0, position), 1)) } }
def u:matrix(graph) { u:matrix_add(graph, 0, fill([graph.vertices * graph.vertices], 0)) }
def u:neighbors(matrix, source) { positions = range(matrix.vertices * matrix.vertices); row = compress(eq(floor(positions / matrix.vertices), source), matrix.present); compress(row, range(matrix.vertices)) }
def u:enqueue_neighbors(nodes, position, parent, traversal) { if eq(position, tally(nodes)) { traversal } else { node = take(nodes, 0, position); if eq(take(traversal.visited, 0, node), 1) { u:enqueue_neighbors(nodes, position + 1, parent, traversal) } else { extended = {queue: concat(traversal.queue, node), head: traversal.head, visited: scatter(traversal.visited, node, 1), parents: scatter(traversal.parents, node, parent), levels: scatter(traversal.levels, node, take(traversal.levels, 0, parent) + 1), order: traversal.order}; u:enqueue_neighbors(nodes, position + 1, parent, extended) } } }
def u:bfs_steps(matrix, traversal) { if eq(traversal.head, tally(traversal.queue)) { traversal } else { node = take(traversal.queue, 0, traversal.head); advanced = {queue: traversal.queue, head: traversal.head + 1, visited: traversal.visited, parents: traversal.parents, levels: traversal.levels, order: concat(traversal.order, node)}; u:bfs_steps(matrix, u:enqueue_neighbors(u:neighbors(matrix, node), 0, node, advanced)) } }
def u:bfs(matrix, start) { if lt(start, 0) + gt(start, matrix.vertices - 1) { err({kind: "start", message: "invalid start"}) } else { ok(u:bfs_steps(matrix, {queue: reshape(start, [1]), head: 0, visited: scatter(fill([matrix.vertices], 0), start, 1), parents: fill([matrix.vertices], -1), levels: scatter(fill([matrix.vertices], -1), start, 0), order: fill([0], 0)})) } }

network = u:graph(7, [0, 0, 1, 2, 3, 4, 4], [1, 2, 3, 3, 4, 1, 5]); result = unwrap(u:bfs(u:matrix(network), 0));
print("Problem: identify every reachable evacuation station and its minimum hop count from station 0.");
print("Solution: a pure queue drives BFS; visited-on-enqueue terminates the directed cycle.");
{visit_order: result.order, hop_levels: result.levels, parents: result.parents, unreachable_station_6_level: take(result.levels, 0, 6)}
