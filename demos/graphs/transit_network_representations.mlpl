# Mini-app: normalize a directed transit network and expose matrix/CSR queries.
#
# Edge-list insertion uses last-write-wins for duplicate source/target pairs.
# Matrix presence is separate from weights so a zero-weight edge is not absent.
# Numeric node IDs make self-loops and longer cycles ordinary application data.
#
# data_structure: weighted edge list, adjacency matrix, and CSR graph
# algorithm: duplicate normalization and representation conversion
# representation: parallel arrays with numeric node IDs
# dynamic_size: yes
# logical_complexity: conversion O(VE), neighbor query O(V) matrix/O(degree) CSR
# current_copy_complexity: concat/scatter and recursive conversion copy arrays
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: modules, slices, UDF folds, sparse builders

def u:new_graph(vertices, payloads) { {vertices: vertices, payloads: payloads, sources: fill([0], 0), targets: fill([0], 0), weights: fill([0], 0), edges: 0} }
def u:find_pair(graph, source, target, position) { if eq(position, graph.edges) { -1 } else { if eq(take(graph.sources, 0, position), source) * eq(take(graph.targets, 0, position), target) { position } else { u:find_pair(graph, source, target, position + 1) } } }
def u:add_edge(graph, source, target, weight) { if lt(source, 0) + lt(target, 0) + gt(source, graph.vertices - 1) + gt(target, graph.vertices - 1) { err({kind: "endpoint", message: "vertex is out of range"}) } else { existing = u:find_pair(graph, source, target, 0); if gt(existing, -1) { ok({vertices: graph.vertices, payloads: graph.payloads, sources: graph.sources, targets: graph.targets, weights: scatter(graph.weights, existing, weight), edges: graph.edges}) } else { ok({vertices: graph.vertices, payloads: graph.payloads, sources: concat(graph.sources, source), targets: concat(graph.targets, target), weights: concat(graph.weights, weight), edges: graph.edges + 1}) } } }
def u:matrix_from(graph, position, present, weights) { if eq(position, graph.edges) { {vertices: graph.vertices, present: present, weights: weights} } else { cell = take(graph.sources, 0, position) * graph.vertices + take(graph.targets, 0, position); u:matrix_from(graph, position + 1, scatter(present, cell, 1), scatter(weights, cell, take(graph.weights, 0, position))) } }
def u:to_matrix(graph) { u:matrix_from(graph, 0, fill([graph.vertices * graph.vertices], 0), fill([graph.vertices * graph.vertices], 0)) }
def u:csr_edges(graph, vertex, position, offsets, targets, weights) { if eq(vertex, graph.vertices) { {vertices: graph.vertices, offsets: offsets, targets: targets, weights: weights} } else { if eq(position, graph.edges) { u:csr_edges(graph, vertex + 1, 0, concat(offsets, tally(targets)), targets, weights) } else { if eq(take(graph.sources, 0, position), vertex) { u:csr_edges(graph, vertex, position + 1, offsets, concat(targets, take(graph.targets, 0, position)), concat(weights, take(graph.weights, 0, position))) } else { u:csr_edges(graph, vertex, position + 1, offsets, targets, weights) } } } }
def u:to_csr(graph) { u:csr_edges(graph, 0, 0, [0], fill([0], 0), fill([0], 0)) }
def u:matrix_neighbors(matrix, source) { positions = range(matrix.vertices * matrix.vertices); row = compress(eq(floor(positions / matrix.vertices), source), matrix.present); compress(row, range(matrix.vertices)) }
def u:csr_neighbors(csr, source) { positions = range(tally(csr.targets)); mask = (gt(positions, take(csr.offsets, 0, source) - 1)) * lt(positions, take(csr.offsets, 0, source + 1)); compress(mask, csr.targets) }

base = u:new_graph(5, [-10, 20, 30, 40, 50]);
g1 = unwrap(u:add_edge(base, 0, 1, 7)); g2 = unwrap(u:add_edge(g1, 1, 2, 8)); g3 = unwrap(u:add_edge(g2, 2, 0, 9)); g4 = unwrap(u:add_edge(g3, 1, 3, 0)); g5 = unwrap(u:add_edge(g4, 2, 2, 4)); network = unwrap(u:add_edge(g5, 0, 1, 6));
matrix = u:to_matrix(network); csr = u:to_csr(network);
print("Problem: query a directed transit network containing a cycle, self-loop, zero-cost edge, and isolated stop.");
print("Solution: one normalized edge list converts to presence-aware matrix and CSR representations.");
{edge_count: network.edges, neighbors_1_matrix: u:matrix_neighbors(matrix, 1), neighbors_1_csr: u:csr_neighbors(csr, 1), csr_offsets: csr.offsets, csr_targets: csr.targets, duplicate_edge_weight: take(network.weights, 0, 0), retained_base_edges: base.edges, isolated_neighbors: u:csr_neighbors(csr, 4)}
