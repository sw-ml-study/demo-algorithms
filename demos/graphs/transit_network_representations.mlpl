# Mini-app: normalize a directed transit network and expose matrix/CSR queries.
#
# Edge-list insertion uses last-write-wins for duplicate source/target pairs.
# Matrix presence is separate from weights so a zero-weight edge is not absent.
# Numeric node IDs make self-loops and longer cycles ordinary application data.
#
# data_structure: weighted edge list, adjacency matrix, and CSR graph
# algorithm: duplicate normalization and representation conversion
# representation: parallel arrays with numeric node IDs
# dynamic_size: yes
# logical_complexity: conversion O(VE), neighbor query O(V) matrix/O(degree) CSR
# current_copy_complexity: concat/scatter and recursive conversion copy arrays
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: modules, slices, UDF folds, sparse builders

include "../../src/graphs/transit_network_representations.mlpl";

base = u:new_graph(5, [-10, 20, 30, 40, 50]);
g1 = unwrap(u:add_edge(base, 0, 1, 7));
g2 = unwrap(u:add_edge(g1, 1, 2, 8));
g3 = unwrap(u:add_edge(g2, 2, 0, 9));
g4 = unwrap(u:add_edge(g3, 1, 3, 0));
g5 = unwrap(u:add_edge(g4, 2, 2, 4));
network = unwrap(u:add_edge(g5, 0, 1, 6));
matrix = u:to_matrix(network);
csr = u:to_csr(network);
print("Problem: query a directed transit network containing a cycle, self-loop, zero-cost edge, and isolated stop.");
print("Solution: one normalized edge list converts to presence-aware matrix and CSR representations.");
{edge_count: network.edges, neighbors_1_matrix: u:matrix_neighbors(matrix, 1), neighbors_1_csr: u:csr_neighbors(csr, 1), csr_offsets: csr.offsets, csr_targets: csr.targets, duplicate_edge_weight: take(network.weights, 0, 0), retained_base_edges: base.edges, isolated_neighbors: u:csr_neighbors(csr, 4)}
