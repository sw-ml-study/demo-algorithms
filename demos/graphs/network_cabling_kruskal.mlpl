# Mini-app: connect sites with the least total cable cost.
# data_structure: normalized weighted edge list plus immutable union-find
# algorithm: deterministic insertion sort and Kruskal minimum spanning forest
# representation: parallel numeric vectors; undirected endpoints stored low/high
# dynamic_size: accepted forest and normalized edge vectors grow recursively
# logical_complexity: O(E^2) insertion-sort baseline plus union-find operations
# current_copy_complexity: immutable concat/scatter repeatedly copy vectors
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: modules for shared union-find/sort helpers and COW/transients

def u:new_forest(nodes) { "Create an empty forest value."; {parents: range(nodes), ranks: fill([nodes], 0), nodes: nodes, components: nodes} }
def u:find_root(forest, node, steps) { "Find root in the supplied structure."; if eq(steps, forest.nodes) { err({kind: "cycle", message: "parent cycle"}) } else { parent = take(forest.parents, 0, node); if eq(parent, node) { ok({forest: forest, root: node}) } else { found = u:find_root(forest, parent, steps + 1)?; ok({forest: {parents: scatter(found.forest.parents, node, found.root), ranks: found.forest.ranks, nodes: forest.nodes, components: forest.components}, root: found.root}) } } }
def u:find(forest, node) { "Find the requested value or node in the supplied structure."; if lt(node, 0) + gt(node, forest.nodes - 1) { err({kind: "node", message: "node out of range"}) } else { u:find_root(forest, node, 0) } }
def u:union(forest, left, right) { "Return the union result for the supplied forest, left, right."; lf = u:find(forest, left)?; rf = u:find(lf.forest, right)?; a = lf.root; b = rf.root; if eq(a, b) { ok({forest: rf.forest, joined: 0}) } else { ra = take(rf.forest.ranks, 0, a); rb = take(rf.forest.ranks, 0, b); if lt(ra, rb) { ok({forest: {parents: scatter(rf.forest.parents, a, b), ranks: rf.forest.ranks, nodes: forest.nodes, components: forest.components - 1}, joined: 1}) } else { ranks = if eq(ra, rb) { scatter(rf.forest.ranks, a, ra + 1) } else { rf.forest.ranks }; ok({forest: {parents: scatter(rf.forest.parents, b, a), ranks: ranks, nodes: forest.nodes, components: forest.components - 1}, joined: 1}) } } }

def u:edge_index(edges, a, b, i) { "Return the edge index result for the supplied edges, a, b, i."; if eq(i, tally(edges.left)) { -1 } else { if eq(take(edges.left, 0, i), a) * eq(take(edges.right, 0, i), b) { i } else { u:edge_index(edges, a, b, i + 1) } } }
def u:add_normalized(edges, a, b, weight) { "Add the supplied item and return the updated structure."; at = u:edge_index(edges, a, b, 0); if eq(at, -1) { {left: concat(edges.left, a), right: concat(edges.right, b), weights: concat(edges.weights, weight)} } else { old = take(edges.weights, 0, at); if lt(weight, old) { {left: edges.left, right: edges.right, weights: scatter(edges.weights, at, weight)} } else { edges } } }
def u:normalize_from(nodes, left, right, weights, i, edges) { "Continue normalize from the supplied recursive state."; if eq(i, tally(left)) { ok(edges) } else { a0 = take(left, 0, i); b0 = take(right, 0, i); if lt(a0, 0) + gt(a0, nodes - 1) + lt(b0, 0) + gt(b0, nodes - 1) { err({kind: "endpoint", message: "edge endpoint out of range"}) } else { if eq(a0, b0) { u:normalize_from(nodes, left, right, weights, i + 1, edges) } else { a = if lt(a0, b0) { a0 } else { b0 }; b = if lt(a0, b0) { b0 } else { a0 }; u:normalize_from(nodes, left, right, weights, i + 1, u:add_normalized(edges, a, b, take(weights, 0, i))) } } } }
def u:normalize(nodes, left, right, weights) { "Return the normalize result for the supplied nodes, left, right, weights."; if lt(nodes, 0) { err({kind: "shape", message: "invalid node count"}) } else { if eq(tally(left), tally(right)) * eq(tally(left), tally(weights)) { u:normalize_from(nodes, left, right, weights, 0, {left: fill([0], 0), right: fill([0], 0), weights: fill([0], 0)}) } else { err({kind: "shape", message: "edge vectors differ"}) } } }

def u:before(w, a, b, sw, sa, sb) { "Return whether w, a, b, sw, sa, sb satisfy before."; lt(w, sw) + eq(w, sw) * (lt(a, sa) + eq(a, sa) * lt(b, sb)) }
def u:position(sorted, w, a, b, i) { "Return the position result for the supplied sorted, w, a, b, i."; if eq(i, tally(sorted.left)) { i } else { if u:before(w, a, b, take(sorted.weights, 0, i), take(sorted.left, 0, i), take(sorted.right, 0, i)) { i } else { u:position(sorted, w, a, b, i + 1) } } }
def u:insert_edge(sorted, w, a, b) { "Add the supplied item and return the updated structure."; p = u:position(sorted, w, a, b, 0); ids = range(tally(sorted.left)); before = lt(ids, p); after = gt(ids, p) + eq(ids, p); {left: concat(concat(compress(before, sorted.left), a), compress(after, sorted.left)), right: concat(concat(compress(before, sorted.right), b), compress(after, sorted.right)), weights: concat(concat(compress(before, sorted.weights), w), compress(after, sorted.weights))} }
def u:sort_from(edges, i, sorted) { "Sort the supplied values using sort from."; if eq(i, tally(edges.left)) { sorted } else { u:sort_from(edges, i + 1, u:insert_edge(sorted, take(edges.weights, 0, i), take(edges.left, 0, i), take(edges.right, 0, i))) } }
def u:sort_edges(edges) { "Sort the supplied values using sort edges."; u:sort_from(edges, 0, {left: fill([0], 0), right: fill([0], 0), weights: fill([0], 0)}) }
def u:select(edges, i, forest, chosen, total) { "Return the select result for the supplied edges, i, forest, chosen, total."; if eq(i, tally(edges.left)) { ok({left: chosen.left, right: chosen.right, weights: chosen.weights, total: total, components: forest.components, forest: forest}) } else { a = take(edges.left, 0, i); b = take(edges.right, 0, i); joined = u:union(forest, a, b)?; next = if joined.joined { {left: concat(chosen.left, a), right: concat(chosen.right, b), weights: concat(chosen.weights, take(edges.weights, 0, i))} } else { chosen }; u:select(edges, i + 1, joined.forest, next, total + joined.joined * take(edges.weights, 0, i)) } }
def u:kruskal(nodes, left, right, weights) { "Run the kruskal algorithm."; normalized = u:normalize(nodes, left, right, weights)?; sorted = u:sort_edges(normalized); u:select(sorted, 0, u:new_forest(nodes), {left: fill([0], 0), right: fill([0], 0), weights: fill([0], 0)}, 0) }

sites = 6; cable_a = [0, 1, 0, 2, 1, 3, 2, 4, 4, 3]; cable_b = [1, 0, 2, 1, 3, 2, 4, 3, 5, 5]; costs = [4, 7, 3, 1, 2, 4, 6, 5, 2, 8]; plan = unwrap(u:kruskal(sites, cable_a, cable_b, costs));
print("Problem: connect six sites while minimizing total cable cost and avoiding redundant cycles.");
print("Solution: normalize undirected offers, retain the cheapest duplicate, then run deterministic Kruskal.");
{cable_from: plan.left, cable_to: plan.right, edge_costs: plan.weights, total_cost: plan.total, connected_components: plan.components, retained_offer_count: tally(cable_a)}
