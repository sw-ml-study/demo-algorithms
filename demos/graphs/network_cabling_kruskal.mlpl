# Mini-app: connect sites with the least total cable cost.
# data_structure: normalized weighted edge list plus immutable union-find
# algorithm: deterministic insertion sort and Kruskal minimum spanning forest
# representation: parallel numeric vectors; undirected endpoints stored low/high
# dynamic_size: accepted forest and normalized edge vectors grow recursively
# logical_complexity: O(E^2) insertion-sort baseline plus union-find operations
# current_copy_complexity: immutable concat/scatter repeatedly copy vectors
# explicit_loops: 0
# target_loops: 0
# required_features: current
# future_improvement: modules for shared union-find/sort helpers and COW/transients

include "../../src/graphs/network_cabling_kruskal.mlpl";

def u:sort_edges(edges) {
  "Sort the supplied values using sort edges.";
  u:sort_from(edges, 0, {left: fill([0], 0), right: fill([0], 0), weights: fill([0], 0)})
}
sites = 6;
cable_a = [0, 1, 0, 2, 1, 3, 2, 4, 4, 3];
cable_b = [1, 0, 2, 1, 3, 2, 4, 3, 5, 5];
costs = [4, 7, 3, 1, 2, 4, 6, 5, 2, 8];
plan = unwrap(u:kruskal(sites, cable_a, cable_b, costs));
print("Problem: connect six sites while minimizing total cable cost and avoiding redundant cycles.");
print("Solution: normalize undirected offers, retain the cheapest duplicate, then run deterministic Kruskal.");
{cable_from: plan.left, cable_to: plan.right, edge_costs: plan.weights, total_cost: plan.total, connected_components: plan.components, retained_offer_count: tally(cable_a)}
