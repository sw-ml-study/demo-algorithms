def u:nonnegative_readings_from(values, index) { "Validate recursively that every encoded meter reading is nonnegative.";
  if eq(index, tally(values)) { 1 } else {
    if 1 - lt(take(values, 0, index), 0) { u:nonnegative_readings_from(values, index + 1) } else { 0 }
  }
}

def u:validate_meter_data(data) { "Validate the common numeric meter-data envelope used by Bridge implementations.";
  if eq(rank(data.values), 1) * gt(tally(data.values), 0) * gt(data.scale, 0) {
    if u:nonnegative_readings_from(data.values, 0) { ok(data) } else { err({kind: "readings", message: "meter readings must be nonnegative"}) }
  } else { err({kind: "readings", message: "meter data requires a nonempty vector and positive scale"}) }
}

def u:direct_total(values, scale) { "Return the total for direct whole-unit meter readings."; reduce(:add, values) }
def u:direct_peak(values, scale) { "Return the peak for direct whole-unit meter readings."; reduce(:max, values) }
def u:scaled_total(values, scale) { "Decode and total scaled integer meter readings."; reduce(:add, values) / scale }
def u:scaled_peak(values, scale) { "Decode the peak from scaled integer meter readings."; reduce(:max, values) / scale }

def u:energy_usage_summary(data, implementation) { "Compute one usage abstraction through an injected meter implementation protocol.";
  checked = u:validate_meter_data(data)?;
  if eq(checked.encoding, implementation.encoding) {
    total = call(implementation.total, checked.values, checked.scale);
    peak = call(implementation.peak, checked.values, checked.scale);
    if (1 - lt(total, peak)) * (1 - lt(peak, 0)) { ok({total: total, peak: peak, samples: tally(checked.values)}) } else { err({kind: "implementation", message: "meter implementation returned incoherent totals"}) }
  } else { err({kind: "encoding", message: "meter data and implementation encodings differ"}) }
}

def u:energy_budget_status(data, implementation, budget) { "Evaluate a second abstraction through the same injected meter implementation protocol.";
  if 1 - lt(budget, 0) {
    usage = u:energy_usage_summary(data, implementation)?;
    ok({within_budget: 1 - gt(usage.total, budget), remaining: budget - usage.total, total: usage.total})
  } else { err({kind: "budget", message: "energy budget must be nonnegative"}) }
}
