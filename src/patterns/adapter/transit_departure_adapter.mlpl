include "../../graphs/transit_network_representations.mlpl";

def u:adapt_edge_graph_to_route_index(graph) { "Adapt a normalized edge-list graph to the departure consumer's CSR route-index protocol.";
  csr = u:to_csr(graph);
  {stops: csr.vertices, offsets: csr.offsets, destinations: csr.targets, minutes: csr.weights}
}
def u:valid_route_index(routes) { "Return whether a route-index value has consistent CSR protocol shapes.";
  eq(tally(routes.offsets), routes.stops + 1) * eq(tally(routes.destinations), tally(routes.minutes)) * eq(take(routes.offsets, 0, 0), 0) * eq(take(routes.offsets, 0, routes.stops), tally(routes.destinations))
}
def u:route_mask(routes, stop) { "Return the mask selecting one stop's contiguous route-index entries.";
  positions = range(tally(routes.destinations));
  gt(positions, take(routes.offsets, 0, stop) - 1) * lt(positions, take(routes.offsets, 0, stop + 1))
}
def u:departure_summary(routes, stop) { "Consume only the route-index protocol and summarize direct departures from one stop.";
  if lt(stop, 0) + gt(stop, routes.stops - 1) { err({kind: "stop", message: "stop is outside the route index"}) } else {
    mask = u:route_mask(routes, stop); destinations = compress(mask, routes.destinations); minutes = compress(mask, routes.minutes);
    ok({stop: stop, departure_count: tally(destinations), destinations: destinations, minutes: minutes, total_minutes: reduce_add(minutes, 0)})
  }
}
