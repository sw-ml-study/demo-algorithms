def u:base_shipping_quote(request, environment) { "Calculate a base shipping quote through the shared quote protocol.";
  if gt(request.units, 0) * (1 - lt(environment.rate, 0)) {
    ok({amount: request.units * environment.rate, units: request.units, layers: 0, accounting: []})
  } else { err({kind: "quote", message: "positive units and nonnegative rate are required"}) }
}

def u:surcharge_quote(request, environment) { "Decorate an inner quote by delegating first and adding a configured surcharge.";
  inner = call(environment.inner.fn, request, environment.inner.environment)?;
  if 1 - lt(environment.surcharge, 0) {
    ok({amount: inner.amount + environment.surcharge, units: inner.units, layers: inner.layers + 1, accounting: concat(inner.accounting, [10,environment.surcharge])})
  } else { err({kind: "decorator", message: "surcharge must be nonnegative"}) }
}

def u:insurance_quote(request, environment) { "Decorate an inner quote by delegating first and adding per-unit insurance accounting.";
  inner = call(environment.inner.fn, request, environment.inner.environment)?;
  if 1 - lt(environment.per_unit, 0) {
    fee = request.units * environment.per_unit;
    ok({amount: inner.amount + fee, units: inner.units, layers: inner.layers + 1, accounting: concat(inner.accounting, [20,fee])})
  } else { err({kind: "decorator", message: "insurance rate must be nonnegative"}) }
}

def u:run_quote(service, request) { "Invoke any base or decorated quote value through one uniform service protocol.";
  call(service.fn, request, service.environment)
}

def u:inventory_target(request, environment) { "Read a numeric inventory resource through the shared target/proxy protocol.";
  if lt(request.index, 0) + gt(request.index, tally(environment.values) - 1) {
    err({kind: "index", message: "inventory index is outside the resource"})
  } else {
    ok({value: take(environment.values, 0, request.index), state: request.state, effects: [30,request.index]})
  }
}

def u:authorized_inventory_proxy(request, environment) { "Proxy inventory access by checking authorization, delegating, and returning explicit updated state.";
  if eq(request.role, environment.required_role) {
    delegated = call(environment.target.fn, request, environment.target.environment)?;
    ok({value: delegated.value, state: {access_count: request.state.access_count + 1}, effects: concat([40,request.role], delegated.effects)})
  } else { err({kind: "access", message: "role is not authorized for inventory"}) }
}

def u:read_inventory(service, request) { "Invoke either a real inventory target or its access-controlling Proxy through one protocol.";
  call(service.fn, request, service.environment)
}
