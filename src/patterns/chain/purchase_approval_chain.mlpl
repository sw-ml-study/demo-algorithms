def u:team_purchase_handler(request, environment) { "Handle small purchases or delegate unchanged to the next callable handler.";
  if lt(request.amount, 0) { err({kind: "amount", message: "purchase amount must be nonnegative"}) } else {
    if 1 - gt(request.amount, environment.limit) {
      ok({handler_id: environment.handler_id, approved_amount: request.amount, trace: [environment.handler_id], effects: [10,environment.handler_id,request.request_id]})
    } else {
      delegated = call(environment.next.fn, request, environment.next.environment)?;
      ok({handler_id: delegated.handler_id, approved_amount: delegated.approved_amount, trace: concat([environment.handler_id], delegated.trace), effects: delegated.effects})
    }
  }
}

def u:manager_purchase_handler(request, environment) { "Handle medium purchases or delegate unchanged to the terminal handler.";
  if 1 - gt(request.amount, environment.limit) {
    ok({handler_id: environment.handler_id, approved_amount: request.amount, trace: [environment.handler_id], effects: [10,environment.handler_id,request.request_id]})
  } else {
    delegated = call(environment.next.fn, request, environment.next.environment)?;
    ok({handler_id: delegated.handler_id, approved_amount: delegated.approved_amount, trace: concat([environment.handler_id], delegated.trace), effects: delegated.effects})
  }
}

def u:unhandled_purchase_handler(request, environment) { "Terminate the purchase Chain with an ordinary unhandled Result error.";
  err({kind: "unhandled", message: "no purchase handler accepted the request"})
}

def u:request_purchase_approval(chain, request) { "Start a fixed nested Chain of Responsibility through its first handler protocol.";
  call(chain.fn, request, chain.environment)
}
