def u:new_numeric_iterator(values) { "Create an immutable forward iterator over a numeric vector.";
  if eq(rank(values), 1) { ok({collection: values, index: 0}) } else { err({kind: "collection", message: "iterator collection must be a vector"}) }
}
def u:iterator_has_next(iterator) { "Return whether the immutable iterator has another value."; lt(iterator.index, tally(iterator.collection)) }
def u:iterator_next(iterator) { "Return the next value and independently advanced immutable iterator state.";
  if u:iterator_has_next(iterator) { ok({value: take(iterator.collection, 0, iterator.index), iterator: {collection: iterator.collection, index: iterator.index + 1}}) } else { err({kind: "exhausted", message: "iterator has no next value"}) }
}
def u:collect_iterator(iterator, collected) { "Collect all remaining values using only the iterator protocol.";
  if u:iterator_has_next(iterator) { step = u:iterator_next(iterator)?; u:collect_iterator(step.iterator, concat(collected, step.value)) } else { ok({values: collected, iterator: iterator}) }
}
def u:consume_within_budget_from(iterator, budget, total, accepted) { "Consume iterator values in order until the next value would exceed a numeric budget.";
  if u:iterator_has_next(iterator) {
    step = u:iterator_next(iterator)?;
    if gt(total + step.value, budget) { ok({accepted: accepted, total: total, remaining: iterator}) } else { u:consume_within_budget_from(step.iterator, budget, total + step.value, concat(accepted, step.value)) }
  } else { ok({accepted: accepted, total: total, remaining: iterator}) }
}
def u:consume_within_budget(iterator, budget) { "Run the budget consumer through the iterator protocol from its current position.";
  if lt(budget, 0) { err({kind: "budget", message: "budget must be nonnegative"}) } else { u:consume_within_budget_from(iterator, budget, 0, []) }
}
