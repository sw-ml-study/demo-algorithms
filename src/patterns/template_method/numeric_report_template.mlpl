def u:valid_report_values_from(values, index) { "Check recursively that report inputs contain only nonnegative numeric readings.";
  if eq(index, tally(values)) { 1 } else {
    if lt(take(values, 0, index), 0) { 0 } else { u:valid_report_values_from(values, index + 1) }
  }
}

def u:prepare_whole_readings(input) { "Prepare whole-unit readings as stage one of a report workflow.";
  if eq(input.stage, 0) * eq(rank(input.values), 1) * gt(tally(input.values), 0) * u:valid_report_values_from(input.values, 0) {
    ok({stage: 1, values: input.values, source_id: input.source_id})
  } else { err({kind: "prepare", message: "whole readings require a nonempty nonnegative stage-zero vector"}) }
}

def u:prepare_scaled_readings(input) { "Decode positive-scale integer readings as stage one of a report workflow.";
  if eq(input.stage, 0) * eq(rank(input.values), 1) * gt(tally(input.values), 0) * gt(input.scale, 0) * u:valid_report_values_from(input.values, 0) {
    ok({stage: 1, values: input.values / input.scale, source_id: input.source_id})
  } else { err({kind: "prepare", message: "scaled readings require valid data and a positive scale"}) }
}

def u:analyze_total(state) { "Analyze a prepared vector by calculating its total as stage two.";
  if eq(state.stage, 1) { ok({stage: 2, metric: reduce(:add, state.values), samples: tally(state.values), source_id: state.source_id}) } else { err({kind: "order", message: "analysis requires prepared stage one"}) }
}

def u:analyze_peak(state) { "Analyze a prepared vector by calculating its peak as stage two.";
  if eq(state.stage, 1) { ok({stage: 2, metric: reduce(:max, state.values), samples: tally(state.values), source_id: state.source_id}) } else { err({kind: "order", message: "analysis requires prepared stage one"}) }
}

def u:publish_audit_metric(state) { "Publish an analyzed audit metric as a stage-three effect description.";
  if eq(state.stage, 2) { ok({stage: 3, report_kind: 10, metric: state.metric, samples: state.samples, source_id: state.source_id, effects: [10,state.source_id]}) } else { err({kind: "order", message: "publication requires analyzed stage two"}) }
}

def u:publish_capacity_metric(state) { "Publish an analyzed capacity metric as a stage-three effect description.";
  if eq(state.stage, 2) { ok({stage: 3, report_kind: 20, metric: state.metric, samples: state.samples, source_id: state.source_id, effects: [20,state.source_id]}) } else { err({kind: "order", message: "publication requires analyzed stage two"}) }
}

def u:run_numeric_report(input, steps) { "Execute the invariant prepare-analyze-publish Template Method using injected step UDFs.";
  prepared = call(steps.prepare, input)?;
  analyzed = call(steps.analyze, prepared)?;
  published = call(steps.publish, analyzed)?;
  ok({report: published, trace: [prepared.stage, analyzed.stage, published.stage]})
}
