def u:validate_delivery_request(request) { "Validate the delivery subsystem request shape and numeric policy.";
  if gt(request.order_id, 0) * gt(request.units, 0) * (1 - lt(request.distance, 0)) { ok(request) } else { err({kind: "request", message: "order, units, and distance are invalid"}) }
}

def u:price_delivery(request, rates) { "Calculate the delivery subsystem price from unit and distance rates.";
  if (1 - lt(rates.per_unit, 0)) * (1 - lt(rates.per_distance, 0)) {
    ok(request.units * rates.per_unit + request.distance * rates.per_distance)
  } else { err({kind: "rates", message: "delivery rates must be nonnegative"}) }
}

def u:allocate_delivery_vehicle(request, fleet) { "Select a numeric vehicle from the fleet subsystem by required capacity.";
  if eq(rank(fleet.ids), 1) * eq(rank(fleet.capacities), 1) * eq(tally(fleet.ids), tally(fleet.capacities)) * gt(tally(fleet.ids), 0) {
    u:allocate_delivery_vehicle_from(request.units, fleet.ids, fleet.capacities, 0)
  } else { err({kind: "fleet", message: "fleet fields must be nonempty equal-length vectors"}) }
}

def u:allocate_delivery_vehicle_from(units, ids, capacities, index) { "Scan fleet vectors recursively and return the first vehicle with sufficient capacity.";
  if eq(index, tally(ids)) { err({kind: "capacity", message: "no delivery vehicle has enough capacity"}) } else {
    if 1 - lt(take(capacities, 0, index), units) { ok(take(ids, 0, index)) } else { u:allocate_delivery_vehicle_from(units, ids, capacities, index + 1) }
  }
}

def u:book_delivery(request, rates, fleet) { "Provide one simplified Facade over validation, pricing, allocation, and effect description.";
  checked = u:validate_delivery_request(request)?;
  price = u:price_delivery(checked, rates)?;
  vehicle = u:allocate_delivery_vehicle(checked, fleet)?;
  ok({order_id: checked.order_id, price: price, vehicle_id: vehicle, effects: [10,checked.order_id,20,vehicle]})
}
