def u:new_room_plan(capacities) { "Create an originator room-plan state with revision zero.";
  if eq(rank(capacities), 1) { ok({capacities: capacities, revision: 0}) } else { err({kind: "plan", message: "room capacities must be a vector"}) }
}
def u:adjust_room_capacity(plan, room, delta) { "Return a new originator state with one room capacity adjusted.";
  if lt(room, 0) + gt(room, tally(plan.capacities) - 1) { err({kind: "room", message: "room is outside the plan"}) } else {
    next = take(plan.capacities, 0, room) + delta;
    if lt(next, 0) { err({kind: "capacity", message: "room capacity cannot become negative"}) } else { ok({capacities: scatter(plan.capacities, room, next), revision: plan.revision + 1}) }
  }
}
def u:new_plan_history(room_count) { "Create an empty caretaker history for fixed-width room-plan mementos.";
  if lt(room_count, 0) { err({kind: "width", message: "history width must be nonnegative"}) } else { ok({room_count: room_count, count: 0, snapshots: [], revisions: []}) }
}
def u:capture_plan(history, plan) { "Append an opaque numeric memento of the originator state to caretaker history.";
  if eq(tally(plan.capacities), history.room_count) {
    ok({room_count: history.room_count, count: history.count + 1, snapshots: concat(history.snapshots, plan.capacities), revisions: concat(history.revisions, plan.revision)})
  } else { err({kind: "width", message: "plan shape does not match caretaker history"}) }
}
def u:history_prefix(values, count) { "Return the first count vector values for immutable caretaker truncation.";
  compress(lt(range(tally(values)), count), values)
}
def u:restore_plan(history, position) { "Restore one originator state from a zero-based caretaker memento position.";
  if lt(position, 0) + gt(position, history.count - 1) { err({kind: "position", message: "memento position is outside history"}) } else {
    cells = range(tally(history.snapshots)); mask = eq(floor(cells / history.room_count), position);
    ok({capacities: compress(mask, history.snapshots), revision: take(history.revisions, 0, position)})
  }
}
def u:undo_plan(history) { "Pop the latest caretaker memento and return its restored originator state plus remaining history.";
  if eq(history.count, 0) { err({kind: "empty", message: "cannot undo an empty history"}) } else {
    position = history.count - 1; restored = u:restore_plan(history, position)?;
    ok({state: restored, history: {room_count: history.room_count, count: position, snapshots: u:history_prefix(history.snapshots, position * history.room_count), revisions: u:history_prefix(history.revisions, position)}})
  }
}
