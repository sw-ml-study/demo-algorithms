# Shared production definitions for linear search.

def u:linear_search(values, target, index) { "Return the linear search result for the supplied values, target, index.";
  if eq(index, tally(values)) { err({kind: "not-found", message: "absent"}) } else {
    if eq(take(values, 0, index), target) { ok(index) } else {
      u:linear_search(values, target, index + 1)
    }
  }
}

def u:find(values, target) { "Find the requested value or node in the supplied structure."; u:linear_search(values, target, 0) }
