# Deterministic one-shot persistence for records containing semantic Result values.

def u:save_result_json(path, value) { "Encode a Result-bearing value as deterministic JSON and atomically replace its sandboxed file."; text = to_json(value)?; write_atomic(path, text)?; ok(text) }

def u:load_result_json(path, max_depth, max_bytes) { "Decode budgeted JSON with explicit opt-in reconstruction of nested semantic Results."; text = read_text(path)?; parse_json(text, {results: 1, max_depth: max_depth, max_bytes: max_bytes}) }

def u:save_result_toml(path, record) { "Encode a Result-bearing root record as deterministic TOML and atomically replace its sandboxed file."; text = to_toml(record)?; write_atomic(path, text)?; ok(text) }

def u:load_result_toml(path, max_depth, max_bytes) { "Decode budgeted TOML with explicit opt-in reconstruction of nested semantic Results."; text = read_text(path)?; parse_toml(text, {results: 1, max_depth: max_depth, max_bytes: max_bytes}) }
