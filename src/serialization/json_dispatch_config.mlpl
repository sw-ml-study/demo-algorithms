# JSON configuration ingestion for a capacity-limited delivery dispatch.

def u:dispatch_sum(values, index, total) { "Sum a numeric dispatch vector recursively, including the empty-vector case."; if eq(index, tally(values)) { total } else { u:dispatch_sum(values, index + 1, total + take(values, 0, index)) } }

def u:dispatch_plan(config, capacity, reserve, weights) { "Select and summarize the capacity-safe package prefix from a validated dispatch configuration.";
  usable = capacity - reserve;
  cumulative = running_sum(weights);
  accepted_mask = 1 - gt(cumulative, usable);
  accepted = compress(accepted_mask, weights);
  ok({depot_id: config.depot_id, truck_capacity: capacity, reserve_capacity: reserve, usable_capacity: usable, accepted_weights: accepted, accepted_count: tally(accepted), accepted_load: u:dispatch_sum(accepted, 0, 0), deferred_count: tally(weights) - tally(accepted)})
}

def u:dispatch_plan_from_json(text) { "Parse and validate a JSON dispatch configuration, then select its capacity-safe package prefix.";
  config = parse_json(text)?;
  capacity = config.truck_capacity; reserve = config.reserve_capacity; weights = config.package_weights;
  if (1 - eq(rank(capacity), 0)) + (1 - eq(rank(reserve), 0)) + (1 - eq(rank(weights), 1)) {
    err("dispatch config: capacity and reserve must be scalars and package_weights must be a vector")
  } else { if lt(capacity, 0) + lt(reserve, 0) + gt(reserve, capacity) {
    err("dispatch config: capacity and reserve are inconsistent")
  } else { if gt(tally(weights), 0) {
    if lt(reduce(:min, weights), 0) { err("dispatch config: package weights must be nonnegative") } else { u:dispatch_plan(config, capacity, reserve, weights) }
  } else { u:dispatch_plan(config, capacity, reserve, weights) } } }
}
