# Deterministic one-shot JSON file persistence for ordinary MLPL data values.

def u:save_json(path, value) { "Encode an ordinary data value deterministically and save it through sandboxed text I/O."; text = to_json(value); write_text(path, text)?; ok({path: path, utf8_bytes: tally(tokenize_bytes(text)), text: text}) }

def u:load_json(path) { "Read and decode one sandboxed JSON file into a typed MLPL value."; text = read_text(path)?; parse_json(text) }
