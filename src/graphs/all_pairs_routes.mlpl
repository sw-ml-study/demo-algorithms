def u:graph(vertices, sources, targets, weights) {
  "Return the graph result for the supplied vertices, sources, targets, weights.";
  {vertices: vertices, sources: sources, targets: targets, weights: weights, edges: tally(sources)}
}
def u:valid(graph, position) {
  "Check whether graph, position satisfies the valid invariant.";
  if eq(tally(graph.targets), graph.edges) * eq(tally(graph.weights), graph.edges) {
    if eq(position, graph.edges) {
      1
    } else {
      s = take(graph.sources, 0, position);
      t = take(graph.targets, 0, position);
      gt(s, -1) * lt(s, graph.vertices) * gt(t, -1) * lt(t, graph.vertices) * u:valid(graph, position + 1)
    }
  } else {
    0
  }
}
def u:init_diagonal(vertices, node, distances, hops) {
  "Return the init diagonal result for the supplied vertices, node, distances, hops.";
  if eq(node, vertices) {
    {distances: distances, hops: hops}
  } else {
    cell = node * vertices + node;
    u:init_diagonal(vertices, node + 1, scatter(distances, cell, 0), scatter(hops, cell, node))
  }
}
def u:init_edges(graph, edge, matrices) {
  "Return the init edges result for the supplied graph, edge, matrices.";
  if eq(edge, graph.edges) {
    matrices
  } else {
    source = take(graph.sources, 0, edge);
    target = take(graph.targets, 0, edge);
    weight = take(graph.weights, 0, edge);
    cell = source * graph.vertices + target;
    if lt(weight, take(matrices.distances, 0, cell)) { u:init_edges(graph, edge + 1, {distances: scatter(matrices.distances, cell, weight), hops: scatter(matrices.hops, cell, target)}) } else { u:init_edges(graph, edge + 1, matrices) }
  }
}
def u:fw_j(vertices, k, i, j, matrices) {
  "Return the fw j result for the supplied vertices, k, i, j, matrices.";
  if eq(j, vertices) {
    matrices
  } else {
    ij = i * vertices + j;
    ik = i * vertices + k;
    kj = k * vertices + j;
    left = take(matrices.distances, 0, ik);
    right = take(matrices.distances, 0, kj);
    candidate = left + right;
    if lt(left, 1000000000) * lt(right, 1000000000) * lt(candidate, take(matrices.distances, 0, ij)) { u:fw_j(vertices, k, i, j + 1, {distances: scatter(matrices.distances, ij, candidate), hops: scatter(matrices.hops, ij, take(matrices.hops, 0, ik))}) } else { u:fw_j(vertices, k, i, j + 1, matrices) }
  }
}
def u:fw_i(vertices, k, i, matrices) {
  "Return the fw i result for the supplied vertices, k, i, matrices.";
  if eq(i, vertices) {
    matrices
  } else { u:fw_i(vertices, k, i + 1, u:fw_j(vertices, k, i, 0, matrices)) }
}
def u:fw_k(vertices, k, matrices) {
  "Return the fw k result for the supplied vertices, k, matrices.";
  if eq(k, vertices) {
    matrices
  } else { u:fw_k(vertices, k + 1, u:fw_i(vertices, k, 0, matrices)) }
}
def u:floyd(graph) {
  "Run the floyd algorithm.";
  base = u:init_diagonal(graph.vertices, 0, fill([graph.vertices * graph.vertices], 1000000000), fill([graph.vertices * graph.vertices], -1));
  u:fw_k(graph.vertices, 0, u:init_edges(graph, 0, base))
}
def u:has_negative_cycle(result, vertices, node) {
  "Return whether result, vertices, node satisfy has negative cycle.";
  if eq(node, vertices) {
    0
  } else {
    lt(take(result.distances, 0, node * vertices + node), 0) + u:has_negative_cycle(result, vertices, node + 1)
  }
}
def u:path_steps(result, vertices, current, target, steps) {
  "Continue path from the supplied recursive state.";
  if eq(current, target) {
    reshape(target, [1])
  } else {
    if eq(steps, vertices) {
      fill([0], 0)
    } else {
      next_hop = take(result.hops, 0, current * vertices + target);
      if eq(next_hop, -1) {
        fill([0], 0)
      } else {
        concat(reshape(current, [1]), u:path_steps(result, vertices, next_hop, target, steps + 1))
      }
    }
  }
}
def u:path(result, vertices, source, target) {
  "Return the path result for the supplied result, vertices, source, target.";
  u:path_steps(result, vertices, source, target, 0)
}
