def u:tsp_distance(matrix, vertices, source, target) { "Read one directed distance from a flat row-major TSP matrix."; take(matrix, 0, source * vertices + target) }
def u:tsp_valid_matrix(matrix, vertices) { "Validate the rank and square size of a numeric TSP distance matrix."; gt(vertices, 0) * eq(rank(matrix), 1) * eq(tally(matrix), vertices * vertices) }
def u:tsp_exact_candidates(matrix, vertices, start, current, visited, route, cost, depth, candidate, best) { "Enumerate deterministic next-city candidates for exact TSP backtracking.";
  if eq(candidate, vertices) { best } else {
    edge = u:tsp_distance(matrix, vertices, current, candidate);
    next_best = if eq(take(visited, 0, candidate), 0) * (1 - lt(edge, 0)) * (eq(best.found, 0) + lt(cost + edge, best.cost)) {
      u:tsp_exact_search(matrix, vertices, start, candidate, scatter(visited, candidate, 1), concat(route, candidate), cost + edge, depth + 1, best)
    } else { best };
    u:tsp_exact_candidates(matrix, vertices, start, current, visited, route, cost, depth, candidate + 1, next_best)
  }
}
def u:tsp_exact_search(matrix, vertices, start, current, visited, route, cost, depth, best) { "Search all remaining TSP permutations and retain the first minimum-cost closed tour.";
  if eq(depth, vertices) {
    closing = u:tsp_distance(matrix, vertices, current, start);
    if 1 - lt(closing, 0) {
      total = cost + closing;
      if eq(best.found, 0) + lt(total, best.cost) { {found: 1, cost: total, tour: concat(route, start)} } else { best }
    } else { best }
  } else { u:tsp_exact_candidates(matrix, vertices, start, current, visited, route, cost, depth, 0, best) }
}
def u:tsp_exact(matrix, vertices, start) { "Solve a small fixed-start Traveling Salesman Problem by factorial backtracking.";
  if eq(u:tsp_valid_matrix(matrix, vertices), 0) + lt(start, 0) + gt(start, vertices - 1) { err({kind: "tsp", message: "invalid matrix, vertex count, or start"}) } else {
    result = u:tsp_exact_search(matrix, vertices, start, start, scatter(fill([vertices], 0), start, 1), reshape(start, [1]), 0, 1, {found: 0, cost: 1000000000, tour: fill([0], 0)});
    if result.found { ok(result) } else { err({kind: "tour", message: "no closed tour exists"}) }
  }
}
def u:tsp_nearest_choice(matrix, vertices, current, visited, candidate, best_node, best_cost) { "Choose the nearest unvisited city with lowest-node deterministic ties.";
  if eq(candidate, vertices) { {node: best_node, cost: best_cost} } else {
    edge = u:tsp_distance(matrix, vertices, current, candidate);
    if eq(take(visited, 0, candidate), 0) * (1 - lt(edge, 0)) * lt(edge, best_cost) {
      u:tsp_nearest_choice(matrix, vertices, current, visited, candidate + 1, candidate, edge)
    } else { u:tsp_nearest_choice(matrix, vertices, current, visited, candidate + 1, best_node, best_cost) }
  }
}
def u:tsp_nearest_steps(matrix, vertices, start, current, visited, route, cost, depth) { "Construct a nearest-neighbor tour recursively from a fixed start.";
  if eq(depth, vertices) {
    closing = u:tsp_distance(matrix, vertices, current, start);
    if lt(closing, 0) { err({kind: "tour", message: "nearest route cannot close"}) } else { ok({cost: cost + closing, tour: concat(route, start)}) }
  } else {
    choice = u:tsp_nearest_choice(matrix, vertices, current, visited, 0, -1, 1000000000);
    if eq(choice.node, -1) { err({kind: "tour", message: "nearest route is disconnected"}) } else { u:tsp_nearest_steps(matrix, vertices, start, choice.node, scatter(visited, choice.node, 1), concat(route, choice.node), cost + choice.cost, depth + 1) }
  }
}
def u:tsp_nearest(matrix, vertices, start) { "Build a deterministic nearest-neighbor TSP tour for heuristic comparison.";
  if eq(u:tsp_valid_matrix(matrix, vertices), 0) + lt(start, 0) + gt(start, vertices - 1) { err({kind: "tsp", message: "invalid matrix, vertex count, or start"}) } else { u:tsp_nearest_steps(matrix, vertices, start, start, scatter(fill([vertices], 0), start, 1), reshape(start, [1]), 0, 1) }
}
