def u:new_graph(vertices, payloads) {
  "Create an empty graph value.";
  {vertices: vertices, payloads: payloads, sources: fill([0], 0), targets: fill([0], 0), weights: fill([0], 0), edges: 0}
}
def u:find_pair(graph, source, target, position) {
  "Find pair in the supplied structure.";
  if eq(position, graph.edges) {
    -1
  } else {
    if eq(take(graph.sources, 0, position), source) * eq(take(graph.targets, 0, position), target) {
      position
    } else { u:find_pair(graph, source, target, position + 1) }
  }
}
def u:add_edge(graph, source, target, weight) {
  "Add the supplied item and return the updated structure.";
  if lt(source, 0) + lt(target, 0) + gt(source, graph.vertices - 1) + gt(target, graph.vertices - 1) {
    err({kind: "endpoint", message: "range"})
  } else {
    existing = u:find_pair(graph, source, target, 0);
    if gt(existing, -1) {
      ok({vertices: graph.vertices, payloads: graph.payloads, sources: graph.sources, targets: graph.targets, weights: scatter(graph.weights, existing, weight), edges: graph.edges})
    } else {
      ok({vertices: graph.vertices, payloads: graph.payloads, sources: concat(graph.sources, source), targets: concat(graph.targets, target), weights: concat(graph.weights, weight), edges: graph.edges + 1})
    }
  }
}
def u:matrix_from(graph, position, present, weights) {
  "Convert the supplied representation using matrix from.";
  if eq(position, graph.edges) {
    {vertices: graph.vertices, present: present, weights: weights}
  } else {
    cell = take(graph.sources, 0, position) * graph.vertices + take(graph.targets, 0, position);
    u:matrix_from(graph, position + 1, scatter(present, cell, 1), scatter(weights, cell, take(graph.weights, 0, position)))
  }
}
def u:to_matrix(graph) {
  "Convert the supplied representation using to matrix.";
  u:matrix_from(graph, 0, fill([graph.vertices * graph.vertices], 0), fill([graph.vertices * graph.vertices], 0))
}
def u:csr_edges(graph, vertex, position, offsets, targets, weights) {
  "Convert the supplied representation using csr edges.";
  if eq(vertex, graph.vertices) {
    {vertices: graph.vertices, offsets: offsets, targets: targets, weights: weights}
  } else {
    if eq(position, graph.edges) { u:csr_edges(graph, vertex + 1, 0, concat(offsets, tally(targets)), targets, weights) } else {
      if eq(take(graph.sources, 0, position), vertex) { u:csr_edges(graph, vertex, position + 1, offsets, concat(targets, take(graph.targets, 0, position)), concat(weights, take(graph.weights, 0, position))) } else { u:csr_edges(graph, vertex, position + 1, offsets, targets, weights) }
    }
  }
}
def u:to_csr(graph) {
  "Convert the supplied representation using to csr.";
  u:csr_edges(graph, 0, 0, [0], fill([0], 0), fill([0], 0))
}
def u:matrix_neighbors(matrix, source) {
  "Continue matrix from the supplied recursive state.";
  positions = range(matrix.vertices * matrix.vertices);
  row = compress(eq(floor(positions / matrix.vertices), source), matrix.present);
  compress(row, range(matrix.vertices))
}
def u:csr_neighbors(csr, source) {
  "Convert the supplied representation using csr neighbors.";
  positions = range(tally(csr.targets));
  mask = gt(positions, take(csr.offsets, 0, source) - 1) * lt(positions, take(csr.offsets, 0, source + 1));
  compress(mask, csr.targets)
}
def u:valid_graph(graph) {
  "Check whether graph satisfies the valid graph invariant.";
  eq(tally(graph.payloads), graph.vertices) * eq(tally(graph.sources), graph.edges) * eq(tally(graph.targets), graph.edges) * eq(tally(graph.weights), graph.edges)
}
