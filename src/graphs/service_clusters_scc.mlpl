def u:graph(vertices, sources, targets) {
  "Return the graph result for the supplied vertices, sources, targets.";
  {vertices: vertices, sources: sources, targets: targets, edges: tally(sources)}
}
def u:valid(graph, position) {
  "Check whether graph, position satisfies the valid invariant.";
  if eq(tally(graph.targets), graph.edges) {
    if eq(position, graph.edges) {
      1
    } else {
      s = take(graph.sources, 0, position);
      t = take(graph.targets, 0, position);
      gt(s, -1) * lt(s, graph.vertices) * gt(t, -1) * lt(t, graph.vertices) * u:valid(graph, position + 1)
    }
  } else {
    0
  }
}
def u:matrix_add(graph, position, present, reversed_flag) {
  "Return the matrix add result for the supplied graph, position, present, reversed_flag.";
  if eq(position, graph.edges) {
    {vertices: graph.vertices, present: present}
  } else {
    source = if reversed_flag {
      take(graph.targets, 0, position)
    } else {
      take(graph.sources, 0, position)
    };
    target = if reversed_flag {
      take(graph.sources, 0, position)
    } else {
      take(graph.targets, 0, position)
    };
    u:matrix_add(graph, position + 1, scatter(present, source * graph.vertices + target, 1), reversed_flag)
  }
}
def u:matrix(graph, reversed_flag) {
  "Return the matrix result for the supplied graph, reversed_flag.";
  u:matrix_add(graph, 0, fill([graph.vertices * graph.vertices], 0), reversed_flag)
}
def u:neighbors(matrix, source) {
  "Return the neighbors result for the supplied matrix, source.";
  positions = range(matrix.vertices * matrix.vertices);
  row = compress(eq(floor(positions / matrix.vertices), source), matrix.present);
  compress(row, range(matrix.vertices))
}
def u:finish_neighbors(matrix, nodes, position, traversal) {
  "Continue finish from the supplied recursive state.";
  if eq(position, tally(nodes)) {
    traversal
  } else {
    next_state = u:finish_node(matrix, take(nodes, 0, position), traversal);
    u:finish_neighbors(matrix, nodes, position + 1, next_state)
  }
}
def u:finish_node(matrix, node, traversal) {
  "Continue finish from the supplied recursive state.";
  if eq(take(traversal.visited, 0, node), 1) {
    traversal
  } else {
    entered = {visited: scatter(traversal.visited, node, 1), order: traversal.order};
    explored = u:finish_neighbors(matrix, u:neighbors(matrix, node), 0, entered);
    {visited: explored.visited, order: concat(explored.order, node)}
  }
}
def u:finish_scan(matrix, node, traversal) {
  "Continue finish from the supplied recursive state.";
  if eq(node, matrix.vertices) {
    traversal
  } else { u:finish_scan(matrix, node + 1, u:finish_node(matrix, node, traversal)) }
}
def u:reverse_from(values, position) {
  "Continue reverse from the supplied recursive state.";
  if lt(position, 0) {
    fill([0], 0)
  } else {
    concat(take(values, 0, position), u:reverse_from(values, position - 1))
  }
}
def u:assign_neighbors(matrix, nodes, position, component, labels) {
  "Continue assign from the supplied recursive state.";
  if eq(position, tally(nodes)) {
    labels
  } else {
    next_labels = u:assign_node(matrix, take(nodes, 0, position), component, labels);
    u:assign_neighbors(matrix, nodes, position + 1, component, next_labels)
  }
}
def u:assign_node(matrix, node, component, labels) {
  "Continue assign from the supplied recursive state.";
  if gt(take(labels, 0, node), -1) {
    labels
  } else { u:assign_neighbors(matrix, u:neighbors(matrix, node), 0, component, scatter(labels, node, component)) }
}
def u:assign_order(matrix, order, position, component, labels) {
  "Return the assign order result for the supplied matrix, order, position, component, labels.";
  if eq(position, tally(order)) {
    {labels: labels, components: component}
  } else {
    node = take(order, 0, position);
    if gt(take(labels, 0, node), -1) { u:assign_order(matrix, order, position + 1, component, labels) } else { u:assign_order(matrix, order, position + 1, component + 1, u:assign_node(matrix, node, component, labels)) }
  }
}
def u:scc(graph) {
  "Run the scc algorithm.";
  finished = u:finish_scan(u:matrix(graph, 0), 0, {visited: fill([graph.vertices], 0), order: fill([0], 0)});
  u:assign_order(u:matrix(graph, 1), u:reverse_from(finished.order, tally(finished.order) - 1), 0, 0, fill([graph.vertices], -1))
}
def u:same(labels, a, b) {
  "Return whether labels, a, b satisfy same.";
  eq(take(labels, 0, a), take(labels, 0, b))
}
