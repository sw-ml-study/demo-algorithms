def u:graph(vertices, sources, targets, weights) { "Return the graph result for the supplied vertices, sources, targets, weights."; {vertices: vertices, sources: sources, targets: targets, weights: weights, edges: tally(sources)} }
def u:valid(graph, position) { "Check whether graph, position satisfies the valid invariant."; if eq(tally(graph.targets), graph.edges) * eq(tally(graph.weights), graph.edges) { if eq(position, graph.edges) { 1 } else { s = take(graph.sources, 0, position); t = take(graph.targets, 0, position); gt(s, -1) * lt(s, graph.vertices) * gt(t, -1) * lt(t, graph.vertices) * u:valid(graph, position + 1) } } else { 0 } }
def u:has_negative(graph, position) { "Return whether graph, position satisfy has negative."; if eq(position, graph.edges) { 0 } else { lt(take(graph.weights, 0, position), 0) + u:has_negative(graph, position + 1) } }
def u:select_min(distances, visited, position, best_node, best_distance) { "Return the select min result for the supplied distances, visited, position, best_node, best_distance."; if eq(position, tally(distances)) { best_node } else { candidate = take(distances, 0, position); if eq(take(visited, 0, position), 0) * lt(candidate, best_distance) { u:select_min(distances, visited, position + 1, position, candidate) } else { u:select_min(distances, visited, position + 1, best_node, best_distance) } } }
def u:relax_from(graph, node, edge, distances, predecessors) { "Continue relax from the supplied recursive state."; if eq(edge, graph.edges) { {distances: distances, predecessors: predecessors} } else { if eq(take(graph.sources, 0, edge), node) { target = take(graph.targets, 0, edge); candidate = take(distances, 0, node) + take(graph.weights, 0, edge); if lt(candidate, take(distances, 0, target)) { u:relax_from(graph, node, edge + 1, scatter(distances, target, candidate), scatter(predecessors, target, node)) } else { u:relax_from(graph, node, edge + 1, distances, predecessors) } } else { u:relax_from(graph, node, edge + 1, distances, predecessors) } } }
def u:dijkstra_rounds(graph, round, distances, predecessors, visited) { "Continue dijkstra from the supplied recursive state."; if eq(round, graph.vertices) { {distances: distances, predecessors: predecessors} } else { node = u:select_min(distances, visited, 0, -1, 1000000001); if eq(node, -1) { {distances: distances, predecessors: predecessors} } else { relaxed = u:relax_from(graph, node, 0, distances, predecessors); u:dijkstra_rounds(graph, round + 1, relaxed.distances, relaxed.predecessors, scatter(visited, node, 1)) } } }
def u:dijkstra(graph, source) { "Run the dijkstra algorithm."; if u:has_negative(graph, 0) { err({kind: "weight", message: "negative"}) } else { if lt(source, 0) + gt(source, graph.vertices - 1) { err({kind: "source", message: "invalid"}) } else { ok(u:dijkstra_rounds(graph, 0, scatter(fill([graph.vertices], 1000000000), source, 0), fill([graph.vertices], -1), fill([graph.vertices], 0))) } } }
def u:relax_all(graph, edge, distances, predecessors, changed) { "Continue relax from the supplied recursive state."; if eq(edge, graph.edges) { {distances: distances, predecessors: predecessors, changed: changed} } else { source = take(graph.sources, 0, edge); target = take(graph.targets, 0, edge); candidate = take(distances, 0, source) + take(graph.weights, 0, edge); if lt(take(distances, 0, source), 1000000000) * lt(candidate, take(distances, 0, target)) { u:relax_all(graph, edge + 1, scatter(distances, target, candidate), scatter(predecessors, target, source), 1) } else { u:relax_all(graph, edge + 1, distances, predecessors, changed) } } }
def u:bellman_passes(graph, pass, distances, predecessors) { "Continue bellman from the supplied recursive state."; if eq(pass, graph.vertices - 1) { {distances: distances, predecessors: predecessors} } else { relaxed = u:relax_all(graph, 0, distances, predecessors, 0); if relaxed.changed { u:bellman_passes(graph, pass + 1, relaxed.distances, relaxed.predecessors) } else { {distances: relaxed.distances, predecessors: relaxed.predecessors} } } }
def u:bellman_ford(graph, source) { "Run the bellman ford algorithm."; if lt(source, 0) + gt(source, graph.vertices - 1) { err({kind: "source", message: "invalid"}) } else { result = u:bellman_passes(graph, 0, scatter(fill([graph.vertices], 1000000000), source, 0), fill([graph.vertices], -1)); check = u:relax_all(graph, 0, result.distances, result.predecessors, 0); if check.changed { err({kind: "cycle", message: "negative cycle"}) } else { ok(result) } } }
def u:path_back(predecessors, source, node, steps) { "Return the path back result for the supplied predecessors, source, node, steps."; if eq(node, source) { reshape(source, [1]) } else { if eq(node, -1) + eq(steps, tally(predecessors)) { fill([0], 0) } else { concat(u:path_back(predecessors, source, take(predecessors, 0, node), steps + 1), node) } } }
def u:path(result, source, target) { "Return the path result for the supplied result, source, target."; if gt(take(result.distances, 0, target), 999999999) { fill([0], 0) } else { u:path_back(result.predecessors, source, target, 0) } }
