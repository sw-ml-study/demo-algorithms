def u:valid_coins(coins, i) { "Check whether coins, i satisfies the valid coins invariant."; if eq(i, tally(coins)) { 1 } else { coin = take(coins, 0, i); gt(coin, 0) * eq(coin, floor(coin)) * u:valid_coins(coins, i + 1) } }
def u:best_coin(coins, amount, counts, i, best_count, best_coin) { "Return the best coin result for the supplied coins, amount, counts, i, best_count, best_coin."; if eq(i, tally(coins)) { {count: best_count, coin: best_coin} } else { coin = take(coins, 0, i); usable = lt(coin, amount) + eq(coin, amount); prior = if usable { take(counts, 0, amount - coin) } else { 1000000000 }; candidate = prior + 1; better = lt(candidate, best_count) + eq(candidate, best_count) * (eq(best_coin, -1) + lt(coin, best_coin)); if usable * lt(prior, 1000000000) * better { u:best_coin(coins, amount, counts, i + 1, candidate, coin) } else { u:best_coin(coins, amount, counts, i + 1, best_count, best_coin) } } }
def u:build_change(coins, target, amount, counts, choices) { "Build change from the supplied state."; if gt(amount, target) { {counts: counts, choices: choices} } else { best = u:best_coin(coins, amount, counts, 0, 1000000000, -1); u:build_change(coins, target, amount + 1, concat(counts, best.count), concat(choices, best.coin)) } }
def u:recover_change(choices, remaining, selected) { "Reconstruct change from the recorded decisions."; if eq(remaining, 0) { ok(selected) } else { coin = take(choices, 0, remaining); if eq(coin, -1) { err({kind: "impossible", message: "target cannot be made"}) } else { u:recover_change(choices, remaining - coin, concat(selected, coin)) } } }
def u:coin_change(coins, target) { "Run the coin change algorithm."; if lt(target, 0) { err({kind: "target", message: "negative"}) } else { if eq(target, floor(target)) { if u:valid_coins(coins, 0) { table = u:build_change(coins, target, 1, [0], [-1]); count = take(table.counts, 0, target); if eq(count, 1000000000) { ok({possible: 0, count: -1, coins: fill([0], 0)}) } else { picked = u:recover_change(table.choices, target, fill([0], 0))?; ok({possible: 1, count: count, coins: picked}) } } else { err({kind: "denomination", message: "positive integer"}) } } else { err({kind: "target", message: "integer"}) } } }

def u:valid_weights(weights, i) { "Check whether weights, i satisfies the valid weights invariant."; if eq(i, tally(weights)) { 1 } else { weight = take(weights, 0, i); gt(weight, 0) * eq(weight, floor(weight)) * u:valid_weights(weights, i + 1) } }
def u:build_row(weight, value, previous, capacity, current, row, choices) { "Build row from the supplied state."; if gt(current, capacity) { {row: row, choices: choices} } else { exclude = take(previous, 0, current); fits = lt(weight, current) + eq(weight, current); include = if fits { take(previous, 0, current - weight) + value } else { -1000000000 }; take_item = fits * gt(include, exclude); best = if take_item { include } else { exclude }; u:build_row(weight, value, previous, capacity, current + 1, concat(row, best), concat(choices, take_item)) } }
def u:build_items(weights, values, capacity, item, previous, decisions) { "Build items from the supplied state."; if eq(item, tally(weights)) { {values: previous, decisions: decisions} } else { next = u:build_row(take(weights, 0, item), take(values, 0, item), previous, capacity, 0, fill([0], 0), fill([0], 0)); u:build_items(weights, values, capacity, item + 1, next.row, concat(decisions, next.choices)) } }
def u:recover_items(weights, decisions, width, item, remaining, selected) { "Reconstruct items from the recorded decisions."; if eq(item, 0) { selected } else { chosen = take(decisions, 0, item * width + remaining); if chosen { u:recover_items(weights, decisions, width, item - 1, remaining - take(weights, 0, item - 1), concat(item - 1, selected)) } else { u:recover_items(weights, decisions, width, item - 1, remaining, selected) } } }
def u:knapsack(weights, values, capacity) { "Run the knapsack algorithm."; if lt(capacity, 0) { err({kind: "capacity", message: "negative"}) } else { if eq(capacity, floor(capacity)) { if eq(tally(weights), tally(values)) { if u:valid_weights(weights, 0) { width = capacity + 1; built = u:build_items(weights, values, capacity, 0, fill([width], 0), fill([width], 0)); ok({value: take(built.values, 0, capacity), item_ids: u:recover_items(weights, built.decisions, width, tally(weights), capacity, fill([0], 0))}) } else { err({kind: "weight", message: "positive integer"}) } } else { err({kind: "shape", message: "vectors"}) } } else { err({kind: "capacity", message: "integer"}) } } }
