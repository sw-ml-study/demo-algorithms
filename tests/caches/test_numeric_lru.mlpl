def u:new_cache(capacity) { "Create an empty cache value."; {keys: fill([0], 0), values: fill([0], 0), previous: fill([0], 0), next_handles: fill([0], 0), active: fill([0], 0), head: -1, tail: -1, size: 0, nodes: 0, capacity: capacity} }
def u:find_from(cache, key, position) { "Find from in the supplied structure."; if eq(position, cache.nodes) { -1 } else { if eq(take(cache.active, 0, position), 1) * eq(take(cache.keys, 0, position), key) { position } else { u:find_from(cache, key, position + 1) } } }
def u:find(cache, key) { "Find the requested value or node in the supplied structure."; u:find_from(cache, key, 0) }
def u:detach(cache, node) { "Remove the supplied item and return the updated structure."; before = take(cache.previous, 0, node); after = take(cache.next_handles, 0, node); new_previous = if eq(after, -1) { cache.previous } else { scatter(cache.previous, after, before) }; new_next = if eq(before, -1) { cache.next_handles } else { scatter(cache.next_handles, before, after) }; {keys: cache.keys, values: cache.values, previous: scatter(new_previous, node, -1), next_handles: scatter(new_next, node, -1), active: cache.active, head: if eq(cache.head, node) { after } else { cache.head }, tail: if eq(cache.tail, node) { before } else { cache.tail }, size: cache.size, nodes: cache.nodes, capacity: cache.capacity} }
def u:attach_front(cache, node) { "Add an item at the front and return the updated structure."; linked_previous = if eq(cache.head, -1) { cache.previous } else { scatter(cache.previous, cache.head, node) }; {keys: cache.keys, values: cache.values, previous: scatter(linked_previous, node, -1), next_handles: scatter(cache.next_handles, node, cache.head), active: cache.active, head: node, tail: if eq(cache.tail, -1) { node } else { cache.tail }, size: cache.size, nodes: cache.nodes, capacity: cache.capacity} }
def u:promote(cache, node) { "Return the promote result for the supplied cache, node."; if eq(cache.head, node) { cache } else { u:attach_front(u:detach(cache, node), node) } }
def u:retire_tail(cache) { "Remove the supplied item and return the updated structure."; victim = cache.tail; detached_cache = u:detach(cache, victim); {keys: detached_cache.keys, values: detached_cache.values, previous: detached_cache.previous, next_handles: detached_cache.next_handles, active: scatter(detached_cache.active, victim, 0), head: detached_cache.head, tail: detached_cache.tail, size: cache.size - 1, nodes: cache.nodes, capacity: cache.capacity} }
def u:append_front(cache, key, value) { "Add an item at the front and return the updated structure."; node = cache.nodes; extended = {keys: concat(cache.keys, key), values: concat(cache.values, value), previous: concat(cache.previous, -1), next_handles: concat(cache.next_handles, -1), active: concat(cache.active, 1), head: cache.head, tail: cache.tail, size: cache.size + 1, nodes: node + 1, capacity: cache.capacity}; u:attach_front(extended, node) }
def u:put(cache, key, value) { "Add the supplied item and return the updated structure."; node = u:find(cache, key); if gt(node, -1) { u:promote({keys: cache.keys, values: scatter(cache.values, node, value), previous: cache.previous, next_handles: cache.next_handles, active: cache.active, head: cache.head, tail: cache.tail, size: cache.size, nodes: cache.nodes, capacity: cache.capacity}, node) } else { base_cache = if eq(cache.size, cache.capacity) { u:retire_tail(cache) } else { cache }; u:append_front(base_cache, key, value) } }
def u:access(cache, key) { "Find the requested value or node in the supplied structure."; node = u:find(cache, key); if eq(node, -1) { err({kind: "missing", message: "absent"}) } else { ok({cache: u:promote(cache, node), value: take(cache.values, 0, node)}) } }
def u:walk_keys(cache, handle, reverse, remaining) { "Traverse the supplied structure in walk keys order."; if eq(handle, -1) + eq(remaining, 0) { fill([0], 0) } else { next_handle = if reverse { take(cache.previous, 0, handle) } else { take(cache.next_handles, 0, handle) }; concat(take(cache.keys, 0, handle), u:walk_keys(cache, next_handle, reverse, remaining - 1)) } }
def u:forward(cache) { "Return the forward result for the supplied cache."; u:walk_keys(cache, cache.head, 0, cache.size) }
def u:reverse(cache) { "Return the reverse result for the supplied cache."; u:walk_keys(cache, cache.tail, 1, cache.size) }
def u:count(flags, wanted, position) { "Return the count result for the supplied flags, wanted, position."; if eq(position, tally(flags)) { 0 } else { eq(take(flags, 0, position), wanted) + u:count(flags, wanted, position + 1) } }
def u:chain_ok(cache, handle, expected, reverse, steps) { "Check whether cache, handle, expected, reverse, steps satisfies the chain ok invariant."; if eq(handle, -1) { eq(steps, cache.size) } else { if eq(steps, cache.size) { 0 } else { if lt(handle, 0) + gt(handle, cache.nodes - 1) { 0 } else { link = if reverse { take(cache.next_handles, 0, handle) } else { take(cache.previous, 0, handle) }; next_handle = if reverse { take(cache.previous, 0, handle) } else { take(cache.next_handles, 0, handle) }; eq(take(cache.active, 0, handle), 1) * eq(link, expected) * u:chain_ok(cache, next_handle, handle, reverse, steps + 1) } } } }
def u:valid(cache) { "Check whether cache satisfies the valid invariant."; shapes = eq(tally(cache.keys), cache.nodes) * eq(tally(cache.values), cache.nodes) * eq(tally(cache.previous), cache.nodes) * eq(tally(cache.next_handles), cache.nodes) * eq(tally(cache.active), cache.nodes); if shapes { eq(u:count(cache.active, 1, 0), cache.size) * u:chain_ok(cache, cache.head, -1, 0, 0) * u:chain_ok(cache, cache.tail, -1, 1, 0) } else { 0 } }

def u:test() { "Run this script's conformance assertions.";
  empty_cache = u:new_cache(3); u:assert_err(u:access(empty_cache, 1), "empty access should miss")?;
  one = u:put(empty_cache, 1, 10); two = u:put(one, 2, 0); three = u:put(two, -3, -30);
  u:assert_eq(u:forward(three), [-3, 2, 1], "front insertion order failed")?;
  u:assert_eq(u:reverse(three), [1, 2, -3], "reverse traversal failed")?;
  middle_hit = u:access(three, 2)?;
  u:assert_eq(middle_hit.value, 0, "stored zero access failed")?;
  u:assert_eq(u:forward(middle_hit.cache), [2, -3, 1], "middle promotion failed")?;
  tail_hit = u:access(middle_hit.cache, 1)?;
  u:assert_eq(u:forward(tail_hit.cache), [1, 2, -3], "tail promotion failed")?;
  head_hit = u:access(tail_hit.cache, 1)?;
  u:assert_eq(u:forward(head_hit.cache), [1, 2, -3], "head promotion changed order")?;
  revised_cache = u:put(head_hit.cache, 2, 22);
  u:assert_eq(revised_cache.size, 3, "duplicate update grew cache")?;
  u:assert_eq(u:forward(revised_cache), [2, 1, -3], "update did not promote")?;
  evicting_cache = u:put(revised_cache, 4, 40);
  u:assert_err(u:access(evicting_cache, -3), "least recent key was not evicted")?;
  u:assert_eq(u:forward(evicting_cache), [4, 2, 1], "eviction order failed")?;
  u:assert_eq(u:find(evicting_cache, 4), evicting_cache.head, "lookup/list disagreement")?;
  u:assert_eq(u:forward(three), [-3, 2, 1], "later operations mutated retained version")?;
  single1 = u:put(u:new_cache(1), 7, 70); single2 = u:put(single1, 8, 80);
  u:assert_eq(u:forward(single2), [8], "capacity-one eviction failed")?;
  u:assert_err(u:access(single2, 7), "capacity-one retained victim")?;
  u:assert_true(u:valid(evicting_cache), "valid cache failed invariant")?;
  cycle_cache = {keys: evicting_cache.keys, values: evicting_cache.values, previous: evicting_cache.previous, next_handles: scatter(evicting_cache.next_handles, evicting_cache.head, evicting_cache.head), active: evicting_cache.active, head: evicting_cache.head, tail: evicting_cache.tail, size: evicting_cache.size, nodes: evicting_cache.nodes, capacity: evicting_cache.capacity};
  u:assert_false(u:valid(cycle_cache), "cycle passed validation")?;
  bad_handle_cache = {keys: evicting_cache.keys, values: evicting_cache.values, previous: evicting_cache.previous, next_handles: evicting_cache.next_handles, active: evicting_cache.active, head: 999, tail: evicting_cache.tail, size: evicting_cache.size, nodes: evicting_cache.nodes, capacity: evicting_cache.capacity};
  u:assert_false(u:valid(bad_handle_cache), "invalid handle passed validation")?;
  ok({test: "numeric-lru", cases: 19})
}
u:test()
