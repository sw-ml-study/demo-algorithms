

include "src/sorts/insertion_sort.mlpl";

@test {name: "insertion sort contract", tags: ["insertion", "unit", "native"]}
def u:test_contract() { "Run this script's conformance assertions.";
  empty = u:sort(fill([0], 0), fill([0], 0));
  u:assert_eq(empty.keys, fill([0], 0), "empty sort failed")?;

  singleton = u:sort([7], [100]);
  u:assert_eq(singleton.keys, [7], "singleton keys failed")?;
  u:assert_eq(singleton.ids, [100], "singleton payload failed")?;

  sorted = u:sort([1, 2, 3, 4], [10, 20, 30, 40]);
  u:assert_eq(sorted.keys, [1, 2, 3, 4], "already-sorted input changed order")?;
  u:assert_eq(sorted.ids, [10, 20, 30, 40], "already-sorted payload changed order")?;

  reversed = u:sort([4, 3, 2, 1], [40, 30, 20, 10]);
  u:assert_eq(reversed.keys, [1, 2, 3, 4], "reverse-sorted keys failed")?;
  u:assert_eq(reversed.ids, [10, 20, 30, 40], "reverse-sorted payload failed")?;

  stable = u:sort([2, 1, 2, 1, 2], [101, 102, 103, 104, 105]);
  u:assert_eq(stable.keys, [1, 1, 2, 2, 2], "duplicate keys failed")?;
  u:assert_eq(stable.ids, [102, 104, 101, 103, 105], "equal keys lost arrival stability")?;

  negative = u:sort([-2, 4, -9, 0], [1, 2, 3, 4]);
  u:assert_eq(negative.keys, [-9, -2, 0, 4], "negative keys failed")?;
  u:assert_eq(negative.ids, [3, 1, 4, 2], "negative payload alignment failed")?;
  ok({test: "stable-insertion-sort", cases: 11})
}


u:run_registered_tests()
