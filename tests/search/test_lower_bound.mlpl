

include "src/search/lower_bound.mlpl";

@test {name: "lower bound boundary policy", tags: ["search", "unit", "boundary"]}
def u:test_contract() {
  "Verify empty, singleton, negative, and past-end lower-bound policies.";
  u:assert_eq(u:bound(fill([0], 0), 5), 0, "empty bound failed")?;
  u:assert_eq(u:bound([7], 6), 0, "singleton before failed")?;
  u:assert_eq(u:bound([7], 7), 0, "singleton equal failed")?;
  u:assert_eq(u:bound([7], 8), 1, "singleton after failed")?;
  u:assert_eq(u:bound([-9, -4, 0, 8], -5), 1, "negative bound failed")?;
  u:assert_eq(u:bound([-9, -4, 0, 8], 20), 4, "past-end bound failed")?;
  ok({test: "lower-bound-boundaries", cases: 6})
}

@cases {rows: [[1, 2, 2, 2, 4, 2, 1], [1, 2, 2, 2, 4, 3, 4], [1, 2, 2, 2, 4, 0, 0], [1, 2, 2, 2, 4, 5, 5]]}
def u:lower_bound_case(row) {
  "Verify one reflected fixed-width lower-bound input and expected position.";
  values = compress(lt(range(tally(row)), 5), row);
  target = take(row, 0, 5);
  expected = take(row, 0, 6);
  u:assert_eq(u:bound(values, target), expected, "parameterized lower bound")
}

u:run_registered_tests()?;
metadata = annotations("u:lower_bound_case");
u:run_cases(:u:lower_bound_case, metadata.cases.rows)
