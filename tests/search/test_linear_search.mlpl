

include "src/search/linear_search.mlpl";

@test {name: "linear search contract", tags: ["linear", "unit", "native"]}
def u:test_contract() {
  "Run this script's conformance assertions.";
  u:assert_err(u:find(fill([0], 0), 1), "empty search should fail")?;
  u:assert_eq(u:find([7], 7)?, 0, "singleton match failed")?;
  u:assert_err(u:find([7], 8), "singleton absence should fail")?;
  u:assert_eq(u:find([3, 4, 3], 3)?, 0, "search should return first duplicate")?;
  u:assert_eq(u:find([3, 4, 5], 5)?, 2, "final boundary match failed")?;
  u:assert_eq(u:find([-9, -4, 2], -4)?, 1, "negative-value match failed")?;
  u:assert_err(u:find([-9, -4, 2], 0), "absent middle value should fail")?;
  ok({test: "linear-search", cases: 7})
}


u:run_registered_tests()
