# Native tests for sparse CSR addition and matrix multiplication.
include "src/matrices/sparse_csr.mlpl";

@test {name: "sparse addition cancellation and identity", tags: ["matrices", "sparse", "native"]}
def u:test_sp_addition() { "Verify zero identity, signed cancellation, sorted output, and retained operands.";
  left = u:sp_to_csr(u:sp_coo(2, 3, [0, 0, 1], [0, 2, 1], [4, -2, 5]))?; zero = u:sp_to_csr(u:sp_coo(2, 3, fill([0], 0), fill([0], 0), fill([0], 0)))?;
  same = u:sp_add(left, zero)?; u:assert_true(u:sp_csr_valid(same), "identity sum invalid")?; u:assert_eq(same.values, left.values, "zero identity failed")?;
  right = u:sp_to_csr(u:sp_coo(2, 3, [0, 1, 1], [2, 0, 1], [2, -3, -5]))?; sum = u:sp_add(left, right)?;
  u:assert_true(u:sp_csr_valid(sum), "sum invalid")?; u:assert_eq(sum.column_indices, [0, 0], "cancellation/ordering failed")?; u:assert_eq(sum.values, [4, -3], "signed sum failed")?; u:assert_eq(left.values, [4, -2, 5], "addition changed left operand")?;
  ok({test: "sparse-addition", cases: 6})
}

@test {name: "sparse rectangular product and dense oracle", tags: ["matrices", "algorithms", "native"]}
def u:test_sp_product() { "Verify rectangular multiplication, identity, empty output, zero elision, and dense-oracle cells.";
  left = u:sp_to_csr(u:sp_coo(2, 3, [0, 0, 1, 1], [0, 2, 1, 2], [2, -1, 3, 4]))?; right = u:sp_to_csr(u:sp_coo(3, 2, [0, 1, 2, 2], [0, 1, 0, 1], [5, 7, 6, -2]))?; product = u:sp_multiply(left, right)?;
  u:assert_true(u:sp_csr_valid(product), "product invalid")?; u:assert_eq([product.rows, product.columns], [2, 2], "product shape failed")?; u:assert_eq([u:sp_get(product, 0, 0), u:sp_get(product, 0, 1), u:sp_get(product, 1, 0), u:sp_get(product, 1, 1)], [4, 2, 24, 13], "product differs from dense oracle")?;
  identity = u:sp_to_csr(u:sp_coo(3, 3, [0, 1, 2], [0, 1, 2], [1, 1, 1]))?; unchanged = u:sp_multiply(left, identity)?; u:assert_eq(unchanged.values, left.values, "right identity failed")?;
  empty_left = u:sp_to_csr(u:sp_coo(0, 3, fill([0], 0), fill([0], 0), fill([0], 0)))?; empty_product = u:sp_multiply(empty_left, right)?; u:assert_eq([empty_product.rows, empty_product.columns, tally(empty_product.values)], [0, 2, 0], "empty product failed")?;
  ok({test: "sparse-product", cases: 5})
}

@test {name: "sparse composition dimension errors", tags: ["matrices", "validation", "native"]}
def u:test_sp_composition_errors() { "Verify incompatible addition/product shapes and invalid operands are rejected.";
  a = u:sp_to_csr(u:sp_coo(2, 3, fill([0], 0), fill([0], 0), fill([0], 0)))?; b = u:sp_to_csr(u:sp_coo(3, 2, fill([0], 0), fill([0], 0), fill([0], 0)))?;
  u:assert_err(u:sp_add(a, b), "unequal addition shapes should fail")?; u:assert_err(u:sp_multiply(b, b), "incompatible product should fail")?;
  bad = {rows: 1, columns: 1, row_pointers: [1, 1], column_indices: fill([0], 0), values: fill([0], 0)}; u:assert_err(u:sp_add(bad, bad), "invalid addition operand should fail")?; u:assert_err(u:sp_multiply(bad, bad), "invalid product operand should fail")?;
  ok({test: "sparse-composition-errors", cases: 4})
}
u:run_registered_tests()
