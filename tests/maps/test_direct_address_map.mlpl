def u:new_map(capacity) { {values: fill([capacity], 0), present: fill([capacity], 0), capacity: capacity, size: 0} }
def u:valid_key(map, key) {
  if eq(rank(key), 0) { if eq(key, floor(key)) { if lt(key, 0) { 0 } else { lt(key, map.capacity) } } else { 0 } } else { 0 }
}
def u:insert(map, key, value) {
  if u:valid_key(map, key) {
    old = take(map.present, 0, key);
    ok({values: scatter(map.values, key, value), present: scatter(map.present, key, 1), capacity: map.capacity, size: map.size + (1 - old)})
  } else { err({kind: "key", message: "invalid key"}) }
}
def u:lookup(map, key) {
  if u:valid_key(map, key) { if take(map.present, 0, key) { ok(take(map.values, 0, key)) } else { err({kind: "missing", message: "absent"}) } } else { err({kind: "key", message: "invalid key"}) }
}
def u:remove(map, key) {
  if u:valid_key(map, key) {
    if take(map.present, 0, key) { ok({values: scatter(map.values, key, 0), present: scatter(map.present, key, 0), capacity: map.capacity, size: map.size - 1}) } else { err({kind: "missing", message: "absent"}) }
  } else { err({kind: "key", message: "invalid key"}) }
}
def u:count(present, index) {
  if eq(index, tally(present)) { 0 } else { take(present, 0, index) + u:count(present, index + 1) }
}
def u:valid(map) {
  eq(map.capacity, tally(map.values)) * eq(map.capacity, tally(map.present)) * eq(map.size, u:count(map.present, 0))
}

def u:test() {
  empty = u:new_map(6);
  u:assert_true(u:valid(empty), "empty map invariant failed")?;
  u:assert_err(u:lookup(empty, 2), "empty lookup should miss")?;
  one = u:insert(empty, 2, 20)?;
  u:assert_eq(u:lookup(one, 2)?, 20, "insert lookup failed")?;
  u:assert_eq(one.size, 1, "insert size failed")?;
  updated = u:insert(one, 2, 25)?;
  u:assert_eq(u:lookup(updated, 2)?, 25, "duplicate-key update failed")?;
  u:assert_eq(updated.size, 1, "update should not grow size")?;
  zero = u:insert(updated, 5, 0)?;
  u:assert_eq(u:lookup(zero, 5)?, 0, "stored zero confused with absence")?;
  u:assert_eq(zero.size, 2, "boundary insert size failed")?;
  removed = u:remove(zero, 2)?;
  u:assert_err(u:lookup(removed, 2), "removed key should miss")?;
  u:assert_err(u:remove(removed, 2), "duplicate remove should fail")?;
  u:assert_eq(u:lookup(one, 2)?, 20, "later updates changed retained version")?;
  u:assert_err(u:insert(empty, -1, 1), "negative key should fail")?;
  u:assert_err(u:insert(empty, 6, 1), "past-end key should fail")?;
  u:assert_err(u:insert(empty, 1.5, 1), "fractional key should fail")?;
  u:assert_true(u:valid(removed), "removed map invariant failed")?;
  ok({test: "direct-address-map", cases: 15})
}
u:test()
