include "src/maps/robin_hood_sensor_registry.mlpl";

@test {name: "Robin Hood swaps wraparound and lookup", tags: ["maps", "hashing", "robin-hood"]}
def u:test_robin_hood_swaps() { "Verify displacement swaps, circular addressing, deterministic lookup, and map invariants.";
  keys = [0,1,2,3,4,7]; values = [100,10,20,30,40,700]; retained_keys = keys; retained_values = values;
  map = u:rh_insert_many(7, keys, values)?;
  u:assert_true(u:rh_valid(map), "Robin Hood invariant")?;
  u:assert_eq(u:rh_lookup(map, 7)?, 700, "displaced lookup")?;
  u:assert_eq(map.distances, [0,0,0,0,1,1,1], "Robin Hood swap layout")?;
  u:assert_true(gt(u:rh_max_distance_from(map.distances, map.states, 0, 0), 0), "fixture creates displacement")?;
  u:assert_eq(u:rh_lookup_with_probes(map, 1)?, u:rh_lookup_with_probes(map, 1)?, "deterministic probe result")?;
  u:assert_eq(keys, retained_keys, "keys retained")?; u:assert_eq(values, retained_values, "values retained")
}

@test {name: "Robin Hood updates stored zero and retained versions", tags: ["maps", "hashing", "persistent"]}
def u:test_robin_hood_updates() { "Verify duplicate and negative keys, stored zero, stable size, and immutable earlier versions.";
  empty = u:rh_new(5); one = u:rh_insert(empty, -1, 9)?; two = u:rh_insert(one, 4, 40)?;
  updated = u:rh_insert(two, -1, 0)?;
  u:assert_eq(u:rh_lookup(updated, -1)?, 0, "stored zero update")?;
  u:assert_eq(updated.size, 2, "duplicate update size")?;
  u:assert_eq(u:rh_lookup(one, -1)?, 9, "retained old value")?;
  u:assert_eq(one.size, 1, "retained old size")?;
  u:assert_true(u:rh_valid(updated), "updated invariant")
}

@test {name: "Robin Hood boundaries and early miss", tags: ["maps", "hashing", "boundary"]}
def u:test_robin_hood_boundaries() { "Verify full tables, missing lookups, early termination, malformed inputs, and invalid keys.";
  map = u:rh_insert_many(3, [0,3,6], [1,2,3])?;
  u:assert_eq(map.keys, [3,6,0], "collision chain wraps around")?;
  u:assert_err(u:rh_insert(map, 9, 4), "full insertion")?;
  u:assert_err(u:rh_lookup(map, 12), "full-table miss")?;
  sparse = u:rh_insert_many(7, [0,1,2,3,4,7], [1,2,3,4,5,6])?;
  missing = u:rh_locate_from(sparse, 8, 0);
  u:assert_eq(missing.found, 0, "missing result")?;
  u:assert_eq(missing.probes, 2, "resident distance terminates missing lookup early")?;
  u:assert_err(u:rh_insert(sparse, 1.5, 1), "fractional key")?;
  u:assert_err(u:rh_lookup(sparse, [1]), "array key")?;
  u:assert_err(u:rh_insert_many(2, [1,2,3], [1,2,3]), "insufficient capacity")?;
  u:assert_err(u:rh_insert_many(3, [1], [1,2]), "parallel shape")
}

@test {name: "Robin Hood fixed-fixture displacement comparison", tags: ["maps", "hashing", "comparison"]}
def u:test_robin_hood_comparison() { "Compare maximum displacement with classical linear probing only for one deterministic fixture.";
  keys = [0,1,2,3,4,7]; map = u:rh_insert_many(7, keys, [1,2,3,4,5,6])?; linear = u:linear_probe_profile(keys, 7);
  robin_max = u:rh_max_distance_from(map.distances, map.states, 0, 0);
  u:assert_true(lt(robin_max, linear.max_distance), "fixture should reduce maximum displacement")?;
  u:assert_eq([robin_max, linear.max_distance], [1,3], "fixed comparison profile")
}

u:run_registered_tests()
