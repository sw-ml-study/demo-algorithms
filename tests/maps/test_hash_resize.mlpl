def u:new_map(c) { {states: fill([c], 0), keys: fill([c], 0), values: fill([c], 0), capacity: c, size: 0} }
def u:norm(k) { if lt(k, 0) { 0 - k * 2 - 1 } else { k * 2 } }
def u:rem(v, d) { v - floor(v / d) * d }
def u:bucket(k, c) { u:rem(u:norm(k) * 37 + 17, c) }
def u:find_insert(map, key, probe, first_deleted) {
  if eq(probe, map.capacity) { if gt(first_deleted, -1) { ok({index: first_deleted, found: 0}) } else { err({kind: "full", message: "full"}) } } else {
    index = u:rem(u:bucket(key, map.capacity) + probe, map.capacity); state = take(map.states, 0, index);
    if eq(state, 0) { if gt(first_deleted, -1) { ok({index: first_deleted, found: 0}) } else { ok({index: index, found: 0}) } } else {
      if eq(state, 1) * eq(take(map.keys, 0, index), key) { ok({index: index, found: 1}) } else {
        remembered = if eq(state, 2) * eq(first_deleted, -1) { index } else { first_deleted };
        u:find_insert(map, key, probe + 1, remembered)
      }
    }
  }
}
def u:raw_insert(m, k, v) { x = u:find_insert(m, k, 0, -1)?; ok({states: scatter(m.states, x.index, 1), keys: scatter(m.keys, x.index, k), values: scatter(m.values, x.index, v), capacity: m.capacity, size: m.size + (1 - x.found)}) }
def u:rehash(old, position, fresh) {
  if eq(position, old.capacity) { fresh } else {
    if eq(take(old.states, 0, position), 1) { u:rehash(old, position + 1, unwrap(u:raw_insert(fresh, take(old.keys, 0, position), take(old.values, 0, position)))) } else { u:rehash(old, position + 1, fresh) }
  }
}
def u:put(m, k, v) {
  x = u:find_insert(m, k, 0, -1)?;
  if x.found { ok({states: m.states, keys: m.keys, values: scatter(m.values, x.index, v), capacity: m.capacity, size: m.size}) } else {
    if gt((m.size + 1) * 4, m.capacity * 3) {
      u:raw_insert(u:rehash(m, 0, u:new_map(m.capacity * 2 + 1)), k, v)
    } else {
      u:raw_insert(m, k, v)
    }
  }
}
def u:find_key(m, k, p) { if eq(p, m.capacity) { err({kind: "missing", message: "absent"}) } else { i = u:rem(u:bucket(k, m.capacity) + p, m.capacity); s = take(m.states, 0, i); if eq(s, 0) { err({kind: "missing", message: "absent"}) } else { if eq(s, 1) * eq(take(m.keys, 0, i), k) { ok(i) } else { u:find_key(m, k, p + 1) } } } }
def u:get(m, k) { ok(take(m.values, 0, u:find_key(m, k, 0)?)) }
def u:remove(m, k) { i = u:find_key(m, k, 0)?; ok({states: scatter(m.states, i, 2), keys: m.keys, values: m.values, capacity: m.capacity, size: m.size - 1}) }
def u:count(states, wanted, i) { if eq(i, tally(states)) { 0 } else { eq(take(states, 0, i), wanted) + u:count(states, wanted, i + 1) } }
def u:valid(m) { eq(m.size, u:count(m.states, 1, 0)) * eq(m.capacity, tally(m.states)) * eq(m.capacity, tally(m.keys)) * eq(m.capacity, tally(m.values)) }

def u:test() {
  m1 = u:put(u:new_map(4), 0, 10)?; m2 = u:put(m1, 4, 20)?; boundary_map = u:put(m2, 8, 0)?;
  u:assert_eq(boundary_map.capacity, 4, "exact 75 percent should not resize")?;
  first_growth = u:put(boundary_map, 12, 40)?;
  u:assert_eq(first_growth.capacity, 9, "resize capacity should be 2n+1")?;
  u:assert_eq(first_growth.size, 4, "resize lost size")?;
  u:assert_eq(u:get(first_growth, 0)?, 10, "rehash lost first collision")?;
  u:assert_eq(u:get(first_growth, 4)?, 20, "rehash lost second collision")?;
  u:assert_eq(u:get(first_growth, 8)?, 0, "rehash lost stored zero")?;
  u:assert_eq(u:get(first_growth, 12)?, 40, "rehash lost trigger key")?;
  updated_map = u:put(first_growth, 4, 25)?;
  u:assert_eq(updated_map.capacity, 9, "duplicate update resized")?;
  u:assert_eq(updated_map.size, 4, "duplicate update changed size")?;
  deleted_map = u:remove(updated_map, 8)?;
  u:assert_eq(u:count(deleted_map.states, 2, 0), 1, "delete did not create tombstone")?;
  stage1 = u:put(deleted_map, -1, -10)?; stage2 = u:put(stage1, 20, 50)?; stage3 = u:put(stage2, 24, 60)?; cleaned_map = u:put(stage3, 28, 70)?;
  u:assert_eq(cleaned_map.capacity, 19, "second growth failed")?;
  u:assert_eq(u:count(cleaned_map.states, 2, 0), 0, "rehash retained tombstone")?;
  u:assert_eq(u:get(cleaned_map, -1)?, -10, "negative key lost in rehash")?;
  u:assert_eq(u:get(cleaned_map, 20)?, 50, "post-delete key lost")?;
  u:assert_eq(u:get(first_growth, 8)?, 0, "later changes mutated retained old map")?;
  u:assert_eq(first_growth.capacity, 9, "later growth mutated old capacity")?;
  u:assert_true(u:valid(cleaned_map), "grown invariant failed")?;
  ok({test: "hash-resize-rehash", cases: 16})
}
u:test()
