def u:new_map(c) { {states: fill([c], 0), keys: fill([c], 0), values: fill([c], 0), capacity: c, size: 0} }
def u:norm(k) { if lt(k, 0) { 0 - k * 2 - 1 } else { k * 2 } }
def u:rem(v, d) { v - floor(v / d) * d }
def u:bucket(k, c) { u:rem(u:norm(k) * 37 + 17, c) }
def u:valid_key(k) { if eq(rank(k), 0) { eq(k, floor(k)) * lt(abs(k), 1000001) } else { 0 } }
def u:find_insert(map, key, probe, deleted) {
  if eq(probe, map.capacity) { if gt(deleted, -1) { ok({index: deleted, found: 0}) } else { err({kind: "full", message: "full"}) } } else {
    index = u:rem(u:bucket(key, map.capacity) + probe, map.capacity); state = take(map.states, 0, index);
    if eq(state, 0) { if gt(deleted, -1) { ok({index: deleted, found: 0}) } else { ok({index: index, found: 0}) } } else {
      if eq(state, 1) * eq(take(map.keys, 0, index), key) { ok({index: index, found: 1}) } else {
        next_deleted = if eq(state, 2) * eq(deleted, -1) { index } else { deleted };
        u:find_insert(map, key, probe + 1, next_deleted)
      }
    }
  }
}
def u:insert(map, key, value) {
  if u:valid_key(key) { slot = u:find_insert(map, key, 0, -1)?; ok({states: scatter(map.states, slot.index, 1), keys: scatter(map.keys, slot.index, key), values: scatter(map.values, slot.index, value), capacity: map.capacity, size: map.size + (1 - slot.found)}) } else { err({kind: "key", message: "invalid"}) }
}
def u:find_key(map, key, probe) {
  if eq(probe, map.capacity) { err({kind: "missing", message: "absent"}) } else {
    index = u:rem(u:bucket(key, map.capacity) + probe, map.capacity); state = take(map.states, 0, index);
    if eq(state, 0) { err({kind: "missing", message: "absent"}) } else {
      if eq(state, 1) * eq(take(map.keys, 0, index), key) { ok(index) } else { u:find_key(map, key, probe + 1) }
    }
  }
}
def u:lookup(map, key) { if u:valid_key(key) { ok(take(map.values, 0, u:find_key(map, key, 0)?)) } else { err({kind: "key", message: "invalid"}) } }
def u:remove(map, key) {
  if u:valid_key(key) { index = u:find_key(map, key, 0)?; ok({states: scatter(map.states, index, 2), keys: map.keys, values: map.values, capacity: map.capacity, size: map.size - 1}) } else { err({kind: "key", message: "invalid"}) }
}
def u:count_occupied(states, i) { if eq(i, tally(states)) { 0 } else { eq(take(states, 0, i), 1) + u:count_occupied(states, i + 1) } }
def u:valid_states(states, i) { if eq(i, tally(states)) { 1 } else { s = take(states, 0, i); (eq(s, 0) + eq(s, 1) + eq(s, 2)) * u:valid_states(states, i + 1) } }
def u:valid(map) { eq(map.size, u:count_occupied(map.states, 0)) * u:valid_states(map.states, 0) }

def u:test() {
  one = u:insert(u:new_map(5), 0, 10)?; two = u:insert(one, 5, 20)?; three = u:insert(two, 10, 30)?; wrapped = u:insert(three, 15, 40)?;
  removed = u:remove(wrapped, 5)?;
  u:assert_eq(u:lookup(removed, 10)?, 30, "tombstone broke collision chain")?;
  u:assert_eq(u:lookup(removed, 15)?, 40, "tombstone broke wraparound lookup")?;
  u:assert_err(u:lookup(removed, 5), "removed key should miss")?;
  u:assert_err(u:remove(removed, 5), "duplicate remove should miss")?;
  u:assert_eq(removed.size, 3, "remove size failed")?;
  reused = u:insert(removed, 20, 50)?;
  u:assert_eq(take(reused.states, 0, 3), 1, "first tombstone was not reused")?;
  u:assert_eq(take(reused.keys, 0, 3), 20, "reused slot has wrong key")?;
  u:assert_eq(u:lookup(reused, 20)?, 50, "reused key lookup failed")?;
  updated = u:insert(reused, 10, 35)?;
  u:assert_eq(updated.size, 4, "duplicate update changed size")?;
  u:assert_eq(u:lookup(updated, 10)?, 35, "duplicate update failed")?;
  zero = u:insert(updated, -1, 0)?;
  u:assert_eq(u:lookup(zero, -1)?, 0, "negative stored zero failed")?;
  u:assert_err(u:insert(zero, 99, 1), "occupied full table should fail")?;
  deleted_full = u:remove(zero, 0)?;
  u:assert_err(u:lookup(deleted_full, 777), "tombstoned full-table miss should terminate")?;
  refilled = u:insert(deleted_full, 25, 60)?;
  u:assert_eq(refilled.size, 5, "tombstoned full table did not refill")?;
  u:assert_eq(u:lookup(three, 5)?, 20, "later deletion changed retained version")?;
  u:assert_err(u:remove(refilled, 1.5), "fractional remove should fail")?;
  u:assert_true(u:valid(refilled), "final invariant failed")?;
  ok({test: "hash-map-tombstones", cases: 17})
}
u:test()
