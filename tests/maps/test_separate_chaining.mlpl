def u:new_map(capacity) { {heads: fill([capacity], -1), keys: fill([0], 0), values: fill([0], 0), next_handles: fill([0], 0), active: fill([0], 0), capacity: capacity, size: 0, nodes: 0} }
def u:norm(key) { if lt(key, 0) { 0 - key * 2 - 1 } else { key * 2 } }
def u:rem(value, divisor) { value - floor(value / divisor) * divisor }
def u:bucket(key, capacity) { u:rem(u:norm(key) * 37 + 17, capacity) }
def u:find_from(map, key, handle, steps) { if eq(handle, -1) + eq(steps, map.nodes) { -1 } else { if eq(take(map.active, 0, handle), 1) * eq(take(map.keys, 0, handle), key) { handle } else { u:find_from(map, key, take(map.next_handles, 0, handle), steps + 1) } } }
def u:find(map, key) { u:find_from(map, key, take(map.heads, 0, u:bucket(key, map.capacity)), 0) }
def u:raw_insert(map, key, value) { bucket = u:bucket(key, map.capacity); node = map.nodes; {heads: scatter(map.heads, bucket, node), keys: concat(map.keys, key), values: concat(map.values, value), next_handles: concat(map.next_handles, take(map.heads, 0, bucket)), active: concat(map.active, 1), capacity: map.capacity, size: map.size + 1, nodes: node + 1} }
def u:rehash(old_map, position, fresh_map) { if eq(position, old_map.nodes) { fresh_map } else { if eq(take(old_map.active, 0, position), 1) { u:rehash(old_map, position + 1, u:raw_insert(fresh_map, take(old_map.keys, 0, position), take(old_map.values, 0, position))) } else { u:rehash(old_map, position + 1, fresh_map) } } }
def u:put(map, key, value) { node = u:find(map, key); if gt(node, -1) { {heads: map.heads, keys: map.keys, values: scatter(map.values, node, value), next_handles: map.next_handles, active: map.active, capacity: map.capacity, size: map.size, nodes: map.nodes} } else { if gt(map.size + 1, map.capacity) { u:raw_insert(u:rehash(map, 0, u:new_map(map.capacity * 2 + 1)), key, value) } else { u:raw_insert(map, key, value) } } }
def u:get(map, key) { node = u:find(map, key); if eq(node, -1) { err({kind: "missing", message: "absent"}) } else { ok(take(map.values, 0, node)) } }
def u:locate(map, key, handle, previous, steps) { if eq(handle, -1) + eq(steps, map.nodes) { {index: -1, previous: -1} } else { if eq(take(map.active, 0, handle), 1) * eq(take(map.keys, 0, handle), key) { {index: handle, previous: previous} } else { u:locate(map, key, take(map.next_handles, 0, handle), handle, steps + 1) } } }
def u:remove(map, key) { bucket = u:bucket(key, map.capacity); place = u:locate(map, key, take(map.heads, 0, bucket), -1, 0); if eq(place.index, -1) { err({kind: "missing", message: "absent"}) } else { successor = take(map.next_handles, 0, place.index); new_heads = if eq(place.previous, -1) { scatter(map.heads, bucket, successor) } else { map.heads }; new_next = if eq(place.previous, -1) { map.next_handles } else { scatter(map.next_handles, place.previous, successor) }; ok({heads: new_heads, keys: map.keys, values: map.values, next_handles: new_next, active: scatter(map.active, place.index, 0), capacity: map.capacity, size: map.size - 1, nodes: map.nodes}) } }
def u:count(values, wanted, position) { if eq(position, tally(values)) { 0 } else { eq(take(values, 0, position), wanted) + u:count(values, wanted, position + 1) } }
def u:handles_ok(map, position) { if eq(position, map.nodes) { 1 } else { handle = take(map.next_handles, 0, position); (eq(handle, -1) + (gt(handle, -1) * lt(handle, map.nodes))) * u:handles_ok(map, position + 1) } }
def u:valid(map) { eq(tally(map.heads), map.capacity) * eq(tally(map.keys), map.nodes) * eq(tally(map.values), map.nodes) * eq(tally(map.next_handles), map.nodes) * eq(tally(map.active), map.nodes) * eq(u:count(map.active, 1, 0), map.size) * u:handles_ok(map, 0) }

def u:test() {
  empty_map = u:new_map(3); u:assert_err(u:get(empty_map, 9), "empty lookup should fail")?;
  one = u:put(empty_map, 0, 10); two = u:put(one, 3, 0); three = u:put(two, 6, 60);
  u:assert_eq(three.capacity, 3, "load one should not resize")?;
  u:assert_eq(u:get(three, 3)?, 0, "stored zero lost in chain")?;
  u:assert_eq(three.size, 3, "collision inserts changed size")?;
  first_growth = u:put(three, 9, 90);
  u:assert_eq(first_growth.capacity, 7, "fourth insert should resize")?;
  u:assert_eq(u:get(first_growth, 0)?, 10, "rehash lost key zero")?;
  u:assert_eq(u:get(first_growth, 6)?, 60, "rehash lost collision")?;
  revised_map = u:put(first_growth, 6, 66);
  u:assert_eq(revised_map.size, 4, "duplicate update grew size")?;
  u:assert_eq(revised_map.capacity, 7, "duplicate update resized")?;
  u:assert_eq(u:get(revised_map, 6)?, 66, "duplicate update lost value")?;
  head_removed = u:remove(revised_map, 9)?;
  u:assert_err(u:get(head_removed, 9), "head deletion retained key")?;
  interior_removed = u:remove(head_removed, 3)?;
  u:assert_err(u:get(interior_removed, 3), "interior deletion retained key")?;
  u:assert_eq(u:get(interior_removed, 0)?, 10, "interior deletion broke chain")?;
  u:assert_err(u:remove(interior_removed, 99), "missing delete should fail")?;
  negative_map = u:put(interior_removed, -3, -30);
  u:assert_eq(u:get(negative_map, -3)?, -30, "negative key failed")?;
  u:assert_eq(u:get(first_growth, 3)?, 0, "later changes mutated old version")?;
  u:assert_true(u:valid(negative_map), "representation invariant failed")?;
  malformed_map = {heads: negative_map.heads, keys: negative_map.keys, values: negative_map.values, next_handles: scatter(negative_map.next_handles, 0, 999), active: negative_map.active, capacity: negative_map.capacity, size: negative_map.size, nodes: negative_map.nodes};
  u:assert_false(u:valid(malformed_map), "malformed handle passed validation")?;
  ok({test: "separate-chaining", cases: 18})
}
u:test()
