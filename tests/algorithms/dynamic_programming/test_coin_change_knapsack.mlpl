def u:valid_coins(coins, i) { if eq(i, tally(coins)) { 1 } else { coin = take(coins, 0, i); gt(coin, 0) * eq(coin, floor(coin)) * u:valid_coins(coins, i + 1) } }
def u:best_coin(coins, amount, counts, i, best_count, best_coin) { if eq(i, tally(coins)) { {count: best_count, coin: best_coin} } else { coin = take(coins, 0, i); usable = lt(coin, amount) + eq(coin, amount); prior = if usable { take(counts, 0, amount - coin) } else { 1000000000 }; candidate = prior + 1; better = lt(candidate, best_count) + eq(candidate, best_count) * (eq(best_coin, -1) + lt(coin, best_coin)); if usable * lt(prior, 1000000000) * better { u:best_coin(coins, amount, counts, i + 1, candidate, coin) } else { u:best_coin(coins, amount, counts, i + 1, best_count, best_coin) } } }
def u:build_change(coins, target, amount, counts, choices) { if gt(amount, target) { {counts: counts, choices: choices} } else { best = u:best_coin(coins, amount, counts, 0, 1000000000, -1); u:build_change(coins, target, amount + 1, concat(counts, best.count), concat(choices, best.coin)) } }
def u:recover_change(choices, remaining, selected) { if eq(remaining, 0) { ok(selected) } else { coin = take(choices, 0, remaining); if eq(coin, -1) { err({kind: "impossible", message: "target cannot be made"}) } else { u:recover_change(choices, remaining - coin, concat(selected, coin)) } } }
def u:coin_change(coins, target) { if lt(target, 0) { err({kind: "target", message: "negative"}) } else { if eq(target, floor(target)) { if u:valid_coins(coins, 0) { table = u:build_change(coins, target, 1, [0], [-1]); count = take(table.counts, 0, target); if eq(count, 1000000000) { ok({possible: 0, count: -1, coins: fill([0], 0)}) } else { picked = u:recover_change(table.choices, target, fill([0], 0))?; ok({possible: 1, count: count, coins: picked}) } } else { err({kind: "denomination", message: "positive integer"}) } } else { err({kind: "target", message: "integer"}) } } }

def u:valid_weights(weights, i) { if eq(i, tally(weights)) { 1 } else { weight = take(weights, 0, i); gt(weight, 0) * eq(weight, floor(weight)) * u:valid_weights(weights, i + 1) } }
def u:build_row(weight, value, previous, capacity, current, row, choices) { if gt(current, capacity) { {row: row, choices: choices} } else { exclude = take(previous, 0, current); fits = lt(weight, current) + eq(weight, current); include = if fits { take(previous, 0, current - weight) + value } else { -1000000000 }; take_item = fits * gt(include, exclude); best = if take_item { include } else { exclude }; u:build_row(weight, value, previous, capacity, current + 1, concat(row, best), concat(choices, take_item)) } }
def u:build_items(weights, values, capacity, item, previous, decisions) { if eq(item, tally(weights)) { {values: previous, decisions: decisions} } else { next = u:build_row(take(weights, 0, item), take(values, 0, item), previous, capacity, 0, fill([0], 0), fill([0], 0)); u:build_items(weights, values, capacity, item + 1, next.row, concat(decisions, next.choices)) } }
def u:recover_items(weights, decisions, width, item, remaining, selected) { if eq(item, 0) { selected } else { chosen = take(decisions, 0, item * width + remaining); if chosen { u:recover_items(weights, decisions, width, item - 1, remaining - take(weights, 0, item - 1), concat(item - 1, selected)) } else { u:recover_items(weights, decisions, width, item - 1, remaining, selected) } } }
def u:knapsack(weights, values, capacity) { if lt(capacity, 0) { err({kind: "capacity", message: "negative"}) } else { if eq(capacity, floor(capacity)) { if eq(tally(weights), tally(values)) { if u:valid_weights(weights, 0) { width = capacity + 1; built = u:build_items(weights, values, capacity, 0, fill([width], 0), fill([width], 0)); ok({value: take(built.values, 0, capacity), item_ids: u:recover_items(weights, built.decisions, width, tally(weights), capacity, fill([0], 0))}) } else { err({kind: "weight", message: "positive integer"}) } } else { err({kind: "shape", message: "vectors"}) } } else { err({kind: "capacity", message: "integer"}) } } }

def u:test() {
  empty_zero = u:coin_change([], 0)?; u:assert_true(empty_zero.possible, "empty zero possible")?; u:assert_eq(empty_zero.count, 0, "zero coin count")?; u:assert_eq(empty_zero.coins, [], "zero reconstruction")?;
  impossible = u:coin_change([], 3)?; u:assert_false(impossible.possible, "empty positive impossible")?; u:assert_eq(impossible.count, -1, "impossible count")?;
  gap = u:coin_change([4, 6], 7)?; u:assert_false(gap.possible, "unmakeable target")?;
  canonical = u:coin_change([1, 5, 10, 25], 30)?; u:assert_eq(canonical.coins, [5, 25], "canonical deterministic reconstruction")?;
  noncanonical = u:coin_change([1, 3, 4], 6)?; u:assert_eq(noncanonical.count, 2, "noncanonical optimum")?; u:assert_eq(noncanonical.coins, [3, 3], "noncanonical reconstruction")?;
  duplicate = u:coin_change([2, 2, 3], 4)?; u:assert_eq(duplicate.coins, [2, 2], "duplicate denomination policy")?;
  tie = u:coin_change([3, 2, 4], 6)?; u:assert_eq(tie.coins, [2, 4], "smaller-coin deterministic tie")?;
  u:assert_err(u:coin_change([0, 1], 2), "zero denomination")?; u:assert_err(u:coin_change([-1, 2], 2), "negative denomination")?; u:assert_err(u:coin_change([1.5, 2], 2), "fractional denomination")?; u:assert_err(u:coin_change([1], -1), "negative target")?; u:assert_err(u:coin_change([1], 1.5), "fractional target")?; u:assert_eq(noncanonical.coins, [3, 3], "retained coin result")?;

  empty_bag = u:knapsack([], [], 5)?; u:assert_eq(empty_bag.value, 0, "empty knapsack")?; u:assert_eq(empty_bag.item_ids, [], "empty selection")?;
  zero_capacity = u:knapsack([1], [9], 0)?; u:assert_eq(zero_capacity.value, 0, "zero capacity")?;
  heavy = u:knapsack([6], [20], 5)?; u:assert_eq(heavy.item_ids, [], "item too heavy")?;
  exact = u:knapsack([5, 2], [9, 3], 5)?; u:assert_eq(exact.item_ids, [0], "exact fit")?;
  known_weights = [2, 3, 4, 5]; known_values = [3, 4, 5, 8]; known = u:knapsack(known_weights, known_values, 7)?; u:assert_eq(known.value, 11, "known optimum")?; u:assert_eq(known.item_ids, [0, 3], "known reconstruction")?;
  competing = u:knapsack([2, 3, 4], [4, 5, 7], 5)?; u:assert_eq(competing.item_ids, [0, 1], "competing combination")?;
  deterministic = u:knapsack([2, 2], [5, 5], 2)?; u:assert_eq(deterministic.item_ids, [0], "exclude-later deterministic tie")?;
  u:assert_err(u:knapsack([1], [], 2), "parallel shape")?; u:assert_err(u:knapsack([0], [1], 2), "zero weight")?; u:assert_err(u:knapsack([1.5], [1], 2), "fractional weight")?; u:assert_err(u:knapsack([1], [1], -1), "negative capacity")?; u:assert_err(u:knapsack([1], [1], 1.5), "fractional capacity")?;
  u:assert_eq(known_weights, [2, 3, 4, 5], "weights retained")?; u:assert_eq(known_values, [3, 4, 5, 8], "values retained")?;
  ok({test: "coin-change-knapsack", cases: 32})
}
u:test()
