

include "src/sequences/reverse.mlpl";

@test {name: "sequence reverse contract", tags: ["sequence", "unit", "native"]}
def u:test_contract() {
  "Run this script's conformance assertions.";
  empty = fill([0], 0);
  u:assert_eq(u:reverse(empty), empty, "empty reverse failed")?;
  u:assert_eq(u:reverse([7]), [7], "singleton reverse failed")?;
  u:assert_eq(u:reverse([1, 2, 3, 4]), [4, 3, 2, 1], "even reverse failed")?;
  u:assert_eq(u:reverse([1, 2, 3, 4, 5]), [5, 4, 3, 2, 1], "odd reverse failed")?;
  u:assert_eq(u:reverse([2, 2, 8, 2]), [2, 8, 2, 2], "duplicate reverse failed")?;
  u:assert_eq(u:reverse([-5, 0, 9, -2]), [-2, 9, 0, -5], "negative reverse failed")?;

  original = [10, 20, 30];
  reversed = u:reverse(original);
  u:assert_eq(original, [10, 20, 30], "reverse changed original value")?;
  u:assert_eq(u:reverse(reversed), original, "double reverse should restore input")?;
  ok({test: "numeric-reverse", cases: 8})
}


u:run_registered_tests()
