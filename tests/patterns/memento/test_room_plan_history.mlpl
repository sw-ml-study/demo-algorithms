include "src/patterns/memento/room_plan_history.mlpl";

@test {name: "capture restore and retained states", tags: ["gof", "memento", "history"]}
def u:test_memento_restore() { "Verify multiple snapshots restore exactly while originator states and earlier histories remain unchanged.";
  initial = u:new_room_plan([40,25,12])?; h0 = u:new_plan_history(3)?; h1 = u:capture_plan(h0, initial)?;
  first = u:adjust_room_capacity(initial, 1, 10)?; h2 = u:capture_plan(h1, first)?; second = u:adjust_room_capacity(first, 0, -5)?; h3 = u:capture_plan(h2, second)?;
  restored0 = u:restore_plan(h3, 0)?; restored1 = u:restore_plan(h3, 1)?; restored2 = u:restore_plan(h3, 2)?;
  u:assert_eq(restored0.capacities, [40,25,12], "initial memento")?; u:assert_eq(restored1.capacities, [40,35,12], "first memento")?;
  u:assert_eq(restored2.capacities, [35,35,12], "second memento")?; u:assert_eq(restored2.revision, 2, "restored revision")?;
  u:assert_eq(initial.capacities, [40,25,12], "originator retained")?; u:assert_eq(first.capacities, [40,35,12], "intermediate retained")?;
  u:assert_eq(h1.count, 1, "earlier caretaker retained")?; u:assert_eq(h2.count, 2, "middle caretaker retained")?; u:assert_eq(h3.count, 3, "latest caretaker count")
}

@test {name: "undo and memento boundaries", tags: ["gof", "memento", "boundary"]}
def u:test_memento_undo() { "Verify undo pops the latest snapshot and validates empty, shape, position, room, and capacity policies.";
  plan = u:new_room_plan([8,5])?; h0 = u:new_plan_history(2)?; h1 = u:capture_plan(h0, plan)?; changed = u:adjust_room_capacity(plan, 0, 3)?; h2 = u:capture_plan(h1, changed)?;
  undo1 = u:undo_plan(h2)?; undo2 = u:undo_plan(undo1.history)?;
  u:assert_eq(undo1.state.capacities, [11,5], "latest undo state")?; u:assert_eq(undo1.history.count, 1, "latest memento popped")?;
  u:assert_eq(undo2.state.capacities, [8,5], "second undo state")?; u:assert_eq(undo2.history.count, 0, "history exhausted")?;
  u:assert_err(u:undo_plan(h0), "empty undo")?; u:assert_err(u:restore_plan(h2, -1), "negative position")?; u:assert_err(u:restore_plan(h2, 2), "large position")?;
  u:assert_err(u:capture_plan(h0, u:new_room_plan([1])?), "snapshot width")?; u:assert_err(u:adjust_room_capacity(plan, -1, 1), "negative room")?;
  u:assert_err(u:adjust_room_capacity(plan, 2, 1), "large room")?; u:assert_err(u:adjust_room_capacity(plan, 1, -6), "negative capacity")?;
  u:assert_err(u:new_room_plan(1), "plan vector")?; u:assert_err(u:new_plan_history(-1), "negative history width")
}

u:run_registered_tests()
