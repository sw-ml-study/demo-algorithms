include "src/patterns/factory/fulfillment_factories.mlpl";

@test {name: "Factory Method constructor substitution", tags: ["gof", "factory-method", "first-class"]}
def u:test_factory_method_substitution() { "Verify one workflow accepts two constructors while retaining its numeric inputs.";
  order_id = 91; units = 4; retained = [order_id, units];
  economy = u:prepare_fulfillment(order_id, units, :u:create_economy_order)?;
  expedited = u:prepare_fulfillment(order_id, units, :u:create_expedited_order)?;
  u:assert_eq(economy.order.service_class, 1, "economy product")?;
  u:assert_eq(economy.total_fee, 8, "economy fee")?;
  u:assert_eq(expedited.order.service_class, 2, "expedited product")?;
  u:assert_eq(expedited.total_fee, 20, "expedited fee")?;
  u:assert_eq([order_id, units], retained, "inputs retained")
}

@test {name: "Abstract Factory coherent families", tags: ["gof", "abstract-factory", "first-class"]}
def u:test_abstract_factory_families() { "Verify fixed factory records create two substitutable and internally compatible product families.";
  local_factory = {create_worker: :u:create_local_worker, create_store: :u:create_local_store};
  remote_factory = {create_worker: :u:create_remote_worker, create_store: :u:create_remote_store};
  local = u:provision_analytics_site(5, local_factory)?;
  remote = u:provision_analytics_site(5, remote_factory)?;
  u:assert_eq([local.worker.family, local.store.family], [10,10], "local compatibility")?;
  u:assert_eq([remote.worker.family, remote.store.family], [20,20], "remote compatibility")?;
  u:assert_eq([local.total_capacity, remote.total_capacity], [15,25], "family behavior")
}

@test {name: "Factory validation and incompatible products", tags: ["gof", "factory", "boundary"]}
def u:test_factory_boundaries() { "Verify constructors reject invalid input and the client rejects mixed-family products.";
  mixed = {create_worker: :u:create_local_worker, create_store: :u:create_remote_store};
  u:assert_err(u:prepare_fulfillment(0, 1, :u:create_economy_order), "invalid order ID")?;
  u:assert_err(u:prepare_fulfillment(1, 0, :u:create_expedited_order), "invalid units")?;
  u:assert_err(u:provision_analytics_site(0, {create_worker: :u:create_local_worker, create_store: :u:create_local_store}), "invalid capacity")?;
  u:assert_err(u:provision_analytics_site(3, mixed), "mixed family")
}

u:run_registered_tests()
