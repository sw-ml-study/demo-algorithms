include "src/patterns/adapter/transit_departure_adapter.mlpl";

@test {name: "adapter representation parity", tags: ["gof", "adapter", "graph"]}
def u:test_adapter_parity() { "Verify the target protocol preserves the existing CSR conversion and source value.";
  base = u:new_graph(4, [10,20,30,40]); g1 = u:add_edge(base, 0, 1, 7)?; g2 = u:add_edge(g1, 0, 3, 12)?; graph = u:add_edge(g2, 2, 0, 4)?;
  retained_sources = graph.sources; retained_targets = graph.targets; csr = u:to_csr(graph); routes = u:adapt_edge_graph_to_route_index(graph);
  u:assert_true(u:valid_route_index(routes), "adapted protocol invariant")?; u:assert_eq(routes.stops, csr.vertices, "vertex parity")?;
  u:assert_eq(routes.offsets, csr.offsets, "offset parity")?; u:assert_eq(routes.destinations, csr.targets, "target parity")?; u:assert_eq(routes.minutes, csr.weights, "weight parity")?;
  u:assert_eq(graph.sources, retained_sources, "source endpoints retained")?; u:assert_eq(graph.targets, retained_targets, "target endpoints retained")?; u:assert_eq(base.edges, 0, "original graph retained")
}

@test {name: "target-only departure consumer", tags: ["gof", "adapter", "consumer"]}
def u:test_departure_consumer() { "Verify the consumer handles populated, isolated, zero-cost, and invalid target-protocol queries.";
  graph = u:add_edge(u:add_edge(u:new_graph(4, [1,2,3,4]), 0, 1, 0)?, 0, 2, 9)?; routes = u:adapt_edge_graph_to_route_index(graph);
  first = u:departure_summary(routes, 0)?; isolated = u:departure_summary(routes, 3)?;
  u:assert_eq(first.destinations, [1,2], "direct destinations")?; u:assert_eq(first.minutes, [0,9], "zero-cost route retained")?;
  u:assert_eq(first.departure_count, 2, "departure count")?; u:assert_eq(first.total_minutes, 9, "consumer aggregate")?;
  u:assert_eq(isolated.destinations, [], "isolated destinations")?; u:assert_eq(isolated.total_minutes, 0, "isolated aggregate")?;
  u:assert_err(u:departure_summary(routes, -1), "negative stop")?; u:assert_err(u:departure_summary(routes, 4), "large stop")
}

u:run_registered_tests()
