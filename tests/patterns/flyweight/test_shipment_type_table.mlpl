include "src/patterns/flyweight/shipment_type_table.mlpl";

@test {name: "shared intrinsic table reuse", tags: ["gof", "flyweight", "table"]}
def u:test_flyweight_reuse() { "Verify repeated lightweight IDs resolve against one retained intrinsic table.";
  weights = [2,5,12]; handling = [1,3,8]; table = u:new_shipment_type_table(weights, handling)?; retained_weights = table.unit_weights; retained_handling = table.unit_handling;
  result = u:resolve_shipments(table, [0,2,0,1,2,0], [4,1,3,2,2,5])?;
  u:assert_eq(result.weights, [8,12,6,10,24,10], "resolved weights")?; u:assert_eq(result.handling, [4,8,3,6,16,5], "resolved handling")?;
  u:assert_eq(result.total_weight, 70, "total weight")?; u:assert_eq(result.total_handling, 42, "total handling")?;
  u:assert_eq(table.unit_weights, retained_weights, "intrinsic weights retained")?; u:assert_eq(table.unit_handling, retained_handling, "intrinsic handling retained")?;
  u:assert_eq(weights, [2,5,12], "source weights retained")?; u:assert_eq(handling, [1,3,8], "source handling retained")
}

@test {name: "flyweight boundaries and validation", tags: ["gof", "flyweight", "boundary"]}
def u:test_flyweight_boundaries() { "Verify empty use, repeated IDs, zero quantity, and malformed table/order policies.";
  empty_table = u:new_shipment_type_table([], [])?; empty = u:resolve_shipments(empty_table, [], [])?;
  u:assert_eq(empty.weights, [], "empty weights")?; u:assert_eq(empty.total_weight, 0, "empty total")?;
  table = u:new_shipment_type_table([3,7], [2,4])?; repeated = u:resolve_shipments(table, [1,1,1], [0,2,3])?;
  u:assert_eq(repeated.weights, [0,14,21], "repeated IDs and zero quantity")?; u:assert_eq(repeated.handling, [0,8,12], "extrinsic quantities")?;
  u:assert_err(u:new_shipment_type_table([1], []), "parallel intrinsic shapes")?; u:assert_err(u:new_shipment_type_table(1, [1]), "intrinsic vectors")?;
  u:assert_err(u:resolve_shipments(table, [0], []), "parallel orders")?; u:assert_err(u:resolve_shipments(table, [-1], [1]), "negative ID")?;
  u:assert_err(u:resolve_shipments(table, [2], [1]), "large ID")?; u:assert_err(u:resolve_shipments(table, [0.5], [1]), "fractional ID")?;
  u:assert_err(u:resolve_shipments(table, [0], [-1]), "negative quantity")
}

u:run_registered_tests()
