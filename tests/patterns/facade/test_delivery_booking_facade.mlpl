include "src/patterns/facade/delivery_booking_facade.mlpl";

@test {name: "Facade coordinates three subsystems", tags: ["gof", "facade", "composition"]}
def u:test_facade_booking() { "Verify the simplified operation validates, prices, allocates, and describes effects.";
  request = {order_id: 8, units: 7, distance: 12}; rates = {per_unit: 3, per_distance: 2}; fleet = {ids: [1,2,3], capacities: [4,8,20]};
  booking = u:book_delivery(request, rates, fleet)?;
  u:assert_eq([booking.price, booking.vehicle_id], [45,2], "facade result")?;
  u:assert_eq(booking.effects, [10,8,20,2], "effects as data")?;
  u:assert_eq(request.units, 7, "request retained")?;
  u:assert_eq(fleet.ids, [1,2,3], "fleet retained")
}

@test {name: "Facade subsystem helpers remain testable", tags: ["gof", "facade", "subsystem"]}
def u:test_facade_subsystems() { "Verify subsystem operations retain useful independent contracts despite the simplified interface.";
  request = {order_id: 1, units: 3, distance: 5};
  u:assert_eq(u:validate_delivery_request(request)?, request, "validation")?;
  u:assert_eq(u:price_delivery(request, {per_unit: 2, per_distance: 4})?, 26, "pricing")?;
  u:assert_eq(u:allocate_delivery_vehicle(request, {ids: [9,8], capacities: [2,3]})?, 8, "allocation")
}

@test {name: "Facade propagates subsystem errors", tags: ["gof", "facade", "boundary"]}
def u:test_facade_errors() { "Verify request, rate, fleet, and capacity failures propagate through the Facade Result.";
  rates = {per_unit: 1, per_distance: 1}; fleet = {ids: [1], capacities: [5]};
  u:assert_err(u:book_delivery({order_id: 0, units: 2, distance: 1}, rates, fleet), "invalid request")?;
  u:assert_err(u:book_delivery({order_id: 1, units: 2, distance: 1}, {per_unit: -1, per_distance: 1}, fleet), "invalid rates")?;
  u:assert_err(u:book_delivery({order_id: 1, units: 8, distance: 1}, rates, fleet), "capacity")?;
  u:assert_err(u:book_delivery({order_id: 1, units: 2, distance: 1}, rates, {ids: [], capacities: []}), "empty fleet")
}

u:run_registered_tests()
