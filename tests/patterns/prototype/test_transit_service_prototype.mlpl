include "src/patterns/prototype/transit_service_prototype.mlpl";

@test {name: "prototype derivation retains source", tags: ["gof", "prototype", "persistence"]}
def u:test_prototype_retention() { "Verify a derived service changes requested fields while retaining the prototype value.";
  empty = u:new_graph(4, [10,20,30,40]); first = u:add_edge(empty, 0, 1, 8)?; prototype = u:add_edge(first, 1, 2, 6)?;
  retained_payloads = prototype.payloads; retained_sources = prototype.sources; retained_targets = prototype.targets; retained_weights = prototype.weights;
  derived = u:derive_transit_prototype(prototype, 2, 300, 2, 3, 4)?;
  u:assert_eq(derived.payloads, [10,20,300,40], "derived payload")?; u:assert_eq(derived.targets, [1,2,3], "derived route")?; u:assert_eq(derived.weights, [8,6,4], "derived minutes")?;
  u:assert_eq(prototype.payloads, retained_payloads, "prototype payloads retained")?; u:assert_eq(prototype.sources, retained_sources, "prototype sources retained")?;
  u:assert_eq(prototype.targets, retained_targets, "prototype targets retained")?; u:assert_eq(prototype.weights, retained_weights, "prototype weights retained")?;
  u:assert_eq(empty.edges, 0, "earlier prototype retained")
}

@test {name: "prototype variants are independent values", tags: ["gof", "prototype", "variant"]}
def u:test_prototype_variants() { "Verify sibling derivations and duplicate-route replacement have independent observable values.";
  prototype = u:add_edge(u:new_graph(3, [1,2,3]), 0, 1, 10)?;
  express = u:derive_transit_prototype(prototype, 1, 20, 0, 1, 5)?; extension = u:derive_transit_prototype(prototype, 2, 30, 1, 2, 7)?;
  u:assert_eq(express.edges, 1, "replacement keeps edge count")?; u:assert_eq(express.weights, [5], "replacement minutes")?; u:assert_eq(express.payloads, [1,20,3], "express payload")?;
  u:assert_eq(extension.edges, 2, "extension adds edge")?; u:assert_eq(extension.weights, [10,7], "extension minutes")?; u:assert_eq(extension.payloads, [1,2,30], "extension payload")?;
  u:assert_eq(prototype.weights, [10], "prototype route retained")?; u:assert_eq(prototype.payloads, [1,2,3], "prototype payload retained")?;
  u:assert_err(u:prototype_with_stop_value(prototype, -1, 9), "negative stop")?; u:assert_err(u:derive_transit_prototype(prototype, 3, 9, 0, 1, 1), "large stop")?;
  u:assert_err(u:derive_transit_prototype(prototype, 1, 9, 0, 3, 1), "invalid derived endpoint")
}

u:run_registered_tests()
