include "src/patterns/bridge/energy_meter_bridge.mlpl";

@test {name: "Bridge implementation substitution", tags: ["gof", "bridge", "first-class"]}
def u:test_bridge_implementations() { "Verify one abstraction produces equivalent results through two meter implementations.";
  direct = {encoding: 1, total: :u:direct_total, peak: :u:direct_peak};
  scaled = {encoding: 2, total: :u:scaled_total, peak: :u:scaled_peak};
  direct_data = {encoding: 1, values: [12,18,15,9], scale: 1};
  scaled_data = {encoding: 2, values: [120,180,150,90], scale: 10};
  retained_direct = direct_data.values; retained_scaled = scaled_data.values;
  a = u:energy_usage_summary(direct_data, direct)?; b = u:energy_usage_summary(scaled_data, scaled)?;
  u:assert_eq([a.total, a.peak, a.samples], [54,18,4], "direct summary")?;
  u:assert_eq(b, a, "scaled implementation parity")?;
  u:assert_eq(direct_data.values, retained_direct, "direct retained")?;
  u:assert_eq(scaled_data.values, retained_scaled, "scaled retained")
}

@test {name: "Bridge abstraction variation", tags: ["gof", "bridge", "abstraction"]}
def u:test_bridge_abstractions() { "Verify usage and budget abstractions vary independently of one shared implementation.";
  meter = {encoding: 1, total: :u:direct_total, peak: :u:direct_peak};
  data = {encoding: 1, values: [4,7,5], scale: 1};
  summary = u:energy_usage_summary(data, meter)?;
  generous = u:energy_budget_status(data, meter, 20)?;
  tight = u:energy_budget_status(data, meter, 10)?;
  u:assert_eq([summary.total, summary.peak], [16,7], "summary abstraction")?;
  u:assert_eq([generous.within_budget, generous.remaining], [1,4], "generous budget")?;
  u:assert_eq([tight.within_budget, tight.remaining], [0,-6], "tight budget")
}

@test {name: "Bridge boundaries and protocol coherence", tags: ["gof", "bridge", "boundary"]}
def u:test_bridge_boundaries() { "Verify invalid data, mismatched encodings, and invalid abstraction input return errors.";
  direct = {encoding: 1, total: :u:direct_total, peak: :u:direct_peak};
  scaled = {encoding: 2, total: :u:scaled_total, peak: :u:scaled_peak};
  u:assert_err(u:energy_usage_summary({encoding: 1, values: [], scale: 1}, direct), "empty readings")?;
  u:assert_err(u:energy_usage_summary({encoding: 1, values: [2,-1], scale: 1}, direct), "negative reading")?;
  u:assert_err(u:energy_usage_summary({encoding: 1, values: [2], scale: 0}, direct), "invalid scale")?;
  u:assert_err(u:energy_usage_summary({encoding: 1, values: [2], scale: 1}, scaled), "encoding mismatch")?;
  u:assert_err(u:energy_budget_status({encoding: 1, values: [2], scale: 1}, direct, -1), "invalid budget")
}

u:run_registered_tests()
