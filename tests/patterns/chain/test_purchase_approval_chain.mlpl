include "src/patterns/chain/purchase_approval_chain.mlpl";

@test {name: "Chain short-circuits at first acceptance", tags: ["gof", "chain", "delegation"]}
def u:test_chain_short_circuit() { "Verify a first-handler acceptance does not visit its successor.";
  terminal = {fn: :u:unhandled_purchase_handler, environment: {handler_id: 99}};
  manager = {fn: :u:manager_purchase_handler, environment: {handler_id: 20, limit: 1000, next: terminal}};
  chain = {fn: :u:team_purchase_handler, environment: {handler_id: 10, limit: 100, next: manager}};
  result = u:request_purchase_approval(chain, {request_id: 1, amount: 100})?;
  u:assert_eq(result.handler_id, 10, "team handled")?;
  u:assert_eq(result.trace, [10], "successor not visited")?;
  u:assert_eq(result.effects, [10,10,1], "team effect")
}

@test {name: "Chain delegates through nested handlers", tags: ["gof", "chain", "first-class"]}
def u:test_chain_delegation() { "Verify an independently rejecting handler delegates unchanged to the next callable handler.";
  terminal = {fn: :u:unhandled_purchase_handler, environment: {handler_id: 99}};
  manager = {fn: :u:manager_purchase_handler, environment: {handler_id: 20, limit: 1000, next: terminal}};
  chain = {fn: :u:team_purchase_handler, environment: {handler_id: 10, limit: 100, next: manager}};
  request = {request_id: 2, amount: 600}; retained = request.amount;
  result = u:request_purchase_approval(chain, request)?;
  u:assert_eq(result.handler_id, 20, "manager handled")?;
  u:assert_eq(result.trace, [10,20], "delegation trace")?;
  u:assert_eq(request.amount, retained, "request retained")
}

@test {name: "Chain terminal and validation errors", tags: ["gof", "chain", "boundary"]}
def u:test_chain_boundaries() { "Verify terminal unhandled and invalid request paths remain Result failures.";
  terminal = {fn: :u:unhandled_purchase_handler, environment: {handler_id: 99}};
  manager = {fn: :u:manager_purchase_handler, environment: {handler_id: 20, limit: 1000, next: terminal}};
  chain = {fn: :u:team_purchase_handler, environment: {handler_id: 10, limit: 100, next: manager}};
  u:assert_err(u:request_purchase_approval(chain, {request_id: 3, amount: 5000}), "unhandled")?;
  u:assert_err(u:request_purchase_approval(chain, {request_id: 4, amount: -1}), "invalid amount")
}

u:run_registered_tests()
