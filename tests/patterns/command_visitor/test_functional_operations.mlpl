include "src/trees/shipping_cost_expression.mlpl";
include "src/patterns/command_visitor/functional_operations.mlpl";

@test {name: "Command executable values and retained state", tags: ["gof", "command", "first-class"]}
def u:test_command_invocation() { "Verify two executable Command values update immutable state and describe effects.";
  initial = {balance: 100, revision: 0};
  deposit = {execute: :u:deposit_funds, argument: {amount: 35}, environment: {account_id: 7, minimum_balance: 0}};
  withdraw = {execute: :u:withdraw_funds, argument: {amount: 20}, environment: {account_id: 7, minimum_balance: 10}};
  first = u:invoke_command(deposit, initial)?; second = u:invoke_command(withdraw, first.state)?;
  u:assert_eq([first.state.balance, second.state.balance], [135,115], "command results")?;
  u:assert_eq([first.state.revision, second.state.revision], [1,2], "revisions")?;
  u:assert_eq(first.effects, [10,7,35], "deposit effect")?;
  u:assert_eq(initial, {balance: 100, revision: 0}, "prior state retained")
}

@test {name: "Command validation boundaries", tags: ["gof", "command", "boundary"]}
def u:test_command_boundaries() { "Verify invalid Command arguments and balance policy return Result errors.";
  state = {balance: 20, revision: 0};
  zero = {execute: :u:deposit_funds, argument: {amount: 0}, environment: {account_id: 1, minimum_balance: 0}};
  excessive = {execute: :u:withdraw_funds, argument: {amount: 15}, environment: {account_id: 1, minimum_balance: 10}};
  u:assert_err(u:invoke_command(zero, state), "zero deposit")?;
  u:assert_err(u:invoke_command(excessive, state), "minimum balance")
}

@test {name: "Visitor operation algebra substitution", tags: ["gof", "visitor", "first-class"]}
def u:test_visitor_algebras() { "Verify evaluation and counting vary independently from one retained expression structure.";
  tree = u:operation(1, u:literal(5), u:operation(3, u:literal(2), u:literal(4)));
  prefix = u:prefix_tokens(tree);
  evaluation = {literal: :u:visitor_literal_value, combine: :u:visitor_arithmetic_combine, environment: {kind: 1}};
  counting = {literal: :u:visitor_literal_count, combine: :u:visitor_count_combine, environment: {kind: 2}};
  u:assert_eq(u:visit_expression(tree, evaluation)?, 13, "evaluation algebra")?;
  u:assert_eq(u:visit_expression(tree, counting)?, 5, "count algebra")?;
  u:assert_eq(u:prefix_tokens(tree), prefix, "tree retained")
}

@test {name: "Visitor errors propagate through traversal", tags: ["gof", "visitor", "boundary"]}
def u:test_visitor_boundaries() { "Verify empty, invalid-operation, and division errors remain ordinary Result failures.";
  evaluation = {literal: :u:visitor_literal_value, combine: :u:visitor_arithmetic_combine, environment: {kind: 1}};
  u:assert_err(u:visit_expression(u:empty_expr(), evaluation), "empty expression")?;
  u:assert_err(u:visit_expression(u:operation(9, u:literal(1), u:literal(2)), evaluation), "unknown tag")?;
  u:assert_err(u:visit_expression(u:operation(4, u:literal(1), u:literal(0)), evaluation), "division zero")
}

u:run_registered_tests()
