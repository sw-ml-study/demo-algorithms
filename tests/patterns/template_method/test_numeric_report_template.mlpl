include "src/patterns/template_method/numeric_report_template.mlpl";

@test {name: "Template Method step-set substitution", tags: ["gof", "template-method", "first-class"]}
def u:test_template_step_sets() { "Verify two injected step sets vary results while the workflow skeleton stays unchanged.";
  audit_steps = {prepare: :u:prepare_whole_readings, analyze: :u:analyze_total, publish: :u:publish_audit_metric};
  capacity_steps = {prepare: :u:prepare_scaled_readings, analyze: :u:analyze_peak, publish: :u:publish_capacity_metric};
  audit = u:run_numeric_report({stage: 0, source_id: 1, values: [4,7,5], scale: 1}, audit_steps)?;
  capacity = u:run_numeric_report({stage: 0, source_id: 2, values: [40,70,50], scale: 10}, capacity_steps)?;
  u:assert_eq([audit.report.metric, audit.report.report_kind], [16,10], "audit variation")?;
  u:assert_eq([capacity.report.metric, capacity.report.report_kind], [7,20], "capacity variation")?;
  u:assert_eq(audit.trace, [1,2,3], "audit invariant order")?;
  u:assert_eq(capacity.trace, [1,2,3], "capacity invariant order")
}

@test {name: "Template Method retention and effects-as-data", tags: ["gof", "template-method", "pure"]}
def u:test_template_retention() { "Verify immutable input retention and deterministic numeric effect descriptions.";
  steps = {prepare: :u:prepare_whole_readings, analyze: :u:analyze_peak, publish: :u:publish_capacity_metric};
  input = {stage: 0, source_id: 44, values: [3,9,6], scale: 1}; retained = input.values;
  first = u:run_numeric_report(input, steps)?; second = u:run_numeric_report(input, steps)?;
  u:assert_eq(first, second, "deterministic workflow")?;
  u:assert_eq(first.report.effects, [20,44], "effects described as data")?;
  u:assert_eq(input.values, retained, "input retained")
}

@test {name: "Template Method validation and ordering", tags: ["gof", "template-method", "boundary"]}
def u:test_template_boundaries() { "Verify invalid input and deliberately misordered step records return Result errors.";
  valid = {prepare: :u:prepare_whole_readings, analyze: :u:analyze_total, publish: :u:publish_audit_metric};
  misordered = {prepare: :u:prepare_whole_readings, analyze: :u:publish_audit_metric, publish: :u:analyze_total};
  u:assert_err(u:run_numeric_report({stage: 0, source_id: 1, values: [], scale: 1}, valid), "empty input")?;
  u:assert_err(u:run_numeric_report({stage: 0, source_id: 1, values: [2,-1], scale: 1}, valid), "negative input")?;
  u:assert_err(u:run_numeric_report({stage: 0, source_id: 1, values: [20], scale: 0}, {prepare: :u:prepare_scaled_readings, analyze: :u:analyze_total, publish: :u:publish_audit_metric}), "invalid scale")?;
  u:assert_err(u:run_numeric_report({stage: 0, source_id: 1, values: [2], scale: 1}, misordered), "misordered steps")
}

u:run_registered_tests()
