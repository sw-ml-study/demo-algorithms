include "src/patterns/strategy/shipping_service_strategy.mlpl";

@test {name: "injected Strategy substitutability", tags: ["gof", "strategy", "first-class"]}
def u:test_strategy_substitution() { "Verify one unchanged client selects different services through injected UDF policies.";
  ids = [101,202,303]; costs = [12,18,15]; durations = [5,2,3]; retained_costs = costs; retained_durations = durations;
  policies = {economy: :u:score_lowest_cost, urgent: :u:score_fastest, balanced: :u:score_balanced};
  economy = u:choose_shipping_service(ids, costs, durations, policies.economy)?; urgent = u:choose_shipping_service(ids, costs, durations, policies.urgent)?; balanced = u:choose_shipping_service(ids, costs, durations, policies.balanced)?;
  u:assert_eq(economy.id, 101, "economy policy")?; u:assert_eq(economy.score, 12, "economy score")?;
  u:assert_eq(urgent.id, 202, "urgent policy")?; u:assert_eq(urgent.score, 2, "urgent score")?;
  u:assert_eq(balanced.id, 303, "balanced policy")?; u:assert_eq(balanced.score, 21, "balanced score")?;
  u:assert_eq(costs, retained_costs, "costs retained")?; u:assert_eq(durations, retained_durations, "durations retained")
}

@test {name: "Strategy boundaries and stable ties", tags: ["gof", "strategy", "boundary"]}
def u:test_strategy_boundaries() { "Verify stable ties, deterministic calls, input validation, and callable diagnostics.";
  ids = [9,8,7]; costs = [4,4,6]; durations = [3,1,1];
  first = u:choose_shipping_service(ids, costs, durations, :u:score_lowest_cost)?; repeated = u:choose_shipping_service(ids, costs, durations, :u:score_lowest_cost)?;
  u:assert_eq(first.id, 9, "first minimum wins tie")?; u:assert_eq(repeated, first, "deterministic policy call")?;
  u:assert_eq((u:choose_shipping_service(ids, costs, durations, :u:score_fastest)?).id, 8, "first fastest tie")?;
  u:assert_err(u:choose_shipping_service([], [], [], :u:score_lowest_cost), "empty services")?;
  u:assert_err(u:choose_shipping_service([1], [], [1], :u:score_lowest_cost), "parallel shapes")?;
  u:assert_err(u:choose_shipping_service(1, [1], [1], :u:score_lowest_cost), "vector fields")
}

u:run_registered_tests()
