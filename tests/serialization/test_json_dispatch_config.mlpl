include "src/serialization/json_dispatch_config.mlpl";

@test {name: "JSON dispatch configuration plans a safe package prefix", tags: ["serialization", "json", "configuration"]}
def u:test_json_dispatch_plan() { "Verify typed JSON configuration drives a deterministic capacity-safe dispatch plan.";
  plan = u:dispatch_plan_from_json("{\"depot_id\":42,\"truck_capacity\":10,\"reserve_capacity\":2,\"package_weights\":[3,2,4,3]}")?;
  u:assert_eq(plan.schema_version, 1, "default schema version")?;
  u:assert_eq(plan.maximum_packages, 4, "default package limit")?;
  u:assert_eq(plan.depot_id, 42, "depot ID")?;
  u:assert_eq(plan.accepted_weights, [3,2], "capacity-safe prefix")?;
  u:assert_eq(plan.accepted_load, 5, "accepted load")?;
  u:assert_eq(plan.deferred_count, 2, "deferred packages")
}

@test {name: "JSON dispatch configuration supports optional fields and additive evolution", tags: ["serialization", "json", "schema"]}
def u:test_json_dispatch_optional_fields() { "Verify explicit version and package limit work while unknown additive fields are ignored.";
  plan = u:dispatch_plan_from_json("{\"schema_version\":1,\"depot_id\":7,\"truck_capacity\":20,\"reserve_capacity\":2,\"maximum_packages\":2,\"package_weights\":[3,4,5],\"future_note\":\"ignored\"}")?;
  u:assert_eq(plan.schema_version, 1, "explicit version")?;
  u:assert_eq(plan.maximum_packages, 2, "explicit package limit")?;
  u:assert_eq(plan.accepted_weights, [3,4], "package-count limit")?;
  u:assert_eq(plan.deferred_count, 1, "additive field does not change planning")
}

@test {name: "JSON dispatch configuration reports missing required fields", tags: ["serialization", "json", "schema", "validation"]}
def u:test_json_dispatch_missing_fields() { "Verify every absent required field becomes a structured Result rather than a hard field-access error.";
  u:assert_err(u:dispatch_plan_from_json("{\"truck_capacity\":10,\"reserve_capacity\":2,\"package_weights\":[1]}"), "missing depot")?;
  u:assert_err(u:dispatch_plan_from_json("{\"depot_id\":1,\"reserve_capacity\":2,\"package_weights\":[1]}"), "missing capacity")?;
  u:assert_err(u:dispatch_plan_from_json("{\"depot_id\":1,\"truck_capacity\":10,\"package_weights\":[1]}"), "missing reserve")?;
  u:assert_err(u:dispatch_plan_from_json("{\"depot_id\":1,\"truck_capacity\":10,\"reserve_capacity\":2}"), "missing weights")
}

@test {name: "JSON dispatch configuration rejects malformed policy", tags: ["serialization", "json", "validation"]}
def u:test_json_dispatch_validation() { "Verify malformed JSON and inconsistent or negative capacity policies return Results.";
  u:assert_err(u:dispatch_plan_from_json("{broken"), "malformed JSON")?;
  u:assert_err(u:dispatch_plan_from_json("{\"schema_version\":2,\"depot_id\":1,\"truck_capacity\":3,\"reserve_capacity\":0,\"package_weights\":[1]}"), "unsupported schema version")?;
  u:assert_err(u:dispatch_plan_from_json("{\"depot_id\":1,\"truck_capacity\":[3],\"reserve_capacity\":0,\"package_weights\":[1]}"), "capacity shape")?;
  u:assert_err(u:dispatch_plan_from_json("{\"depot_id\":1,\"truck_capacity\":3,\"reserve_capacity\":4,\"package_weights\":[1]}"), "reserve exceeds capacity")?;
  u:assert_err(u:dispatch_plan_from_json("{\"depot_id\":1,\"truck_capacity\":3,\"reserve_capacity\":0,\"maximum_packages\":-1,\"package_weights\":[1]}"), "negative package limit")?;
  u:assert_err(u:dispatch_plan_from_json("{\"depot_id\":1,\"truck_capacity\":3,\"reserve_capacity\":0,\"package_weights\":[1,-1]}"), "negative package")
}

u:run_registered_tests()
