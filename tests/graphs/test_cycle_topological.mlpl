def u:graph(vertices, sources, targets) { "Return the graph result for the supplied vertices, sources, targets."; {vertices: vertices, sources: sources, targets: targets, edges: tally(sources)} }
def u:valid(graph, position) { "Check whether graph, position satisfies the valid invariant."; if eq(tally(graph.sources), graph.edges) * eq(tally(graph.targets), graph.edges) { if eq(position, graph.edges) { 1 } else { source = take(graph.sources, 0, position); target = take(graph.targets, 0, position); gt(source, -1) * lt(source, graph.vertices) * gt(target, -1) * lt(target, graph.vertices) * u:valid(graph, position + 1) } } else { 0 } }
def u:matrix_add(graph, position, present) { "Return the matrix add result for the supplied graph, position, present."; if eq(position, graph.edges) { {vertices: graph.vertices, present: present} } else { u:matrix_add(graph, position + 1, scatter(present, take(graph.sources, 0, position) * graph.vertices + take(graph.targets, 0, position), 1)) } }
def u:matrix(graph) { "Return the matrix result for the supplied graph."; u:matrix_add(graph, 0, fill([graph.vertices * graph.vertices], 0)) }
def u:neighbors(matrix, source) { "Return the neighbors result for the supplied matrix, source."; positions = range(matrix.vertices * matrix.vertices); row = compress(eq(floor(positions / matrix.vertices), source), matrix.present); compress(row, range(matrix.vertices)) }
def u:cycle_neighbors(matrix, nodes, position, traversal) { "Continue cycle from the supplied recursive state."; if eq(position, tally(nodes)) + traversal.has_cycle { traversal } else { target = take(nodes, 0, position); color = take(traversal.colors, 0, target); if eq(color, 1) { {colors: traversal.colors, has_cycle: 1, from_node: traversal.current, to_node: target, current: traversal.current} } else { if eq(color, 2) { u:cycle_neighbors(matrix, nodes, position + 1, traversal) } else { child = u:cycle_visit(matrix, target, traversal); u:cycle_neighbors(matrix, nodes, position + 1, child) } } } }
def u:cycle_visit(matrix, node, traversal) { "Continue cycle from the supplied recursive state."; entered = {colors: scatter(traversal.colors, node, 1), has_cycle: traversal.has_cycle, from_node: traversal.from_node, to_node: traversal.to_node, current: node}; explored = u:cycle_neighbors(matrix, u:neighbors(matrix, node), 0, entered); if explored.has_cycle { explored } else { {colors: scatter(explored.colors, node, 2), has_cycle: 0, from_node: -1, to_node: -1, current: node} } }
def u:cycle_scan(matrix, node, traversal) { "Continue cycle from the supplied recursive state."; if eq(node, matrix.vertices) + traversal.has_cycle { traversal } else { if eq(take(traversal.colors, 0, node), 0) { u:cycle_scan(matrix, node + 1, u:cycle_visit(matrix, node, traversal)) } else { u:cycle_scan(matrix, node + 1, traversal) } } }
def u:detect_cycle(matrix) { "Return the detect cycle result for the supplied matrix."; u:cycle_scan(matrix, 0, {colors: fill([matrix.vertices], 0), has_cycle: 0, from_node: -1, to_node: -1, current: -1}) }
def u:indegrees(graph, position, values) { "Return the indegrees result for the supplied graph, position, values."; if eq(position, graph.edges) { values } else { target = take(graph.targets, 0, position); u:indegrees(graph, position + 1, scatter(values, target, take(values, 0, target) + 1)) } }
def u:zero_queue(values, position, queue) { "Create an empty queue value."; if eq(position, tally(values)) { queue } else { u:zero_queue(values, position + 1, if eq(take(values, 0, position), 0) { concat(queue, position) } else { queue }) } }
def u:release(nodes, position, traversal) { "Remove the supplied item and return the updated structure."; if eq(position, tally(nodes)) { traversal } else { node = take(nodes, 0, position); degree = take(traversal.indegrees, 0, node) - 1; changed = scatter(traversal.indegrees, node, degree); next_queue = if eq(degree, 0) { concat(traversal.queue, node) } else { traversal.queue }; u:release(nodes, position + 1, {indegrees: changed, queue: next_queue, head: traversal.head, order: traversal.order}) } }
def u:kahn_steps(matrix, traversal) { "Run the kahn steps algorithm."; if eq(traversal.head, tally(traversal.queue)) { traversal } else { node = take(traversal.queue, 0, traversal.head); advanced = {indegrees: traversal.indegrees, queue: traversal.queue, head: traversal.head + 1, order: concat(traversal.order, node)}; u:kahn_steps(matrix, u:release(u:neighbors(matrix, node), 0, advanced)) } }
def u:topological(graph) { "Run the topological algorithm."; matrix = u:matrix(graph); degrees = u:indegrees(graph, 0, fill([graph.vertices], 0)); result = u:kahn_steps(matrix, {indegrees: degrees, queue: u:zero_queue(degrees, 0, fill([0], 0)), head: 0, order: fill([0], 0)}); if eq(tally(result.order), graph.vertices) { ok(result.order) } else { err({kind: "cycle", message: "cycle"}) } }
def u:position(order, node, index) { "Return the position result for the supplied order, node, index."; if eq(index, tally(order)) { -1 } else { if eq(take(order, 0, index), node) { index } else { u:position(order, node, index + 1) } } }
def u:order_valid(graph, order, edge) { "Check whether graph, order, edge satisfies the order valid invariant."; if eq(edge, graph.edges) { 1 } else { lt(u:position(order, take(graph.sources, 0, edge), 0), u:position(order, take(graph.targets, 0, edge), 0)) * u:order_valid(graph, order, edge + 1) } }

def u:test() { "Run this script's conformance assertions.";
  empty = u:graph(0, fill([0], 0), fill([0], 0)); u:assert_eq(u:topological(empty)?, fill([0], 0), "empty topology failed")?;
  singleton = u:graph(1, fill([0], 0), fill([0], 0)); u:assert_false(u:detect_cycle(u:matrix(singleton)).has_cycle, "singleton falsely cyclic")?;
  self_loop = u:graph(1, [0], [0]); u:assert_true(u:detect_cycle(u:matrix(self_loop)).has_cycle, "self-loop missed")?; u:assert_err(u:topological(self_loop), "self-loop topology should fail")?;
  two_cycle = u:graph(2, [0, 1], [1, 0]); u:assert_true(u:detect_cycle(u:matrix(two_cycle)).has_cycle, "two-cycle missed")?;
  three_cycle = u:graph(4, [0, 1, 2], [1, 2, 0]); u:assert_true(u:detect_cycle(u:matrix(three_cycle)).has_cycle, "three-cycle missed")?;
  dag = u:graph(6, [0, 0, 1, 2, 3], [2, 3, 3, 4, 5]); order = u:topological(dag)?;
  u:assert_eq(order, [0, 1, 2, 3, 4, 5], "deterministic DAG order failed")?;
  u:assert_true(u:order_valid(dag, order, 0), "topological edge order invalid")?;
  disconnected = u:graph(5, [0, 2], [1, 3]); disconnected_order = u:topological(disconnected)?; u:assert_true(u:order_valid(disconnected, disconnected_order, 0), "disconnected DAG failed")?;
  duplicate = u:graph(3, [0, 0, 1], [1, 1, 2]); u:assert_err(u:topological(duplicate), "raw duplicate policy should require normalization")?;
  normalized_duplicate = u:graph(3, [0, 1], [1, 2]); u:assert_eq(u:topological(normalized_duplicate)?, [0, 1, 2], "normalized duplicate fixture failed")?;
  u:assert_false(u:valid(u:graph(2, [-1], [1]), 0), "negative endpoint passed validation")?;
  u:assert_false(u:valid(u:graph(2, [0], [2]), 0), "large endpoint passed validation")?;
  later = u:graph(7, concat(dag.sources, 5), concat(dag.targets, 6)); u:assert_eq(u:topological(dag)?, order, "retained DAG changed")?; u:assert_true(u:order_valid(later, u:topological(later)?, 0), "later DAG invalid")?;
  u:assert_err(u:topological(three_cycle), "cycle topology should fail")?;
  ok({test: "cycle-topological", cases: 16})
}
u:test()
