include "src/graphs/traveling_salesman.mlpl";

@test {name: "exact TSP and nearest comparison", tags: ["graph", "routing", "tsp"]}
def u:test_tsp_comparison() {
  "Verify exact deterministic optimum, retained input, and heuristic lower-bound relationship.";
  matrix = [0,10,15,20, 10,0,35,25, 15,35,0,30, 20,25,30,0];
  retained = matrix;
  exact = u:tsp_exact(matrix, 4, 0)?;
  nearest = u:tsp_nearest(matrix, 4, 0)?;
  u:assert_eq(exact.tour, [0,1,3,2,0], "deterministic optimum")?;
  u:assert_eq(exact.cost, 80, "optimal cost")?;
  u:assert_true(1 - lt(nearest.cost, exact.cost), "heuristic beat exact optimum")?;
  u:assert_eq(matrix, retained, "matrix retained")
}

@test {name: "TSP singleton and fixed-start policy", tags: ["graph", "routing", "boundary"]}
def u:test_tsp_singleton() {
  "Verify singleton tours and a nonzero fixed start produce closed tours.";
  singleton = u:tsp_exact([0], 1, 0)?;
  matrix = [0,2,4, 2,0,3, 4,3,0];
  result = u:tsp_exact(matrix, 3, 1)?;
  u:assert_eq(singleton.cost, 0, "singleton cost")?;
  u:assert_eq(singleton.tour, [0,0], "singleton tour")?;
  u:assert_eq(take(result.tour, 0, 0), 1, "fixed start")?;
  u:assert_eq(take(result.tour, 0, tally(result.tour) - 1), 1, "closed tour")
}

@test {name: "TSP invalid and disconnected inputs", tags: ["graph", "routing", "validation"]}
def u:test_tsp_errors() {
  "Verify malformed matrices, invalid starts, and disconnected tours return errors.";
  u:assert_err(u:tsp_exact([0,1], 2, 0), "nonsquare matrix")?;
  u:assert_err(u:tsp_nearest([0], 1, 1), "invalid start")?;
  disconnected = [0,1,-1, -1,0,1, -1,-1,0];
  u:assert_err(u:tsp_exact(disconnected, 3, 0), "no exact tour")?;
  u:assert_err(u:tsp_nearest(disconnected, 3, 0), "nearest cannot close")
}

@test {name: "2-opt strictly improves a nearest-neighbor seed", tags: ["graph", "routing", "two-opt"]}
def u:test_tsp_two_opt() {
  "Verify deterministic 2-opt preserves its seed and never beats the exact optimum.";
  matrix = [0,18,6,10,6, 18,0,12,24,20, 6,12,0,14,10, 10,24,14,0,4, 6,20,10,4,0];
  nearest = u:tsp_nearest(matrix, 5, 0)?;
  seed = nearest.tour;
  improved = u:tsp_two_opt(matrix, 5, seed)?;
  exact = u:tsp_exact(matrix, 5, 0)?;
  u:assert_eq([nearest.cost, improved.cost], [62,52], "strict improvement")?;
  u:assert_true(1 - gt(exact.cost, improved.cost), "2-opt beat exact optimum")?;
  u:assert_eq(nearest.tour, seed, "seed retained")?;
  u:assert_err(u:tsp_two_opt(matrix, 5, [0,1,2,3,4,1]), "open tour")
}

@test {name: "Held-Karp exact dynamic programming", tags: ["graph", "routing", "tsp", "dynamic-programming"]}
def u:test_tsp_held_karp() {
  "Verify Held-Karp matches factorial exact cost and first-minimum tour while retaining inputs and validating boundaries.";
  matrix = [0,18,6,10,6, 18,0,12,24,20, 6,12,0,14,10, 10,24,14,0,4, 6,20,10,4,0];
  retained = matrix;
  factorial = u:tsp_exact(matrix, 5, 0)?;
  held = u:tsp_held_karp(matrix, 5, 0)?;
  u:assert_eq(held.cost, factorial.cost, "exact optimum")?;
  u:assert_eq(held.tour, factorial.tour, "first-minimum tie policy")?;
  nonzero = u:tsp_held_karp([0,2,4, 2,0,3, 4,3,0], 3, 1)?;
  u:assert_eq([nonzero.cost, take(nonzero.tour, 0, 0), take(nonzero.tour, 0, tally(nonzero.tour) - 1)], [9,1,1], "fixed nonzero start")?;
  u:assert_eq(matrix, retained, "input retained")?;
  u:assert_err(u:tsp_held_karp([0,1], 2, 0), "malformed matrix")?;
  u:assert_err(u:tsp_held_karp([0,1,-1, -1,0,1, -1,-1,0], 3, 0), "disconnected tour")?;
  u:assert_err(u:tsp_held_karp(fill([169], 0), 13, 0), "bounded exponential state")?;
  u:assert_err(u:tsp_held_karp([0], 1, 0.5), "nonintegral start")
}

u:run_registered_tests()
