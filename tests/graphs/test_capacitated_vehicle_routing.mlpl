include "src/graphs/capacitated_vehicle_routing.mlpl";

@test {name: "CVRP exact and greedy delivery routes", tags: ["graph", "routing", "cvrp"]}
def u:test_cvrp_routes() { "Verify exact CVRP capacity splits, deterministic greedy comparison, served counts, and retained inputs.";
  matrix = [0,5,5,5,5, 5,0,1,2,9, 5,1,0,9,2, 5,2,9,0,20, 5,9,2,20,0]; retained = matrix; demands = [0,2,2,2,2];
  exact = u:cvrp_exact(matrix, 5, demands, 4, 0)?; greedy = u:cvrp_greedy(matrix, 5, demands, 4, 0)?;
  u:assert_eq(exact.route, [0,1,3,0,2,4,0], "exact deterministic routes")?;
  u:assert_eq([exact.cost, exact.routes, exact.served], [24,2,4], "exact cost and coverage")?;
  u:assert_eq(greedy.route, [0,1,2,0,3,4,0], "greedy deterministic ties")?;
  u:assert_eq(greedy.cost, 41, "greedy comparison cost")?;
  u:assert_true(1 - lt(greedy.cost, exact.cost), "greedy beat exact oracle")?;
  u:assert_eq(matrix, retained, "distance matrix retained")?;
  u:assert_eq(demands, [0,2,2,2,2], "demands retained")
}

@test {name: "CVRP capacity and connectivity boundaries", tags: ["graph", "routing", "validation"]}
def u:test_cvrp_boundaries() { "Verify exact-capacity service and reject excessive demand, disconnected customers, and malformed instances.";
  pair = [0,5, 5,0]; exact_capacity = u:cvrp_exact(pair, 2, [0,4], 4, 0)?;
  u:assert_eq(exact_capacity.cost, 10, "capacity equality cost")?;
  u:assert_eq(exact_capacity.route, [0,1,0], "capacity equality route")?;
  u:assert_err(u:cvrp_exact(pair, 2, [0,5], 4, 0), "demand exceeds capacity")?;
  u:assert_err(u:cvrp_greedy([0,-1,-1,0], 2, [0,1], 2, 0), "disconnected customer")?;
  u:assert_err(u:cvrp_exact([0,1], 2, [0,1], 2, 0), "malformed matrix")?;
  u:assert_err(u:cvrp_exact(pair, 2, [0], 2, 0), "malformed demands")?;
  u:assert_err(u:cvrp_exact(pair, 2, [1,1], 2, 0), "depot must have zero demand")?;
  u:assert_err(u:cvrp_exact(fill([81], 0), 9, fill([9], 0), 2, 0), "bounded exact search")
}

u:run_registered_tests()
