include "src/graphs/route_shortest_paths.mlpl";

@test {name: "A-star optimal route and guidance", tags: ["graph", "a-star", "routing"]}
def u:test_a_star_guidance() {
  "Verify admissible guidance matches Dijkstra and expands no more nodes than zero guidance.";
  graph = u:graph(7, [0,0,1,1,2,2,3,4,5], [1,2,3,4,3,5,6,6,6], [2,5,2,7,1,5,3,2,1]);
  weights = graph.weights;
  guided = u:a_star(graph, 0, 6, [7,5,4,3,2,1,0])?;
  zero = u:a_star(graph, 0, 6, fill([7], 0))?;
  dijkstra = u:dijkstra(graph, 0)?;
  u:assert_eq(take(guided.distances, 0, 6), take(dijkstra.distances, 0, 6), "Dijkstra cost parity")?;
  u:assert_eq(u:path(guided, 0, 6), [0,1,3,6], "deterministic optimal path")?;
  u:assert_true(1 - gt(guided.expanded, zero.expanded), "guidance expanded more nodes")?;
  u:assert_eq(graph.weights, weights, "graph retained")
}

@test {name: "A-star zero heuristic and unreachable target", tags: ["graph", "a-star", "boundary"]}
def u:test_a_star_zero_unreachable() {
  "Verify zero guidance preserves Dijkstra cost and unreachable targets return an empty path.";
  graph = u:graph(4, [0,1], [1,2], [2,3]);
  a = u:a_star(graph, 0, 2, [0,0,0,0])?;
  d = u:dijkstra(graph, 0)?;
  unreachable = u:a_star(graph, 0, 3, [0,0,0,0])?;
  u:assert_eq(take(a.distances, 0, 2), take(d.distances, 0, 2), "zero heuristic parity")?;
  u:assert_eq(u:path(unreachable, 0, 3), fill([0], 0), "unreachable path")
}

@test {name: "A-star input validation", tags: ["graph", "a-star", "validation"]}
def u:test_a_star_validation() {
  "Verify invalid endpoints, weights, graph shape, and heuristic policies return errors.";
  graph = u:graph(2, [0], [1], [1]);
  u:assert_err(u:a_star(graph, -1, 1, [1,0]), "invalid source")?;
  u:assert_err(u:a_star(graph, 0, 1, [1]), "heuristic shape")?;
  u:assert_err(u:a_star(graph, 0, 1, [1,-1]), "negative heuristic")?;
  u:assert_err(u:a_star(u:graph(2, [0], [1], [-1]), 0, 1, [1,0]), "negative weight")?;
  u:assert_err(u:a_star(u:graph(2, [0], [2], [1]), 0, 1, [1,0]), "invalid endpoint")
}

u:run_registered_tests()
