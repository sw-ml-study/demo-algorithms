# Conformance tests for the index-backed singly linked delivery route.

def u:route() { {values: [101, 202, 303], next: [1, 2, 0 - 1], head: 0, size: 3} }

def u:valid(list) {
  shape_ok = eq(rank(list.values), 1) * eq(rank(list.next), 1);
  size_ok = eq(list.size, tally(list.values)) * eq(list.size, tally(list.next));
  if shape_ok * size_ok {
    current = list.head;
    count = 0;
    ok_flag = 1;
    while lt(count, list.size) {
      if eq(current, 0 - 1) { ok_flag = 0; break } else {
        if lt(current, 0) { ok_flag = 0; break } else {
          if gt(current, list.size - 1) { ok_flag = 0; break } else {
            current = take(list.next, 0, current);
            count = count + 1
          }
        }
      }
    };
    ok_flag * eq(current, 0 - 1) * eq(count, list.size)
  } else { 0 }
}

def u:find_node(list, stop_id) {
  current = list.head;
  steps = 0;
  found = 0 - 1;
  while lt(steps, list.size) {
    if eq(take(list.values, 0, current), stop_id) { found = current; break } else {
      current = take(list.next, 0, current);
      steps = steps + 1
    }
  };
  found
}

def u:insert_after(list, stop_id, new_stop) {
  if u:valid(list) {
    target = u:find_node(list, stop_id);
    if eq(target, 0 - 1) { err({kind: "missing-stop", message: "target is absent"}) } else {
      new_index = list.size;
      successor = take(list.next, 0, target);
      next_with_node = concat(list.next, successor);
      ok({
        values: concat(list.values, new_stop),
        next: scatter(next_with_node, target, new_index),
        head: list.head,
        size: list.size + 1
      })
    }
  } else { err({kind: "representation", message: "invalid list"}) }
}

def u:traverse(list) {
  if u:valid(list) {
    result = fill([0], 0);
    current = list.head;
    steps = 0;
    while lt(steps, list.size) {
      result = concat(result, take(list.values, 0, current));
      current = take(list.next, 0, current);
      steps = steps + 1
    };
    ok(result)
  } else { err({kind: "representation", message: "invalid list"}) }
}

def u:test() {
  original = u:route();
  u:assert_true(u:valid(original), "initial linked-list invariant failed")?;
  u:assert_eq(u:traverse(original)?, [101, 202, 303], "initial traversal failed")?;

  after_head = u:insert_after(original, 101, 111)?;
  u:assert_eq(u:traverse(after_head)?, [101, 111, 202, 303], "head insertion failed")?;

  after_middle = u:insert_after(original, 202, 250)?;
  u:assert_eq(u:traverse(after_middle)?, [101, 202, 250, 303], "middle insertion failed")?;
  u:assert_eq(after_middle.values, [101, 202, 303, 250], "insert shifted physical node values")?;
  u:assert_eq(after_middle.next, [1, 3, 0 - 1, 2], "middle insertion rewired wrong handles")?;

  after_tail = u:insert_after(original, 303, 404)?;
  u:assert_eq(u:traverse(after_tail)?, [101, 202, 303, 404], "tail insertion failed")?;
  u:assert_eq(after_tail.size, 4, "insert did not grow node arena")?;
  u:assert_true(u:valid(after_tail), "grown linked-list invariant failed")?;

  u:assert_err(u:insert_after(original, 999, 404), "missing target should fail")?;
  malformed = {values: [1, 2], next: [1, 0], head: 0, size: 2};
  u:assert_err(u:traverse(malformed), "cycle should violate list invariant")?;

  u:assert_eq(original.values, [101, 202, 303], "insert changed original values")?;
  u:assert_eq(original.next, [1, 2, 0 - 1], "insert changed original handles")?;
  ok({test: "delivery-route-linked-list", cases: 10})
}
u:test()
