def u:empty_avl() { "Create an empty avl value."; {empty: 1, height: 0} }
def u:higher(a, b) { "Return whether a, b satisfy higher."; if gt(a, b) { a } else { b } }
def u:make(key, value, left, right) { "Return the make result for the supplied key, value, left, right."; {empty: 0, key: key, value: value, left: left, right: right, height: 1 + u:higher(left.height, right.height)} }
def u:factor(tree) { "Return the factor result for the supplied tree."; if tree.empty { 0 } else { tree.left.height - tree.right.height } }
def u:rotate_right(top) { "Return the rotate right result for the supplied top."; pivot = top.left; moved = pivot.right; new_right = u:make(top.key, top.value, moved, top.right); u:make(pivot.key, pivot.value, pivot.left, new_right) }
def u:rotate_left(top) { "Return the rotate left result for the supplied top."; pivot = top.right; moved = pivot.left; new_left = u:make(top.key, top.value, top.left, moved); u:make(pivot.key, pivot.value, new_left, pivot.right) }
def u:rebalance(tree, inserted_key) { "Return the rebalance result for the supplied tree, inserted_key."; balance = u:factor(tree); if gt(balance, 1) { if lt(inserted_key, tree.left.key) { u:rotate_right(tree) } else { u:rotate_right(u:make(tree.key, tree.value, u:rotate_left(tree.left), tree.right)) } } else { if lt(balance, -1) { if gt(inserted_key, tree.right.key) { u:rotate_left(tree) } else { u:rotate_left(u:make(tree.key, tree.value, tree.left, u:rotate_right(tree.right))) } } else { tree } } }
def u:insert(tree, key, value) { "Add the supplied item and return the updated structure."; if tree.empty { u:make(key, value, u:empty_avl(), u:empty_avl()) } else { if lt(key, tree.key) { u:rebalance(u:make(tree.key, tree.value, u:insert(tree.left, key, value), tree.right), key) } else { if gt(key, tree.key) { u:rebalance(u:make(tree.key, tree.value, tree.left, u:insert(tree.right, key, value)), key) } else { u:make(key, value, tree.left, tree.right) } } } }
def u:lookup(tree, key) { "Find the requested value or node in the supplied structure."; if tree.empty { err({kind: "missing", message: "absent"}) } else { if lt(key, tree.key) { u:lookup(tree.left, key) } else { if gt(key, tree.key) { u:lookup(tree.right, key) } else { ok(tree.value) } } } }
def u:inorder(tree) { "Traverse the supplied structure in inorder order."; if tree.empty { fill([0], 0) } else { concat(u:inorder(tree.left), concat(tree.key, u:inorder(tree.right))) } }
def u:audit(tree) { "Return the audit result for the supplied tree."; if tree.empty { {ok_flag: 1, empty_flag: 1, minimum: 0, maximum: 0, height: 0, count: 0} } else { left_audit = u:audit(tree.left); right_audit = u:audit(tree.right); expected_height = 1 + u:higher(left_audit.height, right_audit.height); balance = left_audit.height - right_audit.height; order_left = if left_audit.empty_flag { 1 } else { lt(left_audit.maximum, tree.key) }; order_right = if right_audit.empty_flag { 1 } else { gt(right_audit.minimum, tree.key) }; {ok_flag: left_audit.ok_flag * right_audit.ok_flag * order_left * order_right * eq(tree.height, expected_height) * (lt(abs(balance), 2) + eq(abs(balance), 1)), empty_flag: 0, minimum: if left_audit.empty_flag { tree.key } else { left_audit.minimum }, maximum: if right_audit.empty_flag { tree.key } else { right_audit.maximum }, height: expected_height, count: left_audit.count + right_audit.count + 1} } }
def u:valid(tree) { "Check whether tree satisfies the valid invariant."; u:audit(tree).ok_flag }
def u:add_range(tree, key, last) { "Add the supplied item and return the updated structure."; if gt(key, last) { tree } else { u:add_range(u:insert(tree, key, key * 10), key + 1, last) } }

def u:test() { "Run this script's conformance assertions.";
  empty = u:empty_avl(); u:assert_err(u:lookup(empty, 1), "empty lookup should miss")?;
  ll = u:insert(u:insert(u:insert(empty, 30, 30), 20, 20), 10, 10); u:assert_eq(ll.key, 20, "LL rotation failed")?;
  rr = u:insert(u:insert(u:insert(empty, 10, 10), 20, 20), 30, 30); u:assert_eq(rr.key, 20, "RR rotation failed")?;
  lr = u:insert(u:insert(u:insert(empty, 30, 30), 10, 10), 20, 20); u:assert_eq(lr.key, 20, "LR rotation failed")?;
  rl = u:insert(u:insert(u:insert(empty, 10, 10), 30, 30), 20, 20); u:assert_eq(rl.key, 20, "RL rotation failed")?;
  u:assert_true(u:valid(ll) * u:valid(rr) * u:valid(lr) * u:valid(rl), "rotation result invalid")?;
  sequence = u:add_range(empty, 1, 15);
  u:assert_eq(u:inorder(sequence), range(15) + 1, "adversarial inorder failed")?;
  u:assert_eq(sequence.height, 4, "deterministic logarithmic height failed")?;
  u:assert_true(u:valid(sequence), "sequence invariant failed")?;
  u:assert_eq(u:lookup(sequence, 11)?, 110, "search failed")?;
  u:assert_err(u:lookup(sequence, 99), "missing search should fail")?;
  negative = u:insert(sequence, -4, 0); u:assert_eq(u:lookup(negative, -4)?, 0, "negative key or stored zero failed")?;
  u:assert_true(u:valid(negative), "negative insertion unbalanced tree")?;
  revised = u:insert(sequence, 8, 888);
  u:assert_eq(revised.height, sequence.height, "duplicate update changed height")?;
  u:assert_eq(u:lookup(revised, 8)?, 888, "duplicate replacement failed")?;
  u:assert_eq(u:lookup(sequence, 8)?, 80, "duplicate update mutated old root")?;
  early = u:add_range(empty, 1, 3); later = u:add_range(early, 4, 8);
  u:assert_eq(u:inorder(early), [1, 2, 3], "later inserts mutated retained root")?;
  u:assert_true(u:valid(later), "later persistent tree invalid")?;
  bad_height = {empty: 0, key: sequence.key, value: sequence.value, left: sequence.left, right: sequence.right, height: 99};
  u:assert_false(u:valid(bad_height), "bad cached height passed validation")?;
  ok({test: "persistent-avl", cases: 19})
}
u:test()
